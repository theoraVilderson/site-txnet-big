# =============================================================================
# TXNet — environment template
# -----------------------------------------------------------------------------
# THREE env files, loaded in this order (later file wins):
#
#     .env          shared      — identical in every environment
#     .env.dev      dev only    — overrides for local development
#     .env.prod     prod only   — overrides for production
#
#   scripts/dev.compose.sh   →  --env-file .env  --env-file .env.dev   -p devtxnet
#   scripts/prod.compose.sh  →  --env-file .env  --env-file .env.prod  -p prodtxnet
#
# Copy the SHARED block to `.env`, the DEV block to `.env.dev`, the PROD block
# to `.env.prod`. NEVER commit real secrets.
# =============================================================================


# #############################################################################
# ##  .env  — SHARED                                                          ##
# #############################################################################

# ---- Container registry ----
DOCKER_REGISTRY=docker.arvancloud.ir
LOCAL_DOCKER_REGISTRY=registry.mytxnet.ir
WEB_APP_VERSION=1.0.1

# ---- Fixed ports (same in every env; internal to the compose network) ----
INTERAL_BACKEND_PORT=8080        # port auth-handler listens on inside its container
GATEWAY_PORT=8080                # must match INTERAL_BACKEND_PORT (Traefik talks to it)
MAIN_DB_PORT=5432
NETWORK_SERVICE_PORT=8090       # network-service's health endpoint, private network only (ADR-0071)
REDIS_PORT=6379

# ---- Database / broker (shared parts; password + db name are per-env) ----
# MAIN_DB_USERNAME owns every table and runs the migrations. Row-Level Security
# does not apply to a table's owner, so the services do NOT connect with it.
MAIN_DB_USERNAME=admin
RABBITMQ_DEFAULT_USER=admin

# The two RLS login roles (F-066-m-a, catalog 20.2 layer 1). Create them once
# per database with `./scripts/db-login-roles.sh`, which reads these two
# passwords; the compose stack then builds DATABASE_APP_URL from the first.
# Re-running the script with a new value here is how one is rotated.
#   txnet_app_user          -> one tenant's rows, chosen per query
#   txnet_cross_tenant_user -> every tenant's rows; the audited escape
# `auth-service` refuses to boot without DATABASE_APP_URL or
# DATABASE_CROSS_TENANT_URL, on purpose: falling back to the owner connection
# would leave every policy inert and look fine, and falling back from the
# second to the first would answer every host lookup and every vault read with
# no rows (F-066-m-b). The compose stack builds both URLs from these passwords.
DB_APP_PASSWORD=change-me-app
DB_CROSS_TENANT_PASSWORD=change-me-cross-tenant

# ---- Background workers (worker-service, ADR-0027) ----
# A schedule is a message: worker-service publishes `automation.tick.<key>` to
# a durable topic exchange and consumes it in a process that serves no HTTP.
# All seven have defaults in the schema; set one only to differ from it.
# AUTOMATION_EXCHANGE=txnet.automation
# `.v2` because the queue carries a dead-letter argument since F-067-d, and a
# durable queue's arguments cannot be changed in place. The old
# `txnet.automation.ticks` is empty within one tick interval and can be deleted.
# AUTOMATION_QUEUE=txnet.automation.ticks.v2
# Where a rejected message goes instead of being destroyed, and the queue it
# waits on until `worker-service` records it in `automation.dead_letter`.
# AUTOMATION_DLX=txnet.automation.dlx
# AUTOMATION_DEAD_QUEUE=txnet.automation.ticks.dead
# How many ticks one worker process runs at once, across every tenant.
# AUTOMATION_PREFETCH=4
# How many of those slots one tenant may hold (F-066-p). Keep it below
# AUTOMATION_PREFETCH — at or above it the cap can never bind.
# AUTOMATION_TENANT_CONCURRENCY=2
# How long a tick refused by that cap waits before going back on the exchange,
# behind every other tenant's work.
# AUTOMATION_DEFER_MS=5000
# How many unpublished automation.outbox_event rows one relay run claims
# (F-067-c). Held under FOR UPDATE SKIP LOCKED until the batch is published, so
# it is a lock-duration knob as much as a throughput one.
# AUTOMATION_OUTBOX_BATCH=100
# How many events each outbox queue hands one worker at once — every outbox
# queue has its own channel, so a burst of one type waits in its own queue (F-067-p).
# AUTOMATION_OUTBOX_PREFETCH=8
# How long a person's inbox and bot notices of one kind are gathered and told as
# one summary (F-067-p). The live push is never delayed.
# AUTOMATION_NOTICE_WINDOW_MS=10000
# How often the publisher asks which workers are due. Not the resolution of a
# schedule — an occurrence that fell between two ticks is still found.
# AUTOMATION_TICK_INTERVAL_MS=60000
# A run still open this long belonged to a process that died; its log row is
# closed as failed on the next boot.
# AUTOMATION_RUN_TIMEOUT_MS=600000
# A label in every log line, for a deployment running several workers.
# WORKER_NAME=

# ---- currency / the FX worker (F-0603, D-22) ----
# Which public USDT/IRT order books the worker polls, by key. The mid of best
# bid and best ask from each, normalised to rial; the median is F-0604's.
# A list rather than a constant because Nobitex, Wallex and Bitpin were put on
# the US OFAC list in June 2026 — dropping one is config, not a release.
# The default is the two endpoints D-22 states in full and that have been seen
# to answer; wallex and bitpin are implemented but their URLs are unverified,
# so turn them on in the change that confirms them.
# FX_SOURCES=nobitex,tabdeal
# The per-source deadline, not a total. An exchange that has stopped answering
# — the expected weather during a national-internet shutdown — costs its own
# reading and holds up none of the others.
# FX_SOURCE_TIMEOUT_MS=3000
# How many readings must survive the discard step before a median means
# anything (F-0604). One surviving source is the broken API this rule defends
# against, so fewer than this is a failed run and no rate, not a best effort.
# Raise to 3 once a third exchange has been seen to answer.
# FX_MIN_SOURCES=2
# The hard sanity band, rial per USDT, inclusive. Deliberately wide: it rejects
# values that cannot be a price at all (an amount column read as a price, a
# stale zero), not disagreement between exchanges — that is the median's job,
# and a sudden move is F-0605's. These two numbers are this repo's estimate,
# not D-22's; the run log prints every reading so they can be tightened.
# FX_SANITY_MIN_RIAL=100000
# FX_SANITY_MAX_RIAL=10000000
# How far the median may move from the last ACCEPTED rate before the poll is
# refused and a critical alert fires (F-0605). Relative, where the band above
# is absolute: this is the only step that catches a toman book read as rial,
# which is in band and agreed on by every source. A legitimate move bigger than
# this costs one rejected poll and one alert, then recovers on the next one.
# FX_MAX_DEVIATION_PERCENT=5
#
# NOTE (D-22, unsettled): these exchanges are only reachable during a national
# shutdown if this process runs on a node inside Iran. Where the worker is
# scheduled is automation's decision and is not made yet.

# ---- realtime / gateway-service (the WebSocket gateway, F-067-h, ADR-0030) ----
# One socket per signed-in user, multiplexed into channels. The upgrade goes
# through Traefik's `my-auth` like every other request, with the access JWT in
# `Sec-WebSocket-Protocol` because a browser cannot set headers on
# `new WebSocket()`. This process holds no JWT secret and no database.
#
# The port the container listens on; must equal the Traefik
# loadbalancer.server.port for gateway-service.
# REALTIME_PORT=3000
# The path the upgrade arrives on. It MUST match the Traefik router rule that
# carries `my-auth` — a socket reachable on a path the gate does not cover
# would be an unauthenticated socket.
# REALTIME_PATH=/realtime
# How often every connection is pinged; one missed ping closes it. Keep it
# under Traefik's 60s idle timeout, or the keepalive is slower than the proxy
# it exists to keep alive.
# REALTIME_HEARTBEAT_MS=30000
# How often each held session is re-checked against `session:<id>` in Redis.
# This is the window a revoked session keeps its socket — a security number,
# not a tuning one. One EXISTS per distinct session, not per connection.
# REALTIME_SESSION_RECHECK_MS=60000
# How many channels one connection may hold, and how many sockets one user may
# hold on one replica. The second is checked before the handshake, so a client
# in a reconnect loop is refused with a 429 rather than upgraded and closed.
# REALTIME_MAX_SUBSCRIPTIONS=32
# REALTIME_MAX_CONNECTIONS_PER_USER=4
# How many *anonymous* sockets one client address may hold on one replica
# (ADR-0031). The per-user cap cannot apply to a connection with no user, and
# an address is a blunt key — it lumps everyone behind one NAT together — so
# this is a ceiling on abuse rather than a quota anyone should reach.
# REALTIME_MAX_CONNECTIONS_PER_IP=16
# The largest frame accepted from a client. Inbound frames are subscribe /
# unsubscribe / resume / ping and nothing else, so 8 KiB is generous; the point
# is that a client does not choose how much memory this process allocates.
# REALTIME_MAX_FRAME_BYTES=8192

# ---- i18n / locale-service (gRPC source of truth) ----
# Clients load EVERY language locale-service advertises — no per-language knob.
#
# DEFAULT_LANGUAGE is the language this deployment answers a stranger in, and
# the fallback used when a key is missing from the language asked for. Every
# part of the platform reads it: auth-service, bot-service, auth-handler, the
# panel (site-pwa) and the landing site (coinsite). It outranks the browser's
# Accept-Language and the messenger's language hint — a visitor's own choice
# (the NEXT_LOCALE cookie, /lang in the bot, a saved account preference) is
# what outranks it. See F-046 / F-068 and ADR-0016.
#
# The two Next.js apps also receive it as NEXT_PUBLIC_DEFAULT_LANGUAGE, set
# from this one value in dev-docker/docker-compose.main.yml — only a
# NEXT_PUBLIC_ variable reaches the browser bundle. Set it here, not there.
LOCALES_DIR=/app/locales/langs
DEFAULT_LANGUAGE=fa

# Machine translation drafts catalog text for every language an admin did not
# write; a human publishes it (ADR-0050). Self-hosted LibreTranslate, the
# `translator` service in dev-docker — nothing leaves the deployment.
# TRANSLATOR_URL unset = no drafts at all; readers still get the en -> fa
# fallback. TRANSLATOR_LANGUAGES is which models the container loads: add a
# language's code here when that language is added to locales/.
TRANSLATOR_URL=http://translator:5000
# TRANSLATOR_API_KEY=
# TRANSLATOR_TIMEOUT_MS=10000
TRANSLATOR_LANGUAGES=en,fa
# TRANSLATOR_THREADS=2

# A local LLM drafts first, LibreTranslate only when it answers nothing
# (ADR-0050 amendment 3). The `translator-llm` service (Ollama) pulls the model
# once into its volume; after that it runs with no internet. qwen2.5:3b is
# ~2 GB on disk and ~3-4 GB RAM. Leave TRANSLATOR_LLM_URL unset to skip the LLM.
# Any OpenAI-compatible server works (llama.cpp, vLLM): the URL ends in /v1.
TRANSLATOR_LLM_URL=http://translator-llm:11434/v1
TRANSLATOR_LLM_MODEL=qwen2.5:3b
# TRANSLATOR_LLM_TIMEOUT_MS=60000
# TRANSLATOR_LLM_KEEP_ALIVE=30m

# Phone numbers accept every country libphonenumber knows (ADR-0018) and are
# stored as E.164. A number typed without a `+` is read as belonging to the
# region DEFAULT_LANGUAGE implies (fa -> IR, en -> US); set
# DEFAULT_PHONE_COUNTRY to an ISO code to override that, and
# SUPPORTED_PHONE_COUNTRIES to a comma-separated list to narrow which
# countries may sign up at all. Both are empty by default.
# DEFAULT_PHONE_COUNTRY is read by bot-service too, for the same reason: the
# chat has no country picker, so a number typed there without a `+` is read
# as this region's (F-062).
# DEFAULT_PHONE_COUNTRY=
# SUPPORTED_PHONE_COUNTRIES=
GATEWAY_PERMISSIONS_FILE_PATH=/app/configs/permissions.yaml

# ---- Multi-tenancy ----
# A request resolves its tenant from a verified tenant_domain row for the host
# it arrived on, or from a claim it carries (a session, or X-Tenant-Id from a
# verified service caller). There is NO fallback tenant (ADR-0025): a host that
# matches no row is answered a neutral 404, so there is nothing to configure
# here — there is something to SEED.
#
# `node prisma/seed.js` creates the platform owner's own row for
# api.$DOMAIN_NAME. Every other host the API is served on — a reseller's
# subdomain, a verified custom domain — needs a tenant_domain row of its own
# before it answers anything at all.
#
# A bot chat has no host, so bot-service names its tenant instead: it sends
# BOT_TENANT_ID as X-Tenant-Id, which auth-api honours because the service
# token verified. `prisma/seed.js` prints the id it created — paste it here, or
# every bot flow is answered 404. One process, one tenant, until F-066-i gives
# each BotIntegration its own.
BOT_TENANT_ID=

# ---- The Credential Vault (ADR-0026) ----
# Every tenant-owned secret — a bot token, a gateway key, a panel login — is
# stored encrypted in `tenant.tenant_credential`, under a data key that belongs
# to that one tenant. Those data keys are themselves wrapped by the KEK below.
#
# This variable is a PATH, and that is the decision, not an accident: the key
# itself must never be an environment variable. An env var is visible in
# `docker inspect`, in a crash dump, in /proc/<pid>/environ and in every child
# process. In Swarm this is a mounted secret under /run/secrets/; in dev it is
# a file the compose stack mounts read-only.
#
# Make one:  openssl rand -base64 32 > dev-docker/secrets/vault-kek
#
# Leave it unset and auth-service still boots — it logs a warning and refuses
# every credential operation. That is deliberate: nothing writes a tenant
# credential until F-066-i, so requiring the key today would stop every
# deployment from starting over a feature none of them use yet.
VAULT_KEK_FILE=/run/secrets/vault-kek

# ---- Token lifetimes (seconds) ----
JWT_ACCESS_TTL_SEC=900
OTP_TOKEN_TTL_SEC=300
RESET_TOKEN_TTL_SEC=300

# ---- Abuse limits ----
# Failed passwords that lock ONE account (not the caller's IP) for 900s.
LOGIN_FAILURE_LOCK_THRESHOLD=10

# Per-route request limits: requests per subject per that route's window
# (F-087). Every one is optional — unset means the default shown, which lives
# in txnet-backend/auth-service/src/app/config/env.validation.ts. Lower one to
# tighten a route under attack without a rebuild. The platform-wide ceiling is
# PLATFORM_RATE_LIMIT_FACTOR times each of these.
# LOGIN_PWD_RATE_LIMIT=20              # /auth/login, per 900s
# LOGIN_OTP_REQUEST_RATE_LIMIT=10      # /auth/login/otp/request, per 900s
# LOGIN_OTP_VERIFY_RATE_LIMIT=20       # /auth/login/otp/verify, per 900s
# REGISTER_RATE_LIMIT=10               # /auth/register, per 3600s
# REGISTER_VERIFY_RATE_LIMIT=20        # /auth/register/verify-phone, per 3600s
# PASSWORD_FORGOT_RATE_LIMIT=10        # /auth/password/forgot, per 900s
# FORGOT_VERIFY_RATE_LIMIT=20          # reset-code verification — the budget for guessing 6 digits, per 900s
# OTP_PHONE_RATE_LIMIT=5               # codes sent TO one number, per 3600s
# BOT_UNPROVEN_RATE_LIMIT=30           # one chat's unproven bot traffic across the gated routes, per 900s
# OTP_DELIVERY_STATUS_RATE_LIMIT=120   # /auth/otp/delivery/status, per 900s
# OTP_CHANNELS_RATE_LIMIT=60           # /auth/otp/channels, per 900s
# CAPTCHA_RATE_LIMIT=30                # captcha challenge + verify per IP, per 900s — gates every guarded route
# BOT_LINK_RESOLVE_RATE_LIMIT=30       # per 60s
# BOT_LINK_CONTACT_RATE_LIMIT=10       # per 300s
# BOT_LINK_STATUS_RATE_LIMIT=300       # per 900s
# BOT_SESSION_RATE_LIMIT=10            # per 300s
# BOT_WEBAPP_SESSION_RATE_LIMIT=20     # per 900s
# ACCOUNTS_ADD_OTP_REQUEST_RATE_LIMIT=10   # per 900s
# ACCOUNTS_ADD_OTP_VERIFY_RATE_LIMIT=20    # per 900s
# ACCOUNTS_ADD_PASSWORD_RATE_LIMIT=20      # per 900s
# ACCOUNTS_LIST_RATE_LIMIT=120         # per 900s
# ACCOUNTS_SWITCH_RATE_LIMIT=30        # per 900s
# ACCOUNTS_REMOVE_RATE_LIMIT=30        # per 900s
# DEPOSIT_GATEWAYS_RATE_LIMIT=120     # billing-service, per user, per 900s (default in billing-service/src/app/config/env.validation.ts)
# DEPOSIT_QUOTE_RATE_LIMIT=60         # billing-service, per user, per 900s — a quote may call the bank
# DEPOSIT_START_RATE_LIMIT=20         # billing-service, per user, per 900s — a start holds coupons and mints an authority
# DEPOSIT_ABANDON_RATE_LIMIT=30       # billing-service, per user, per 900s — giving up a Mini App top-up gives its coupon holds back (F-093-q)
# INVOICE_CREATE_RATE_LIMIT=20        # billing-service, per user, per 900s — an invoice holds its coupons for 30 minutes (F-111-a)
# INVOICE_PAY_RATE_LIMIT=20           # billing-service, per user, per 900s — paying an invoice from the wallet (F-111-b)
# INVOICE_READ_RATE_LIMIT=120         # billing-service, per user, per 900s — reading one's own invoice back (F-111-e)
# SHOP_OFFERS_RATE_LIMIT=120          # billing-service, per user, per 900s — the shop's list of what is for sale (F-111-e)
# GRANT_DELIVERY_RETRIES=6            # billing-service — retries of a paid Grant's delivery before it is cancelled and refunded (F-111-d)
# GRANT_DELIVERY_FIRST_RETRY_MS=60000 # billing-service — the first retry's wait; each later one doubles it (F-111-d)
# GRANT_DELIVERY_DELAYED_AFTER_MS=300000 # billing-service — a paid Grant still undelivered this long after purchase is announced once: buyer + tenant owner (F-601-i)
# DEPOSIT_CALLBACK_RATE_LIMIT=30      # billing-service, per AUTHORITY per 900s — the gateway callback is public, so there is no user to count
# DEPOSIT_WEBHOOK_RATE_LIMIT=600     # billing-service, per GATEWAY per 60s — a provider's signed posts, public (F-104-b)
# WALLET_HISTORY_RATE_LIMIT=180       # billing-service, per user, per 900s — the financial page refetches per filter change
# WALLET_PAYMENTS_RATE_LIMIT=120      # billing-service, per user, per 900s
# RESELLER_PURCHASE_READ_RATE_LIMIT=120   # tenant-service, per user, per 900s — package list + slug suggestion (default in tenant-service/src/app/config/env.validation.ts)
# RESELLER_PURCHASE_WRITE_RATE_LIMIT=10    # tenant-service, per user, per 900s — a purchase moves money
# PUBLIC_ROUTE_RATE_LIMIT=300         # tenant-service, per visitor IP, per 60s — the WHOLE /api/public/ prefix (F-018-al), spent in PublicHostMiddleware, not per route. A page load costs one per image (files/<key>)

# ---- Payments (billing-service) ----
# How long a pending top-up stays payable, and with it the coupon holds it took
# (F-092-i). One clock for both — legacy had a separate TTL per coupon lock.
# PAYMENT_PENDING_TTL_SEC=900
# How long an expired top-up keeps its coupon holds, because the bank may still
# charge it (F-092-ah). 0 releases them with the payment, as before.
# COUPON_HOLD_AFTER_EXPIRY_SEC=3600
# How long the gateway callback waits on the bank's verify before it sends the
# payer to the pending page and leaves the rest to the retry ladder (F-092-ab).
# DEPOSIT_CALLBACK_VERIFY_BUDGET_MS=8000
# One gateway-callback origin for every tenant, instead of the tenant's own
# panel domain. Development and test only: no tenant owns a host a gateway
# sandbox can reach. Leave unset in production (ADR-0020).
# PAYMENT_CALLBACK_ORIGIN=http://localhost:3000

# ---- Redis keyspace ----
# auth-service (NestJS) and auth-handler (Go) both prefix every Redis key with
# "<namespace>:<version>:" and must agree. Bump the version (v1 → v2 → …) to
# abandon the whole keyspace in one move.
REDIS_KEY_NAMESPACE=txnet:auth
REDIS_KEYSPACE_VERSION=v2

# ---- HTTP / proxy ----
TRUST_PROXY=1
COOKIE_SECURE=true

# ---- OTP delivery ----
# Channels this environment may use. A channel left out of this list is never
# offered by GET /api/auth/otp/channels and is refused if asked for by name —
# e.g. OTP_ALLOWED_CHANNELS=telegram,bale runs with SMS switched off.
OTP_ALLOWED_CHANNELS=sms,bale,telegram
OTP_DELIVERY_MODE=console
BOT_LINK_TOKEN_TTL_SEC=900

# ---- Telegram / Bale bots (OTP delivery + account linking) ----
# Endpoints are shared defaults and can stay here; the three credentials per
# platform belong in .env.dev / .env.prod, because one bot token can hold only
# ONE webhook URL — dev and prod must use different bots.
#
#   <PLATFORM>_BOT_TOKEN      send a code to an already-linked user
#   <PLATFORM>_BOT_USERNAME   + the two below: let a NEW user link themselves
#   <PLATFORM>_WEBHOOK_SECRET >=16 chars; it is the last path segment of the
#                             public webhook URL, so treat it as a secret
#
# Register once per bot:  scripts/set-bot-webhook.sh <dev|prod>
#   https://api.<domain>/api/auth/bots/telegram/webhook/<TELEGRAM_WEBHOOK_SECRET>
#   https://api.<domain>/api/auth/bots/bale/webhook/<BALE_WEBHOOK_SECRET>
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_DEEP_LINK_BASE=https://t.me
BALE_API_BASE=https://tapi.bale.ai
BALE_DEEP_LINK_BASE=https://ble.ir
# per environment — see .env.dev / .env.prod
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET=
# BALE_BOT_TOKEN=
# BALE_BOT_USERNAME=
# BALE_WEBHOOK_SECRET=

# ---- Bot language (optional; ADR-0016) ----
# The bot answers in DEFAULT_LANGUAGE above until a chat picks otherwise with
# /lang. The messenger's own language_code is the LAST resort, not the first —
# a Persian-first tenant should not greet a stranger in English because their
# phone is. Set these only to depart from that:
#
#   BOT_DEFAULT_LANGUAGE   the bot speaks a different language from the rest of
#                          the platform. Must be one locale-service serves, or
#                          it is skipped with a warning.
#   BOT_LANG_TTL_SEC       idle TTL on a chat's /lang choice (default 30 days)
#   BOT_COMMAND_LANGS      which languages the messenger command menu is
#                          registered in (default fa,en)
# BOT_DEFAULT_LANGUAGE=
# BOT_LANG_TTL_SEC=
# BOT_COMMAND_LANGS=fa,en

# ---- SMS provider ----
# Not read by any service: the key and sender line live in the platform
# owner's credential vault (F-018-a). scripts/seed-sms-line.sh moves these
# there (key = SMS_USERNAME@SMS_PASS). SMS_API_KEY / SMS_SENDER set on a
# service refuse its boot.
SMS_USERNAME=your_sms_username
SMS_PASS=your_sms_password
SMS_SENDER_PRIVATE=1000596446

# ---- Traefik dashboard / registry auth (htpasswd, every '$' doubled) ----
TRAEFIK_PANEL_USERNAME=admin
TRAEFIK_PANEL_PASSWORD=admin:$$2y$$10$$replace_with_your_own_htpasswd_hash
REGISTRY_AUTH_USER_PASS=user:$$apr1$$replace_with_your_own_hash

# ---- TLS / ACME ----
EMAIL_SSL=admin@txnet.local


# #############################################################################
# ##  .env.dev  — DEV ONLY                                                    ##
# #############################################################################
#
# ENVIRONMENT=dev              # Docker build-target stage (dev/prod)
# NODE_ENV=development         # Node/Nest convention (development/production/test)
# DOMAIN_NAME=txnet.cyou
#
# # --- stack isolation: lets dev + prod run on the SAME host at once ---
# STACK_NAME=txnet-dev                 # prefixes every container_name
# PUBLIC_NET_NAME=txnet-dev_public
# PRIVATE_NET_NAME=txnet-dev_private
# MITM_PROXY_IP=host-gateway         # 3eora-mitm-proxy → the Docker host

# Proxy for `npm install` while BUILDING the site-pwa image, if this machine
# needs one (F-088). Empty everywhere else — the value used to be baked into
# site-pwa/Dockerfile as one developer's host, which every build inherited.
# BUILD_HTTP_PROXY=http://proxy.internal:3128
# BUILD_HTTPS_PROXY=http://proxy.internal:3128
# BUILD_NO_PROXY=localhost,127.0.0.1
#
# # --- host-published ports (must not clash with prod) ---
# HTTP_ENTRANCE_PORT=80               # host -> Traefik :80  (change only for dev+prod on one host)
# HTTPS_ENTRANCE_PORT=443             # host -> Traefik :443
# LOCALE_SERVICE_HOST_PORT=50051       # host → locale-service :50051
# TXNET_SITE_HTTP_PORT=8484
# TXNET_SITE_HTTPS_PORT=4241
# AUTH_PORT=3000                     # must equal Traefik loadbalancer.server.port (3000)
#
# # --- data stores ---
# MAIN_DB_NAME=devtxnet
# MAIN_DB_PASSWORD=dev-postgres-pass-change-me
# REDIS_PASSWORD=dev-redis-pass-change-me
# REDIS_URL=redis://:dev-redis-pass-change-me@memory-data:6379
# RABBITMQ_DEFAULT_PASS=dev-rabbit-pass-change-me
#
# # --- behaviour / secrets ---
# LOCALES_WATCH=true
# OTP_DEV_CONSOLE_LOG=true
# JWT_SECRET=dev_jwt_secret            # must equal JWT_ACCESS_SECRET
# JWT_ACCESS_SECRET=dev_jwt_secret
# JWT_REFRESH_HASH_SECRET=dev_refresh_secret
# JWT_SECRET_CAPTCHA=dev_captcha_secret
# NEXT_PUBLIC_PAYMENT_URL=https://pay.txnet.cyou


# #############################################################################
# ##  .env.prod  — PROD ONLY                                                  ##
# #############################################################################
#
# ENVIRONMENT=prod
# NODE_ENV=production
# DOMAIN_NAME=mytxnet.ir
#
# STACK_NAME=txnet-prod
# PUBLIC_NET_NAME=txnet-prod_public
# PRIVATE_NET_NAME=txnet-prod_private
# MITM_PROXY_IP=host-gateway
#
# HTTP_ENTRANCE_PORT=8080             # e.g. prod alongside dev
# HTTPS_ENTRANCE_PORT=8443
# LOCALE_SERVICE_HOST_PORT=50052
# TXNET_SITE_HTTP_PORT=8384
# TXNET_SITE_HTTPS_PORT=4141
# AUTH_PORT=3000                     # must equal Traefik loadbalancer.server.port (3000)
#
# MAIN_DB_NAME=prodtxnet
# MAIN_DB_PASSWORD=prod-postgres-pass-change-me
# REDIS_PASSWORD=prod-redis-pass-change-me
# REDIS_URL=redis://:prod-redis-pass-change-me@memory-data:6379
# RABBITMQ_DEFAULT_PASS=prod-rabbit-pass-change-me
#
# LOCALES_WATCH=false
# OTP_DEV_CONSOLE_LOG=false
# JWT_SECRET=prod_jwt_secret           # must equal JWT_ACCESS_SECRET
# JWT_ACCESS_SECRET=prod_jwt_secret
# JWT_REFRESH_HASH_SECRET=prod_refresh_secret
# JWT_SECRET_CAPTCHA=prod_captcha_secret
# NEXT_PUBLIC_PAYMENT_URL=https://pay.mytxnet.ir


# #############################################################################
# ##  HOW TO RUN                                                              ##
# #############################################################################
#
# Whole stack (dev):    scripts/dev.compose.sh  up -d --build
# Whole stack (prod):   scripts/prod.compose.sh up -d --build
#   → different project name + STACK_NAME + networks + host ports, so BOTH
#     stacks can run on one server simultaneously.
#
# One service only (its deps start automatically via depends_on):
#   scripts/dev.compose.sh up -d locale-service auth-service
#
# A service from source against a running locale-service:
#   scripts/dev.compose.sh up -d locale-service       # publishes LOCALE_SERVICE_HOST_PORT
#   LOCALE_SERVICE_ADDR=localhost:50051 <run the service>

# HMAC key billing-service signs the payment result redirect with (?t=) and
# site-pwa verifies it with — one value for both. Required (32+ chars) in
# production. Generate with: openssl rand -hex 32
PAYMENT_RESULT_SECRET=
