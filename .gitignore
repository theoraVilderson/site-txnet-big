# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ------------------------------------------------------------------------------
# Dependencies
# ------------------------------------------------------------------------------
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ------------------------------------------------------------------------------
# Build output / caches
# ------------------------------------------------------------------------------
.next/
out/
out-tsc/
dist/
build
coverage
*.tsbuildinfo
next-env.d.ts
.nx/cache
.nx/workspace-data

# Go: `air` live-reload build dir + test/binary artifacts
auth-handler/tmp/
**/tmp/
*.test

# ------------------------------------------------------------------------------
# Secrets & local crypto material  — NEVER commit these
# ------------------------------------------------------------------------------
# env files (contain passwords / API keys / JWT secrets)
.env*
# private keys of every flavour
*.pem
*.key
*.p12
*.pfx
# local / internal CA + PKI material
pki/
**/pki/
certs/
# Traefik ACME state (Let's Encrypt account key + issued certs)
dev_letsencrypt/
acme.json
acme.json*
*.json.bak
# misc token dumps
*token.txt
bale_token.txt

# ------------------------------------------------------------------------------
# Editor / OS / tooling
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
.claude/settings.local.json
.claude/worktrees/

# ------------------------------------------------------------------------------
# Logs & debug
# ------------------------------------------------------------------------------
*.log
logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ------------------------------------------------------------------------------
# Misc
# ------------------------------------------------------------------------------
.vercel
repomix-output.xml
