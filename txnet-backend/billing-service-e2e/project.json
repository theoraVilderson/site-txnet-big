{
  "name": "billing-service-e2e",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "implicitDependencies": ["billing-service"],
  "projectType": "application",
  "targets": {
    "e2e": {
      "executor": "@nx/vitest:test",
      "outputs": ["{workspaceRoot}/coverage/{e2eProjectRoot}"],
      "options": {
        "configFile": "billing-service-e2e/vitest.config.mts"
      },
      "dependsOn": ["billing-service:build", "billing-service:serve"]
    }
  }
}
