{
  "name": "@txnet-backend/source",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "seed:catalog": "node prisma/seed-catalog.js",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "typecheck": "bash scripts/typecheck.sh",
    "test": "nx run-many -t test",
    "test:affected": "VITEST_ISOLATE=0 nx affected -t test --base=${BASE:-HEAD}",
    "typecheck:affected": "bash scripts/typecheck.sh --affected",
    "test:int": "vitest run -c auth-service/vitest.int.config.mts && vitest run -c billing-service/vitest.int.config.mts",
    "test:e2e": "vitest run -c auth-service-e2e/vitest.config.mts"
  },
  "dependencies": {
