// بخش دوازده: Schema `notification` — هاب اطلاع‌رسانی
// =============================================================================

enum NotificationType {
  system_alert
  admin_message
  low_balance

  @@schema("notification")
}

enum NotificationChannel {
  push
  sms
  telegram_bot
  bale_bot
  /// F-035-h: the platform's SMTP, on the same terms as `sms` (D-38).
  email

  @@schema("notification")
}

enum CampaignStatus {
  draft
  sending
  completed
  /// F-018-q: halted with its reseller's suspension or termination; its rows stay `queued`. Only `sending` again, by hand.
  stopped

  @@schema("notification")
}

/// F-035-h: a machine draft is never sent; a published text is.
enum CampaignTextState {
  draft
  published

  @@schema("notification")
}

enum DeliveryStatus {
  queued
  sent
  failed

  @@schema("notification")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@map("notification")
  @@schema("notification")
}

/// tenantId=null یعنی کمپین سراسری پلتفرم؛ پر یعنی کمپین فقط روی کاربران
/// همان Tenant اجرا می‌شود.
model NotificationCampaign {
  id                    String              @id @default(uuid()) @db.Uuid
  tenantId              String?             @db.Uuid
  createdByAdminId      String              @db.Uuid
  channel               NotificationChannel
  filterCriteria        Json // {"lastConfigDays": {"gt": 30}, "minBalance": 0}
  messageBody           String
  /// F-035-h: the email subject in the source language; null = the translated default.
  subject               String?
  /// F-035-h: the language `messageBody` and `subject` are written in; null = DEFAULT_LANGUAGE.
  sourceLang            Language?
  status                CampaignStatus      @default(draft)
  sentCount             Int                 @default(0)
  failedCount           Int                 @default(0)
  createdAt             DateTime            @default(now())
  /// F-035-d: set when an admin starts the send; users registered later are not in the audience.
  sendStartedAt         DateTime?
  /// F-035-d: the last `user.id` a committed fan-out batch covered.
  fanOutCursor          String?             @db.Uuid
  /// F-035-d: every recipient row is written.
  fannedOutAt           DateTime?
  /// F-018-q: when the send was stopped; null unless `stopped`.
  stoppedAt             DateTime?

  recipients NotificationCampaignRecipient[]
  texts      NotificationCampaignText[]

  @@index([tenantId])
  @@map("notification_campaign")
  @@schema("notification")
}

/// F-035-h: the campaign in one language other than its source — a machine
/// draft or a published text. A recipient gets the published text in their
/// language, else the source. Reached only through its campaign (no RLS of its
/// own, as the recipient rows); dropped whenever the source text changes.
model NotificationCampaignText {
  id         String            @id @default(uuid()) @db.Uuid
  campaignId String            @db.Uuid
  lang       Language
  subject    String?
  body       String
  state      CampaignTextState @default(draft)
  updatedAt  DateTime          @updatedAt

  campaign NotificationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, lang])
  @@map("notification_campaign_text")
  @@schema("notification")
}

model NotificationCampaignRecipient {
  id             String         @id @default(uuid()) @db.Uuid
  campaignId     String         @db.Uuid
  userId         String         @db.Uuid
  deliveryStatus DeliveryStatus @default(queued)
  /// F-035-e: a delivery run holds this row until then; null or past = free to claim.
  claimedUntil   DateTime?

  campaign NotificationCampaign @relation(fields: [campaignId], references: [id])

  @@unique([campaignId, userId])
  @@index([campaignId, deliveryStatus])
  @@map("notification_campaign_recipient")
  @@schema("notification")
}

// =============================================================================

/// F-601-a: the retention ledger — a notice told once per Grant period. `notice` is the outbox event type;
/// `period` is the producer's name for the Grant's current period (a renewal opens a new one); `eventId` is the
/// event that claimed the row, so its own redelivery claims again (invariant 14).
model RetentionNotice {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  grantId   String   @db.Uuid
  notice    String
  period    String
  eventId   String   @db.Uuid
  createdAt DateTime @default(now())
  /// F-601-m: the bot message held for the user's quiet hours — told at `botAt` (a take leases it forward), then all
  /// four cleared. The inbox row was written when claimed. Null `botAt` = nothing held.
  botTenantId String?   @db.Uuid
  botAt       DateTime?
  botTemplate String?
  botParams   Json?

  @@unique([grantId, notice, period])
  @@index([botAt])
  @@map("retention_notice")
  @@schema("notification")
}

/// F-601-m: a user's retention notice preferences (spec 9.4). `mutedKinds` are `RETENTION_MUTABLE_KINDS`; the quiet
/// window is minutes after local midnight in `timezone` (IANA), both set or both null, and may wrap midnight. No row =
/// nothing muted, no quiet hours. `timezone` null = the user's resolved zone (TZ-1-f, ADR-0108 point 6); a row saved
/// before keeps its own. Keyed by user like `notification`: no `tenantId`, no RLS (invariant 15).
model NotificationPreference {
  userId     String   @id @db.Uuid
  mutedKinds String[] @default([])
  quietStart Int?
  quietEnd   Int?
  timezone   String?
  updatedAt  DateTime @updatedAt

  @@map("notification_preference")
  @@schema("notification")
}

/// F-601-o: how much a user is told about one of their Grants — a buyer of services for friends sets theirs to
/// `essential` (cutoff and purge only, `GRANT_NOTICE_LEVELS`). Keyed by the user who set it: the claim reads
/// `(userId, grantId)`, so a Grant id that is not the caller's names a row nothing reads, and a Grant that changes
/// hands starts at `all` for its new owner. `all` is no row. No `tenantId`, no RLS, like `notification_preference`.
model NotificationGrantPreference {
  userId    String   @db.Uuid
  grantId   String   @db.Uuid
  level     String
  updatedAt DateTime @updatedAt

  @@id([userId, grantId])
  @@map("notification_grant_preference")
  @@schema("notification")
}
