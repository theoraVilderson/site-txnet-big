// بخش هفت: Schema `billing` — بخش الف: کیف پول و ساب‌اکانت
// =============================================================================
// اصل طلایی: هیچ‌وقت موجودی رو مستقیم UPDATE نکن — همیشه Ledger بساز.

enum LedgerDirection {
  credit
  debit

  @@schema("billing")
}

enum WalletReasonType {
  payment_gateway
  coupon_redemption
  traffic_consumption
  admin_manual_adjust
  affiliate_commission
  sub_account_charge
  wallet_transfer_in
  wallet_transfer_out
  /// F-019-h: the buyer pays for a reseller package; `referenceId` = the reseller's tenant id.
  reseller_purchase
  /// F-027-r: purchased bytes a closed Grant never served, given back
  /// (ADR-0072 rule 3); `referenceId` = the Grant. Always a credit, and the
  /// counterpart of the `traffic_consumption` debits that bought them.
  traffic_refund
  /// F-111-b: a catalog product bought from the wallet; `referenceId` = the
  /// invoice. Always a debit — a sale (`IS_SALE` in `reseller-revenue.service.ts`).
  product_purchase
  /// F-111-d: a paid invoice whose Grant could not be delivered, given back in
  /// full; or F-311-m: the unused share of a deleted prepaid Grant's invoice.
  /// `referenceId` = the invoice. Always a credit — it undoes (part of) a
  /// `product_purchase` (`UNDOES`).
  product_refund
  /// F-116-f: a tenant's operating currency changed (ADR-0098 part 5). Each
  /// wallet with a balance gets a closing debit in the old currency and an
  /// opening credit in the new one; `referenceId` = the `currency_change`.
  currency_change
  /// F-118-g: a metered Grant's usage paid for (ADR-0105 (11)) — a prepaid
  /// block debited before it is served, or a postpaid hold captured;
  /// `referenceId` = the Grant. Always a debit, and a sale (`IS_SALE`).
  usage_charge
  /// F-118-g: a prepaid block's units a closed Grant never used, given back;
  /// `referenceId` = the Grant. Always a credit — it undoes `usage_charge` (`UNDOES`).
  usage_refund

  @@schema("billing")
}

/// F-118-am: what a `wallet_transaction` says beyond its `reasonType`.
enum WalletTransactionNote {
  /// A closed Grant's last capture, priced **up** to a whole cent (F-118-al);
  /// only on a `usage_charge` that names its usage.
  final_usage_rounded_up

  @@schema("billing")
}

enum TransferStatus {
  pending_otp
  confirmed
  cancelled
  expired

  @@schema("billing")
}

enum CouponVisibility {
  public
  targeted

  @@schema("billing")
}

/// Where a coupon may be typed (F-502-j). An empty `allowedChannels` = anywhere.
enum CouponChannel {
  panel
  bot

  @@schema("billing")
}

enum RedemptionStatus {
  pending
  confirmed
  expired
  cancelled

  @@schema("billing")
}

enum PaymentProviderName {
  zarinpal
  idpay
  nowpayments
  stripe
  oxapay
  airwallex
  telegram_stars // paid in the tenant's own bot or Mini App (D-32)
  bale // in-chat, like telegram_stars
  manual_transfer // the payer moves the money themselves: a card, a wallet (F-803, D-60)

  @@schema("billing")
}

enum GatewayCategory {
  domestic_rial
  international_card
  crypto
  in_chat // settled inside a messenger chat, never in a browser (D-32)
  manual // confirmed against the payer's proof (F-803, D-60)

  @@schema("billing")
}

enum FeeCalcMode {
  manual
  automatic

  @@schema("billing")
}

enum FeeType {
  fixed
  percentage

  @@schema("billing")
}

/// How a gateway's quoted rate is rounded to its `roundingStep` (catalog F-0609).
/// There is deliberately no `down`: rounding a rate down is a loss on every sale.
enum RateRoundingMode {
  up
  nearest

  @@schema("billing")
}

enum ConfirmationMode {
  automatic
  manual_admin_required

  @@schema("billing")
}

enum PaymentStatus {
  pending
  success
  failed
  expired

  @@schema("billing")
}

enum ConfirmationSource {
  webhook_auto
  reconciliation_auto
  admin_manual

  @@schema("billing")
}

enum ReconciliationAction {
  auto_confirmed
  no_action_needed
  flagged_mismatch

  @@schema("billing")
}

enum CryptoAsset {
  USDT
  BTC
  ETH

  @@schema("billing")
}

enum CryptoNetwork {
  TRC20
  ERC20
  BEP20
  Bitcoin

  @@schema("billing")
}

enum CommissionStatus {
  pending
  paid

  @@schema("billing")
}

/// 6.1 — کیف‌پول کاربر؛ cachedBalance فقط Cache است، منبع حقیقت
/// WalletTransaction است.
model Wallet {
  id            String  @id @default(uuid()) @db.Uuid
  ownerUserId   String  @unique @db.Uuid
  cachedBalance Decimal @default(0) @db.Decimal(20, 4)
  /// The currency it opened in, from its first credit (F-116-b). Every ledger
  /// row is in it: the ledger refuses another, and so does a trigger.
  currencyCode  String
  /// Money locked for what the wallet has promised (F-118-a, ADR-0105 (6)):
  /// the sum of its open `wallet_hold` rows, written only with them (a
  /// deferred trigger checks it at commit). `CHECK (cachedBalance -
  /// heldAmount >= 0)`, so no debit can spend it.
  heldAmount    Decimal @default(0) @db.Decimal(20, 4)
  version       Int     @default(0) // Optimistic Locking
  /// When a hold or release last announced `billing.wallet.changed` (F-118-o):
  /// at most one per `HELD_PUSH_EVERY_MS` per wallet. Never written under `version`.
  heldPushedAt  DateTime?

  owner        User               @relation(fields: [ownerUserId], references: [id])
  transactions WalletTransaction[]
  holds        WalletHold[]

  @@map("wallet")
  @@schema("billing")
}

enum WalletHoldStatus {
  open
  closed

  @@schema("billing")
}

/// A per-use token's life (F-118-h). Only `open` reserves units; the other three are settled.
enum UsageAuthorizationStatus {
  open
  committed
  cancelled
  expired

  @@schema("billing")
}

/// F-118-a (ADR-0105 (6)): money locked on a wallet for one owner — a Grant's
/// postpaid usage, a per-use token. Not a ledger row: a capture debits the
/// ledger and takes the same amount off `amount`; a release takes it off with
/// no money moving. One open hold per `(walletId, ownerRef)` (partial unique
/// index in the migration). Written only by `WalletHoldService`.
model WalletHold {
  id           String           @id @default(uuid()) @db.Uuid
  walletId     String           @db.Uuid
  /// What the money is held for — a Grant, a per-use token.
  ownerRef     String           @db.Uuid
  /// Held now. 0 once closed (CHECK).
  amount       Decimal          @db.Decimal(20, 4)
  /// Taken from it by captures so far.
  captured     Decimal          @default(0) @db.Decimal(20, 4)
  status       WalletHoldStatus @default(open)
  /// Always its wallet's while open (the deferred trigger).
  currencyCode String
  createdAt    DateTime         @default(now())
  closedAt     DateTime?

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@index([walletId, status])
  @@map("wallet_hold")
  @@schema("billing")
}

/// 6.2 — Append-only؛ تاریخچه کامل مثل صورت‌حساب بانکی.
model WalletTransaction {
  id           String            @id @default(uuid()) @db.Uuid
  walletId     String            @db.Uuid
  tenantId     String?           @db.Uuid // denormalized indexed برای گزارش/فیلتر سریع Tenant
  amount       Decimal           @db.Decimal(20, 4) // همیشه مثبت
  direction    LedgerDirection
  reasonType   WalletReasonType
  referenceId  String?           @db.Uuid
  balanceAfter Decimal           @db.Decimal(20, 4)
  /// Always its wallet's at the moment it was written (F-116-b).
  currencyCode String
  /// A credit priced before a currency change and landing after it (F-116-f):
  /// what it was, and in what, before `amount` converted it at the change's
  /// rate. Both or neither, CHECK in the migration.
  sourceAmount       Decimal?    @db.Decimal(20, 4)
  sourceCurrencyCode String?
  /// A postpaid capture's usage (F-118-am): the meter and the units it paid
  /// for — bytes on `vpn.traffic`. Both or neither, CHECK in the migration.
  meterKey      String?
  usageQuantity BigInt?
  /// A fact about the row beyond its `reasonType` (F-118-am); null is none.
  note          WalletTransactionNote?
  createdAt    DateTime          @default(now())

  wallet                Wallet                 @relation(fields: [walletId], references: [id])
  affiliateCommission   AffiliateCommission?
  spinWheelAttempt      SpinWheelAttempt?

  @@index([walletId, createdAt(sort: Desc)])
  @@index([tenantId])
  @@map("wallet_transaction")
  @@schema("billing")
}

/// A spending cap on one product (F-118-i, ADR-0105 (9)): the owner labels
/// who a Grant is for and bounds what its usage may cost. The Grant is funded
/// to `min(free balance, amount − spent − held for it)` and cut at either; the
/// plan's own price is paid at purchase and is not counted. One per Grant.
/// Replaces `sub_account`, a byte pocket on one config that nothing wrote.
model SpendingCap {
  id             String            @id @default(uuid()) @db.Uuid
  /// Its Grant's tenant (`entitlement.same_tenant()`), bound by RLS.
  tenantId       String            @db.Uuid
  grantId        String            @unique @db.Uuid
  /// Who it is for: "Sara", "Office". 1..40 characters (CHECK).
  label          String
  /// Whole minor units, > 0 (CHECK). The wallet's currency; converted with it (F-116-f).
  amount         Decimal           @db.Decimal(20, 4)
  currencyCode   String
  period         SpendingCapPeriod @default(none)
  /// The cap's own start. A `monthly` period restarts on its Grant's billing period (F-118-ak).
  startsAt       DateTime          @default(now())
  /// Where the period `spent` counts from began.
  periodStartsAt DateTime          @default(now())
  /// Usage charged to the Grant this period (blocks, captures). >= 0 (CHECK).
  spent          Decimal           @default(0) @db.Decimal(20, 4)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  grant Grant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("spending_cap")
  @@schema("billing")
}

enum SpendingCapPeriod {
  /// One budget for the life of the Grant.
  none
  /// Restarts every month on the cap's own start date.
  monthly

  @@schema("billing")
}

/// 6.4 — انتقال کیف پول بین کاربران با تأیید OTP (اتمیک).
model WalletTransferRequest {
  id               String         @id @default(uuid()) @db.Uuid
  senderUserId     String         @db.Uuid
  receiverUserId   String         @db.Uuid
  amount           Decimal        @db.Decimal(20, 4)
  note             String?
  status           TransferStatus @default(pending_otp)
  otpCodeHash      String // SENSITIVE — never default-select
  otpExpiresAt     DateTime
  otpAttemptCount  Int            @default(0) // بعد از ۵ تلاش → cancelled
  createdAt        DateTime       @default(now())
  confirmedAt      DateTime?

  @@map("wallet_transfer_request")
  @@schema("billing")
}

/// موتور کوپن — Coupon
model Coupon {
  id                  String            @id @default(uuid()) @db.Uuid
  // null = a platform coupon. It serves the platform owner's own users and no
  // reseller's (ADR-0099, which withdrew ADR-0048's `coupon_tenant`).
  tenantId            String?           @db.Uuid
  // Unique inside a tenant (and once among platform coupons) while not deleted:
  // two partial unique indexes Prisma cannot express, in
  // `20260914000900_coupon_management_schema`.
  code                String
  discountType        DiscountType
  discountValue       Decimal           @db.Decimal(20, 4)
  maxDiscountCap      Decimal?          @db.Decimal(20, 4) // فقط برای درصدی
  minPurchaseAmount   Decimal?          @db.Decimal(20, 4)
  /// The currency its amounts are in (F-116-b, ADR-0098 part 3): never implied
  /// by the tenant, whose currency may change. `^[A-Z]{3}$`, CHECK in the migration.
  currencyCode        String
  totalUsageLimit     Int? // null = نامحدود
  perUserUsageLimit   Int               @default(1) // 0 = unlimited
  usedCount           Int               @default(0)
  reservedCount       Int               @default(0)
  expiresAt           DateTime?
  isActive            Boolean           @default(true)
  visibility          CouponVisibility  @default(public)
  createdByAdminId    String            @db.Uuid
  // The limits of F-502-j (D-33); each is checked by F-502-k with its own reason.
  // Null or empty = no limit. The clock is the server's; weekday and hour are
  // read in Asia/Tehran.
  validFrom           DateTime?
  /// ISO weekdays the coupon works on, 1 = Monday … 7 = Sunday. Empty = every day.
  activeWeekdays      Int[]             @default([])
  /// Hour window [from, to), 0..23 and 1..24; `from > to` wraps midnight. Both or neither.
  activeHourFrom      Int?
  activeHourTo        Int?
  maxPurchaseAmount   Decimal?          @db.Decimal(20, 4)
  firstPurchaseOnly   Boolean           @default(false)
  /// Only a user whose account is at most this many days old.
  newUserWithinDays   Int?
  /// At most `periodUsageLimit` uses per user in any `periodDays` days. Both or neither.
  periodUsageLimit    Int?
  periodDays          Int?
  allowedChannels     CouponChannel[]   @default([])
  /// What the admin calls it; never shown to a user.
  label               String?
  note                String?
  /// A gift code generated in a batch (F-502-d); null = made one at a time.
  batchId             String?           @db.Uuid
  /// A `free_grant` coupon's variant (F-502-l-a); null for every other type. A CHECK holds both.
  grantVariantId      String?           @db.Uuid
  /// Soft delete (D-33): a used coupon is hidden, kept for its receipts.
  deletedAt           DateTime?
  deletedByAdminId    String?           @db.Uuid
  /// F-038-f3 (ADR-0110): a personal coupon issued for an AI suggestion — the
  /// action it was issued for (one coupon per action, so a retried delivery
  /// gets the same code), the offer, and what it took from the offer's daily
  /// budget, in `currencyCode`. All three or none (CHECK `coupon_ai_offer_whole`).
  aiActionId          String?           @unique @db.Uuid
  aiOfferId           String?           @db.Uuid
  aiBudgetCharge      Decimal?          @db.Decimal(20, 4)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @default(now()) @updatedAt

  serviceScopes CouponServiceScope[]
  allowedUsers  CouponAllowedUser[]
  redemptions   CouponRedemption[]
  gateways      CouponGateway[]
  batch         CouponBatch?      @relation(fields: [batchId], references: [id])
  grantVariant  ProductVariant?   @relation(fields: [grantVariantId], references: [id], onDelete: Restrict)

  @@index([tenantId, code])
  @@index([batchId])
  @@index([aiOfferId, createdAt])
  @@map("coupon")
  @@schema("billing")
}

/// A gateway a coupon is limited to (F-502-j). No row = any gateway. Names
/// exactly one of the two gateway kinds, as a payment does.
model CouponGateway {
  id                    String  @id @default(uuid()) @db.Uuid
  couponId              String  @db.Uuid
  gatewayId             String? @db.Uuid
  tenantGatewayConfigId String? @db.Uuid

  // Both RESTRICT, as migration 20260914001100_coupon_limits built them: a
  // gateway a coupon names cannot be deleted from under it, and SET NULL would
  // break CHECK `coupon_gateway_names_one` anyway.
  coupon              Coupon               @relation(fields: [couponId], references: [id])
  gateway             PaymentGateway?      @relation(fields: [gatewayId], references: [id], onDelete: Restrict)
  tenantGatewayConfig TenantGatewayConfig? @relation(fields: [tenantGatewayConfigId], references: [id], onDelete: Restrict)

  @@index([couponId])
  @@map("coupon_gateway")
  @@schema("billing")
}

/// A batch of single-use gift codes generated together (F-502-d, D-33).
/// `tenantId` null = the platform owner's batch.
model CouponBatch {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String?   @db.Uuid
  label            String
  note             String?
  createdByAdminId String    @db.Uuid
  createdAt        DateTime  @default(now())
  /// The whole batch switched off at once; its codes' `isActive` follow.
  deactivatedAt    DateTime?

  coupons Coupon[]

  @@index([tenantId, createdAt])
  @@map("coupon_batch")
  @@schema("billing")
}

/// A coupon limited to one product or one variant (F-026-a); a CHECK holds
/// exactly one. No row at all = any purchase.
model CouponServiceScope {
  id        String  @id @default(uuid()) @db.Uuid
  couponId  String  @db.Uuid
  productId String? @db.Uuid
  variantId String? @db.Uuid

  coupon  Coupon          @relation(fields: [couponId], references: [id])
  // Restrict, not Prisma's SetNull: a nulled side would break the one-of CHECK.
  product Product?        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@map("coupon_service_scope")
  @@schema("billing")
}

/// کوپن هدفمند (visibility=targeted)؛ صدور برای N نفر = N رکورد Bulk Insert.
model CouponAllowedUser {
  id       String @id @default(uuid()) @db.Uuid
  couponId String @db.Uuid
  userId   String @db.Uuid

  coupon Coupon @relation(fields: [couponId], references: [id])

  @@index([couponId, userId])
  @@map("coupon_allowed_user")
  @@schema("billing")
}

/// State Machine دومرحله‌ای آزادسازی کوپن معلق (pending→confirmed/expired/cancelled).
model CouponRedemption {
  id                       String           @id @default(uuid()) @db.Uuid
  couponId                 String           @db.Uuid
  userId                   String           @db.Uuid
  status                   RedemptionStatus @default(pending)
  paymentTransactionId     String?          @db.Uuid
  discountAppliedAmount    Decimal          @db.Decimal(20, 4)
  /// What `discountAppliedAmount` is in: the order's currency, a gift code's own (F-116-h5).
  currencyCode             String
  orderReferenceId         String           @db.Uuid
  redeemedAt               DateTime         @default(now())
  /// A coupon in another currency than the order (F-116-h6): its currency, the
  /// live rate its money was converted at into `currencyCode`, and each leg's
  /// snapshot (NULL for USD, the pivot). All NULL when nothing was converted.
  fxFromCode               String?
  fxRate                   Decimal?         @db.Decimal(30, 18)
  fxSnapshotId             String?          @db.Uuid
  fxFromSnapshotId         String?          @db.Uuid

  coupon             Coupon                @relation(fields: [couponId], references: [id])
  paymentTransaction PaymentTransaction?   @relation(fields: [paymentTransactionId], references: [id])
  fxSnapshotRow      CurrencyExchangeRate? @relation("CouponRedemptionRateToLeg", fields: [fxSnapshotId], references: [id], onDelete: Restrict)
  fxFromSnapshotRow  CurrencyExchangeRate? @relation("CouponRedemptionRateFromLeg", fields: [fxFromSnapshotId], references: [id], onDelete: Restrict)

  // No unique (couponId, userId): perUserUsageLimit may exceed 1 (D-21), so
  // the limit is counted in the redemption transaction, not by an index.
  @@index([couponId, userId])
  @@map("coupon_redemption")
  @@schema("billing")
}

/// 8.1 — تعریف درگاه پرداخت پلتفرم (فقط برای برند خودِ شما،
/// tenantType=platform_owner؛ Resellerها همیشه از tenant.TenantGatewayConfig استفاده می‌کنند).
model PaymentGateway {
  id                  String           @id @default(uuid()) @db.Uuid
  displayName         String
  description         String?
  providerName        PaymentProviderName
  gatewayCategory     GatewayCategory
  supportedCurrencies Json // Array مثل ["USD","EUR"] یا ["USDT","BTC"]
  isActive            Boolean          @default(true)
  merchantId          String // DEPRECATED (D-25): never read — a platform gateway's merchant id is the platform_owner tenant's vault entry
  minAcceptAmount     Decimal?         @db.Decimal(20, 4) // null = no minimum
  maxAcceptAmount     Decimal?         @db.Decimal(20, 4) // null = no maximum
  /// The platform's currency its limits, fees and presets are in (F-116-b) —
  /// not what it charges in, which is `supportedCurrencies`.
  currencyCode        String
  feeCalculationMode  FeeCalcMode
  feeType             FeeType
  feeValue            Decimal          @db.Decimal(18, 4)
  feeFloor            Decimal?         @db.Decimal(20, 4)
  feeCeiling          Decimal?         @db.Decimal(20, 4)
  // Rate from base currency to what the gateway charges in (F-0609). The same
  // columns sit on tenant.TenantGatewayConfig; one calculator reads both.
  useLiveRate         Boolean          @default(true)
  staticRate          Decimal?         @db.Decimal(30, 18)
  percentageModifier  Decimal          @default(0) @db.Decimal(9, 4) // + = markup
  fixedAmountModifier Decimal          @default(0) @db.Decimal(30, 18)
  minRate             Decimal?         @db.Decimal(30, 18)
  maxRate             Decimal?         @db.Decimal(30, 18)
  roundingStep        Decimal?         @db.Decimal(18, 8)
  roundingMode        RateRoundingMode @default(up)
  confirmationMode    ConfirmationMode @default(automatic)
  // Quick amounts on the top-up page (F-092-v). Empty = the tenant's default.
  depositPresets      Decimal[]           @default([]) @db.Decimal(20, 4)
  // Tax on a top-up through this gateway (ADR-0076, F-104-ae). Null = the
  // tenant's default on `deposit_setting`. 0..100, CHECK in the migration.
  taxRatePercent      Decimal?         @db.Decimal(9, 4)
  // The callback address the provider is given (F-092-w). Null = the tenant's panel domain.
  callbackUrl         String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  transactions PaymentTransaction[]
  couponLimits CouponGateway[]
  /// Grants of this gateway to tenants that do not own it (ADR-0041, F-096-a).
  grants       PaymentGatewayGrant[]
  /// The groups it is offered to; none = everyone (F-102-g).
  audience     GatewayAudience[]
  /// A `manual_transfer` gateway's kind, proof and window (F-803-a).
  manualSetting ManualGatewaySetting?
  /// What its provider deducts, from a day on (F-1001-v).
  commissions  GatewayCommission[]

  @@map("payment_gateway")
  @@schema("billing")
}

/// F-102-g — a gateway offered only to chosen user groups of its owner. No
/// row for a gateway = it is offered to everyone, as before; rows = only to a
/// user who is a **user** member of one of them (`admitsUser`, as a discount
/// rule's group). Only the owner's own users: a granted gateway (ADR-0041) is
/// not filtered by its lender's groups. Exactly one of the two gateway columns
/// (CHECK). `tenantId` is the owner's — the platform owner's for a platform
/// gateway (trigger) — and the composite keys keep group and tenant gateway in
/// that tenant. A group in use cannot be deleted (Restrict -> `group_in_use`).
model GatewayAudience {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String   @db.Uuid
  groupId               String   @db.Uuid
  gatewayId             String?  @db.Uuid
  tenantGatewayConfigId String?  @db.Uuid
  createdAt             DateTime @default(now())

  group               UserGroup            @relation(fields: [groupId, tenantId], references: [id, tenantId], onDelete: Restrict)
  gateway             PaymentGateway?      @relation(fields: [gatewayId], references: [id], onDelete: Cascade)
  tenantGatewayConfig TenantGatewayConfig? @relation(fields: [tenantGatewayConfigId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([gatewayId, groupId])
  @@unique([tenantGatewayConfigId, groupId])
  @@index([tenantId])
  @@index([groupId])
  @@map("gateway_audience")
  @@schema("billing")
}

/// A tenant's default quick amounts on the top-up page (F-092-v); a gateway's
/// own `depositPresets` override them. In `currencyCode`. One row per
/// tenant, written through `deposit-presets.ts`.
/// `taxRatePercent` is the tenant's default tax on a top-up (ADR-0076), which a
/// gateway's own rate overrides; null = no tax. 0..100, CHECK in the migration.
model DepositSetting {
  tenantId        String    @id @db.Uuid
  presets         Decimal[] @default([]) @db.Decimal(20, 4)
  /// The currency its amounts are in (F-116-b, ADR-0098 part 3): never implied
  /// by the tenant, whose currency may change. `^[A-Z]{3}$`, CHECK in the migration.
  currencyCode    String
  taxRatePercent  Decimal?  @db.Decimal(9, 4)
  updatedByUserId String?   @db.Uuid
  updatedAt       DateTime  @updatedAt

  @@map("deposit_setting")
  @@schema("billing")
}

enum InvoiceStatus {
  pending
  paid
  expired
  cancelled
  /// F-111-d: paid, its Grant not delivered, and the whole `total` credited back.
  refunded

  @@schema("billing")
}

/// One purchase of one catalog variant (F-111-a, spec §5.8 step 1). Priced by
/// the server from the catalog in USD at creation — `priceId` is the row that
/// was in effect — and never from a client's number. Its coupon holds are the
/// `coupon_redemption` rows whose `orderReferenceId` is this id. Money moves
/// only when it is paid (F-111-b); a `pending` one past `expiresAt` is expired
/// by the sweep and its holds given back.
model Invoice {
  id        String        @id @db.Uuid
  tenantId  String        @db.Uuid
  userId    String        @db.Uuid
  variantId String        @db.Uuid
  priceId   String        @db.Uuid
  /// The catalog price, in `currencyCode`.
  amount    Decimal       @db.Decimal(20, 4)
  /// Everything taken off `amount`: the automatic rule's part, then the
  /// coupons', stacked on what the rule left (F-092-g, F-114-h).
  discount  Decimal       @db.Decimal(20, 4)
  /// The automatic discount rule applied, if any (F-114-h, D-45), and what it took.
  discountRuleId String?  @db.Uuid
  ruleDiscount   Decimal  @default(0) @db.Decimal(20, 4)
  /// `amount - discount`, a CHECK; what the wallet pays.
  total     Decimal       @db.Decimal(20, 4)
  /// The currency its amounts are in (F-116-b, ADR-0098 part 3): never implied
  /// by the tenant, whose currency may change. `^[A-Z]{3}$`, CHECK in the migration.
  currencyCode String
  status    InvoiceStatus @default(pending)
  /// Whether it is in its variant's sales counts (F-513-b): held while
  /// `pending`, sold once `paid`. False on every invoice made before the counts.
  salesCounted Boolean    @default(false)
  expiresAt DateTime
  createdAt DateTime      @default(now())
  updatedAt DateTime      @default(now()) @updatedAt

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  price   Price          @relation(fields: [priceId], references: [id], onDelete: Restrict)
  discountRule DiscountRule? @relation(fields: [discountRuleId], references: [id], onDelete: Restrict)

  @@index([status, expiresAt])
  @@index([tenantId, userId, createdAt(sort: Desc)])
  @@index([variantId])
  @@map("invoice")
  @@schema("billing")
}

enum DiscountRuleKind {
  percentage
  fixed_amount

  @@schema("billing")
}

/// A discount with no code (F-114-h, D-45, ADR-0087): taken at invoice pricing
/// from every purchase it matches, before any coupon. One tenant's own; what it
/// covers is everything, one product, or one category and those under it; who
/// it serves is everyone, or the users in `users`. Switched off, never deleted
/// once an invoice names it.
model DiscountRule {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String           @db.Uuid
  /// The admin's label, shown to the buyer beside what it took.
  name             String           @db.VarChar(80)
  kind             DiscountRuleKind
  /// A percentage in (0, 100], or a fixed amount in `currencyCode` (C-02).
  value            Decimal          @db.Decimal(20, 4)
  /// The currency its amounts are in (F-116-b, ADR-0098 part 3): never implied
  /// by the tenant, whose currency may change. `^[A-Z]{3}$`, CHECK in the migration.
  currencyCode     String
  /// At most one of the two; neither = every product.
  productId        String?          @db.Uuid
  categoryId       String?          @db.Uuid
  /// True = only the users in `users`.
  forNamedUsers    Boolean          @default(false)
  /// Only this group's user members (F-114-j); never with `forNamedUsers`.
  groupId          String?          @db.Uuid
  startsAt         DateTime
  /// Null = until switched off.
  endsAt           DateTime?
  isActive         Boolean          @default(true)
  createdByAdminId String           @db.Uuid
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now()) @updatedAt

  product  Product?           @relation(fields: [productId], references: [id], onDelete: Cascade)
  category ProductCategory?   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  group    UserGroup?         @relation(fields: [groupId, tenantId], references: [id, tenantId], onDelete: Restrict)
  users    DiscountRuleUser[]
  invoices Invoice[]

  @@index([tenantId, isActive])
  @@map("discount_rule")
  @@schema("billing")
}

/// A user a `forNamedUsers` rule serves (F-114-h).
model DiscountRuleUser {
  ruleId   String @db.Uuid
  userId   String @db.Uuid
  tenantId String @db.Uuid

  rule DiscountRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@id([ruleId, userId])
  @@index([userId])
  @@map("discount_rule_user")
  @@schema("billing")
}

/// 8.2 — تراکنش پرداخت با دو خط دفاعی تأیید (Webhook + Reconciliation)
/// به‌علاوه Fallback تأیید دستی ادمین.
model PaymentTransaction {
  id                    String              @id @default(uuid()) @db.Uuid
  tenantId              String?             @db.Uuid // denormalized indexed
  userId                String              @db.Uuid
  // Exactly one of the two gateway columns is set — the platform brand's or a
  // reseller's own (ADR-0006). A CHECK in 20260911000000_payment_legacy_port
  // enforces it; Prisma cannot express it.
  gatewayId             String?             @db.Uuid
  tenantGatewayConfigId String?             @db.Uuid
  amountRequested       Decimal             @db.Decimal(20, 4) // before coupons, in `currencyCode`
  feeApplied            Decimal             @db.Decimal(20, 4)
  discountApplied       Decimal             @default(0) @db.Decimal(20, 4) // every coupon together
  amountCredited        Decimal             @db.Decimal(20, 4) // base + adjustment gap
  /// The currency every amount above is in — the payer's tenant's, or the
  /// platform's for a billing top-up (F-116-b). Not the charge currency.
  currencyCode          String
  // The tax charged on top (ADR-0076) and the rate it was charged at, frozen
  // at intent so a later rate change cannot re-explain the receipt. No rate =
  // no tax: a row from before F-104-ae reads 0 and NULL. CHECKs in the migration.
  taxApplied            Decimal             @default(0) @db.Decimal(20, 4)
  taxRatePercent        Decimal?            @db.Decimal(9, 4)
  // What the gateway is asked to charge, in its own currency's minor unit, and
  // the `currencyCode` -> that-currency rate that produced it (ADR-0019,
  // F-116-e). Frozen at intent. 18 places: an inverse pair (IRR -> USD) has no
  // digits left at 8, and settlement divides by this.
  chargedAmountMinor    BigInt
  exchangeRateSnapshot  Decimal?            @db.Decimal(30, 18)
  // Which rate that was: the `currency_exchange_rate` row the number was read
  // from (F-0606-b, ADR-0019). The FX worker appends a row every accepted poll,
  // so the rate alone does not say which reading priced this payment. NULL on a
  // gateway that priced from its own `staticRate`, and before F-092-c.
  // Since F-116-e the rate is a pair, `currencyCode` -> charge currency through
  // the USD pivot: this is the charge currency's leg (NULL when it is USD), and
  // `exchangeRateFromSnapshotId` the payment currency's (NULL when it is USD).
  exchangeRateSnapshotId String?            @db.Uuid
  exchangeRateFromSnapshotId String?        @db.Uuid
  /// What the gateway reports actually arrived (D-32, F-104-a): its receipt,
  /// never money of record — `amountCredited` is. In `receivedCurrency`'s own
  /// minor unit; a crypto payer may settle in another asset than invoiced.
  /// Both set or both NULL, amount >= 0, code `^[A-Z0-9]{2,20}$` — CHECKs in
  /// 20260916000200_payment_d32_providers_and_receipt.
  amountReceivedMinor    BigInt?
  receivedCurrency       String?
  status                PaymentStatus       @default(pending)
  gatewayTrackingCode   String? // the id a duplicate callback shares — Zarinpal `authority` (ADR-0028)
  /// Authorities **offered** for a payment that has none, and not yet proven
  /// (F-092-ag, ADR-0047 decision 1): a callback naming this row by `?p=` met
  /// silence. One the gateway confirms becomes `gatewayTrackingCode` in the
  /// crediting flip; one it disowns is taken back off. At most
  /// `MAX_AUTHORITY_CANDIDATES`.
  authorityCandidates   String[]            @default([])
  gatewayReferenceId    String? // the receipt number of a paid payment — Zarinpal `ref_id`
  cardPanMasked         String?
  failureCode           String?
  confirmationSource    ConfirmationSource?
  confirmedByAdminId    String?             @db.Uuid
  /// The grant this payment was taken under (ADR-0041, F-096-a). NULL is the
  /// ordinary case: the tenant used a gateway it owns. Non-null means the money
  /// landed in somebody else's merchant account and this tenant is owed it.
  grantId               String?             @db.Uuid
  /// The reseller whose **billing wallet** this payment tops up (F-019-b, D-41,
  /// ADR-0056), or NULL for a user's wallet top-up. Set, the row lives in the
  /// platform owner's scope — its gateway, its vault, its callback host — and
  /// settles into `tenant_billing_wallet` instead of a user's wallet. A CHECK in
  /// 20260917001000_payment_billing_tenant: a platform gateway, no grant, no discount.
  billingTenantId        String?             @db.Uuid
  manualConfirmReason   String? // اجباری در سطح اپلیکیشن اگر confirmationSource=admin_manual
  createdAt             DateTime            @default(now())
  expiresAt             DateTime? // معمولاً now()+15min
  returnOrigin           String? // the panel origin the payer started from; the callback redirects there
  returnBotLink          String? // F-093-u: the bot a top-up started in; the result page offers the way back to it
  /// Where the top-up was started (F-306-a): the panel, or the bot through the
  /// gate. The payer notice tells a `bot` payer about a webhook credit too.
  channel                CouponChannel       @default(panel)
  /// A verifying payment (F-092-x, ADR-0044): the row stays `pending`, and a
  /// non-null `nextVerifyAt` means the gateway met a verify or inquire with
  /// silence and must be asked again then. `verifyAttempts` is the ladder rung.
  verifyAttempts         Int                 @default(0)
  nextVerifyAt           DateTime?
  /// Set once when a payment is still verifying `VERIFY_FLAG_AFTER_SEC` (24 h)
  /// after it was made: a person should look (F-092-y, ADR-0044 decision 5).
  /// Retries go on; it is history, never cleared.
  verifyFlaggedAt        DateTime?
  /// An in-chat payment's payer in their messenger (F-104-ab): the platform
  /// and the id the gate read from the starting session's chat scope. The
  /// bot's relay of `pre_checkout_query` / `successful_payment` is admitted only
  /// from this sender. Both or neither — a CHECK in 20260918000300_payment_in_chat_payer.
  payerChatPlatform      String?
  payerChatId            String?

  // Restrict, not the optional-relation default SetNull: a payment is a
  // permanent record, and nulling its gateway would also break the CHECK.
  gateway                 PaymentGateway?           @relation(fields: [gatewayId], references: [id], onDelete: Restrict)
  // Restrict for the same reason as the gateway: the snapshot is the evidence
  // the payment was priced correctly, and the rate table is append-only anyway.
  exchangeRateSnapshotRow CurrencyExchangeRate?     @relation("PaymentRateToLeg", fields: [exchangeRateSnapshotId], references: [id], onDelete: Restrict)
  exchangeRateFromSnapshotRow CurrencyExchangeRate? @relation("PaymentRateFromLeg", fields: [exchangeRateFromSnapshotId], references: [id], onDelete: Restrict)
  tenantGatewayConfig     TenantGatewayConfig?      @relation(fields: [tenantGatewayConfigId], references: [id], onDelete: Restrict)
  grant                   PaymentGatewayGrant?      @relation(fields: [grantId], references: [id], onDelete: Restrict)
  settlementEntry         GatewaySettlementEntry?
  couponRedemptions       CouponRedemption[]
  reconciliationLogs      PaymentReconciliationLog[]
  cryptoDetail            CryptoPaymentDetail?
  affiliateCommissions    AffiliateCommission[]
  transferDetail          PaymentTransferDetail?
  transferRefs            TransferTxRef[]

  // ADR-0028, once per gateway column. NULLs never collide, so a pending row
  // with no code yet, or a row on the other column, is outside each key.
  @@unique([gatewayId, gatewayTrackingCode])
  @@unique([tenantGatewayConfigId, gatewayTrackingCode])
  @@index([tenantId])
  @@index([status, expiresAt])
  @@index([status, nextVerifyAt])
  @@index([grantId])
  @@map("payment_transaction")
  @@schema("billing")
}

/// 8.3 — خط دوم دفاع: Reconciliation Worker (Inquiry API خودِ درگاه).
model PaymentReconciliationLog {
  id                    String               @id @default(uuid()) @db.Uuid
  paymentTransactionId  String               @db.Uuid
  checkedAt             DateTime             @default(now())
  gatewayReportedStatus String // پاسخ خام Inquiry API درگاه
  actionTaken           ReconciliationAction
  notes                 String?

  paymentTransaction PaymentTransaction @relation(fields: [paymentTransactionId], references: [id])

  @@map("payment_reconciliation_log")
  @@schema("billing")
}

/// 8.4 — جزئیات پرداخت کریپتو؛ exchangeRateSnapshot هرگز بعداً بر اساس
/// نرخ روز حساب نمی‌شود.
model CryptoPaymentDetail {
  id                       String        @id @default(uuid()) @db.Uuid
  paymentTransactionId     String        @unique @db.Uuid
  cryptoAsset              CryptoAsset
  network                  CryptoNetwork
  depositAddress           String
  requiredConfirmations    Int
  receivedConfirmations    Int           @default(0)
  exchangeRateSnapshot     Decimal       @db.Decimal(18, 8)
  txHash                   String?

  paymentTransaction PaymentTransaction @relation(fields: [paymentTransactionId], references: [id])

  @@map("crypto_payment_detail")
  @@schema("billing")
}

/// 8.5 — سیستم Affiliate؛ جدا از User.referredByUserId چون باید تاریخچه
/// کامل واریزها را با وضعیت جدا نگه دارد.
model AffiliateReferral {
  id               String   @id @default(uuid()) @db.Uuid
  referrerUserId   String   @db.Uuid
  referredUserId   String   @db.Uuid
  signedUpAt       DateTime @default(now())

  commissions AffiliateCommission[]

  @@map("affiliate_referral")
  @@schema("billing")
}

model AffiliateCommission {
  id                       String            @id @default(uuid()) @db.Uuid
  referralId               String            @db.Uuid
  triggeringPaymentId      String            @db.Uuid
  commissionAmount         Decimal           @db.Decimal(20, 4)
  status                   CommissionStatus  @default(pending)
  payoutWalletTransactionId String?          @unique @db.Uuid

  referral            AffiliateReferral   @relation(fields: [referralId], references: [id])
  triggeringPayment   PaymentTransaction  @relation(fields: [triggeringPaymentId], references: [id])
  payoutTransaction   WalletTransaction?  @relation(fields: [payoutWalletTransactionId], references: [id])

  @@map("affiliate_commission")
  @@schema("billing")
}

// =============================================================================

// =============================================================================
// 8.5 — Granted gateways and what they collect (ADR-0041, F-096-a)
// =============================================================================

/// ADR-0041 — یک tenant می‌تواند از درگاهی که مالکش نیست استفاده کند، فقط با
/// اعطای صریح مالک پلتفرم. Schema only for now: no service reads it (F-096-b).
///
/// `tenantId` is the **borrowing** tenant — the one the grant is *to*. It
/// carries that name and not `granteeTenantId` because it is the column RLS
/// and `withTenant` key on, and a grant is exactly the borrower's to see.
/// Which tenant *owns* the gateway is the gateway row's business, not this one's.
model PaymentGatewayGrant {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String    @db.Uuid
  // Exactly one of the two, like `payment_transaction`: the platform's own
  // gateway or another reseller's. A CHECK enforces it (Prisma cannot).
  gatewayId             String?   @db.Uuid
  tenantGatewayConfigId String?   @db.Uuid
  grantedByAdminId      String    @db.Uuid
  /// Withdrawn, not deleted: a payment that was taken through this grant keeps
  /// pointing at it, and what was owed stays explicable (ADR-0041 §6).
  isActive              Boolean   @default(true)
  grantedAt             DateTime  @default(now())
  withdrawnAt           DateTime?
  withdrawnByAdminId    String?   @db.Uuid
  note                  String?

  // Restrict, like `payment_transaction`'s: a grant is a record, and nulling
  // its gateway would break the CHECK as well as the story.
  gateway             PaymentGateway?      @relation(fields: [gatewayId], references: [id], onDelete: Restrict)
  tenantGatewayConfig TenantGatewayConfig? @relation(fields: [tenantGatewayConfigId], references: [id], onDelete: Restrict)
  payments            PaymentTransaction[]
  settlementEntries   GatewaySettlementEntry[]

  @@index([tenantId, isActive])
  @@map("payment_gateway_grant")
  @@schema("billing")
}

/// ADR-0041 §4 — بدهی پلتفرم به tenant قرض‌گیرنده: هر پرداخت موفق از درگاه
/// اعطاشده، مبلغ واریزشده (منهای کارمزد درگاه) را اینجا انباشته می‌کند.
/// Append-only, one row per payment, written inside the crediting transaction.
model GatewaySettlementEntry {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  grantId              String   @db.Uuid
  /// The tenant that is **owed** — the borrower whose user was credited.
  tenantId             String   @db.Uuid
  /// One accrual per payment, so a retried callback cannot accrue twice.
  paymentTransactionId String   @unique @db.Uuid
  /// In `currencyCode` (C-02). `amountCredited` net of the gateway fee.
  amount               Decimal  @db.Decimal(20, 4)
  /// Its payment's (F-116-b).
  currencyCode         String
  accruedAt            DateTime @default(now())

  grant              PaymentGatewayGrant @relation(fields: [grantId], references: [id])
  paymentTransaction PaymentTransaction  @relation(fields: [paymentTransactionId], references: [id])

  @@index([tenantId, accruedAt(sort: Desc)])
  @@map("gateway_settlement_entry")
  @@schema("billing")
}

/// ADR-0041 §5 — تسویه، یک پرداخت دستیِ ثبت‌شده است؛ هرگز خودکار نیست.
/// اپراتور پول را بیرون از سیستم منتقل می‌کند و اینجا با سند و هویت خودش ثبت.
model GatewaySettlementPayout {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The tenant that was paid.
  tenantId          String   @db.Uuid
  /// In `currencyCode` (C-02). What is still owed is the accruals minus these.
  amount            Decimal  @db.Decimal(20, 4)
  /// The paid tenant's operating currency when it was recorded (F-116-b).
  currencyCode      String
  paidAt            DateTime @default(now())
  /// Never null in practice: a payout is a person's act and is attributed (ADR-0041 §5).
  recordedByAdminId String   @db.Uuid
  /// Free text: "bank transfer", "sheba", a gateway's own payout id.
  method            String?
  reference         String?
  /// The transfer's proof. A **key**, not a URL: the object store is D-8's port
  /// and lands with F-033, so nothing resolves this yet (F-096-e).
  proofAttachmentKey String?
  notes             String?

  @@index([tenantId, paidAt(sort: Desc)])
  @@map("gateway_settlement_payout")
  @@schema("billing")
}

/// F-311-u1: one Grant's outcome of one bulk request (F-311-u) — a repeated
/// `requestId` (a double click, a bot callback delivered twice) answers these
/// rows and acts on no Grant again. An `ok` row is written in the act's own
/// transaction, so a concurrent repeat's insert collides and its act rolls
/// back; a refusal is written after it. A `failed` throw is never stored: that
/// Grant was not touched and a repeat tries it again. `fingerprint` is the
/// body's hash — the same id with another body is `request_reused`. No foreign
/// key on `grantId`: a `grant_not_found` outcome names a Grant that is not the
/// reseller's, or none; none on the actor (may be the platform's staff).
model GrantBulkOutcome {
  tenantId    String   @db.Uuid
  requestId   String   @db.Uuid
  grantId     String   @db.Uuid
  fingerprint String
  actorUserId String   @db.Uuid
  ok          Boolean
  /// The outcome exactly as the route answered it: `{grantId, userId, ok, result}` or `{grantId, ok, reason, panels?}`.
  outcome     Json
  createdAt   DateTime @default(now())

  @@id([tenantId, requestId, grantId])
  @@map("grant_bulk_outcome")
  @@schema("billing")
}

enum GrantBulkJobStatus {
  running
  done
  cancelled

  @@schema("billing")
}

/// F-311-u2: a bulk act (F-311-u) whose Grants were chosen by a filter — a
/// panel, a product or variant, statuses — rather than by id, run by the
/// worker in batches. The selection is **frozen at the confirm**: the Grants
/// that matched then are this job's items, so the count the admin saw is what
/// is acted on and a Grant bought a minute later is not. `requestId` is the
/// caller's, as for a bulk by id: a repeat answers this job, another body with
/// it is `request_reused`, and each Grant's outcome is `grant_bulk_outcome`'s
/// row under it — the same once-per-Grant key. `command` is the action's own
/// input and the reason; the actor is kept because each act is audited as theirs.
model GrantBulkJob {
  id           String             @id @default(uuid()) @db.Uuid
  tenantId     String             @db.Uuid
  requestId    String             @db.Uuid
  fingerprint  String
  actorUserId  String             @db.Uuid
  actorIp      String
  /// The actor was admitted as platform staff (F-118-ac): its gift is the platform's, never the reseller's to buy.
  byPlatform   Boolean            @default(false)
  action       String
  /// The bulk body without `requestId` and `filter`: `{action, reason, …the action's input}`.
  command      Json
  filter       Json
  status       GrantBulkJobStatus @default(running)
  /// The Grants frozen at the confirm; never changes after.
  total        Int
  okCount      Int                @default(0)
  refusedCount Int                @default(0)
  failedCount  Int                @default(0)
  createdAt    DateTime           @default(now())
  /// When the last item got its outcome, or the admin cancelled.
  finishedAt   DateTime?
  /// When its items and per-Grant outcomes were purged, `GRANT_BULK_RETENTION_DAYS`
  /// after `finishedAt` (F-311-u3). The row and its counts stay: the list, a
  /// repeated `requestId`, and the audit rows still read it.
  purgedAt     DateTime?

  items GrantBulkJobItem[]

  @@unique([tenantId, requestId])
  @@index([tenantId, createdAt])
  @@map("grant_bulk_job")
  @@schema("billing")
}

/// One Grant of a `GrantBulkJob`, frozen at the confirm. `doneAt` is set once
/// it has its outcome — kept in `grant_bulk_outcome`, or `failed` after the
/// last attempt (a throw nobody named is tried again on the next batches).
/// `ok` is that outcome's, copied so the outcomes page filters without a join.
model GrantBulkJobItem {
  jobId    String    @db.Uuid
  tenantId String    @db.Uuid
  grantId  String    @db.Uuid
  attempts Int       @default(0)
  doneAt   DateTime?
  ok       Boolean?
  failed   Boolean   @default(false)

  job GrantBulkJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([jobId, grantId])
  @@map("grant_bulk_job_item")
  @@schema("billing")
}

/// F-116-f (ADR-0098 part 5): one change of a tenant's operating currency, and
/// the rate everything live was converted at — `rate` units of `toCode` per
/// one `fromCode`, the pair's readings in `fromSnapshotId` / `toSnapshotId`
/// (a leg on the USD pivot has none). A ledger reads these to credit money
/// priced before the change in the wallet's currency after it. Written only on
/// the cross-tenant pool; `summary` counts what was converted.
model CurrencyChange {
  id              String   @id @db.Uuid
  tenantId        String   @db.Uuid
  fromCode        String
  toCode          String
  rate            Decimal  @db.Decimal(30, 18)
  fromSnapshotId  String?  @db.Uuid
  toSnapshotId    String?  @db.Uuid
  changedByUserId String   @db.Uuid
  summary         Json     @default("{}")
  createdAt       DateTime @default(now())

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("currency_change")
  @@schema("billing")
}

/// One report of usage on a Grant's meter (F-118-f, ADR-0105 decision 5).
/// Append-only. The `(source, idempotencyKey)` insert is the deduplication:
/// a copy advances nothing. `grant_meter.consumed` is the sum of these for
/// every meter but `vpn.traffic`, whose bytes keep the delta path until F-118-l.
model UsageEvent {
  id             String   @id @default(uuid()) @db.Uuid
  /// Its meter's tenant (`entitlement.same_tenant()`), bound by RLS.
  tenantId       String   @db.Uuid
  grantId        String   @db.Uuid
  meterKey       String
  /// In the meter's unit. Always > 0 (CHECK).
  quantity       BigInt
  /// When the reporter says the use happened.
  occurredAt     DateTime
  /// The reporting service, e.g. `notification-service`. Scopes the key.
  source         String
  /// The reporter's own key for this use: the same use, the same key.
  idempotencyKey String
  recordedAt     DateTime @default(now())

  grantMeter GrantMeter @relation(fields: [grantId, meterKey], references: [grantId, meterKey], onDelete: Restrict, onUpdate: Restrict)

  @@unique([source, idempotencyKey])
  @@index([grantId, meterKey, occurredAt])
  @@index([tenantId])
  @@map("usage_event")
  @@schema("billing")
}

/// A per-use door's token (F-118-h, ADR-0105 decision 7): work on a per-use
/// meter authorized before it is done. Open, it reserves `quantity` units the
/// meter already funds — debited (`boughtUnits`, prepaid) or held (on the
/// meter's hold, `heldAmount`, postpaid) — and, on a reseller's Grant, the
/// `wholesaleUnits` it bought on the reseller's billing wallet. `commit`
/// records the actual use as a `usage_event` keyed by the token's id; commit,
/// `cancel` and expiry each give back what no open token still needs.
/// Never deleted. `(grantId, meterKey, idempotencyKey)` unique: the same key
/// answers the same token.
model UsageAuthorization {
  id                String                   @id @default(uuid()) @db.Uuid
  /// Its meter's tenant (`entitlement.same_tenant()`), bound by RLS.
  tenantId          String                   @db.Uuid
  grantId           String                   @db.Uuid
  meterKey          String
  idempotencyKey    String
  /// Units authorized, in the meter's unit. Always > 0 (CHECK).
  quantity          BigInt
  status            UsageAuthorizationStatus @default(open)
  /// Prepaid: the units this token's block bought (0 when the meter already funded them).
  boughtUnits       BigInt                   @default(0)
  /// Postpaid: what this token added to the meter's hold, in the meter's currency.
  heldAmount        Decimal                  @default(0) @db.Decimal(20, 4)
  /// A reseller's Grant: the units this token bought on the reseller's billing wallet.
  wholesaleUnits    BigInt                   @default(0)
  /// Set by `commit` only, never above `quantity` (CHECK).
  committedQuantity BigInt?
  expiresAt         DateTime
  createdAt         DateTime                 @default(now())
  /// Set when it leaves `open` (CHECK).
  settledAt         DateTime?

  grantMeter GrantMeter @relation(fields: [grantId, meterKey], references: [grantId, meterKey], onDelete: Restrict, onUpdate: Restrict)

  @@unique([grantId, meterKey, idempotencyKey])
  @@index([status, expiresAt])
  @@index([tenantId])
  @@map("usage_authorization")
  @@schema("billing")
}

// =============================================================================
// F-803-a, D-60 — a manual transfer: the payer moves the money to a card or a
// wallet the seller entered, and a person confirms it against the proof
// (`billing/contract.manual-transfer.md` "Storage"). RLS strict on all four;
// the triggers and CHECKs are in 20261015000300_a_manual_transfer_is_stored.
// =============================================================================

/// Why a transfer sits in the review queue. Only `proof_only` is written until
/// automatic confirmation lands (F-803-e); the rest are its outcomes, here so
/// that row needs no migration.
enum TransferReviewReason {
  underpaid
  overpaid
  late
  wrong_destination
  duplicate_ref
  amount_collision
  no_match
  proof_only

  @@schema("billing")
}

/// One per `manual_transfer` gateway: its method kind, how it is confirmed,
/// the proof the payer must send and how long the payer has. Exactly one of
/// the two gateway columns (CHECK); a platform gateway's is the platform
/// owner's and only a `manual_transfer` gateway has one (trigger).
/// `confirmationMode` is the gateway enum; only `manual_admin_required` is
/// accepted until a kind has a watcher (F-803-c refuses the other).
model ManualGatewaySetting {
  id                    String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String           @db.Uuid
  gatewayId             String?          @unique @db.Uuid
  tenantGatewayConfigId String?          @db.Uuid
  /// A `ManualMethod` registry id (`payment/manual/kinds/`), not an enum: a new kind is one file (F-803-b).
  kind                  String
  confirmationMode      ConfirmationMode @default(manual_admin_required)
  /// The kind's proof field ids the payer must send (D-60 part 4).
  requiredProof         String[]         @default([])
  /// 10..1440, CHECK in the migration.
  windowMinutes         Int              @default(30)
  /// The seller's usual time to confirm a proof, shown to the payer ("usually within n minutes"); 1..1440, CHECK in the migration; null = no figure (F-803-l).
  confirmWithinMinutes  Int?
  /// Payer instructions replacing the kind's default, by language code; null = the default.
  instructions          Json?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  gateway             PaymentGateway?      @relation(fields: [gatewayId], references: [id], onDelete: Cascade)
  tenantGatewayConfig TenantGatewayConfig? @relation(fields: [tenantGatewayConfigId, tenantId], references: [id, tenantId], onDelete: Cascade)
  destinations        ManualDestination[]

  /// One per reseller gateway; composite because the relation is (a config is one tenant's).
  @@unique([tenantGatewayConfigId, tenantId])
  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("manual_gateway_setting")
  @@schema("billing")
}

/// A card or a wallet a manual gateway shows the payer. `fields` is validated
/// by the setting's kind (F-803-b). A destination a payment showed is
/// deactivated, never deleted (Restrict from `payment_transfer_detail`).
model ManualDestination {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @db.Uuid
  settingId     String   @db.Uuid
  label         String
  fields        Json
  isActive      Boolean  @default(true)
  /// The order the first active destination is picked by, until rotation (F-807).
  sortOrder     Int      @default(0)
  /// F-807's rotation weight, 1..100 (CHECK); unread until then.
  weight        Int      @default(1)
  /// F-807's daily cap in the charge currency's minor unit; unread until then.
  dailyCapMinor BigInt?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  setting   ManualGatewaySetting    @relation(fields: [settingId, tenantId], references: [id, tenantId], onDelete: Cascade)
  transfers PaymentTransferDetail[]

  @@unique([id, tenantId])
  @@index([settingId, isActive, sortOrder])
  @@index([tenantId])
  @@map("manual_destination")
  @@schema("billing")
}

/// What one manual payment showed the payer and the proof it got. The
/// snapshot is what the payer saw, so editing a destination never changes an
/// open payment. `tenantId` is the payment's (trigger).
model PaymentTransferDetail {
  paymentId           String                @id @db.Uuid
  tenantId            String                @db.Uuid
  destinationId       String                @db.Uuid
  /// The destination's public fields as shown, frozen at start (F-803-d).
  destinationSnapshot Json
  /// What the payer must send, in `chargeCurrency`'s minor unit (> 0, CHECK).
  expectedAmountMinor BigInt
  chargeCurrency      String
  chargeDecimals      Int
  /// A wallet's network, shown verbatim; null for a card.
  network             String?
  windowEndsAt        DateTime
  /// The payer's proof by the kind's field ids; set with `proofSubmittedAt` (CHECK, F-805-a).
  proof               Json?
  proofSubmittedAt    DateTime?
  /// When a person sent the proof back to be sent again — once at most (F-805-a).
  proofReturnedAt     DateTime?
  reviewReason        TransferReviewReason?
  /// The reference an automatic path saw, before a person confirmed (F-803-f).
  seenTxRef           String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  payment     PaymentTransaction @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  destination ManualDestination  @relation(fields: [destinationId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@index([tenantId])
  @@index([destinationId])
  @@map("payment_transfer_detail")
  @@schema("billing")
}

/// An external reference already credited — a tx hash, a bank tracking code
/// or an SMS reference: once per (tenant, network, ref), whichever path saw it
/// first. A card's `network` is the kind's own namespace (F-803-b).
model TransferTxRef {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid
  paymentId String   @db.Uuid
  network   String
  txRef     String
  createdAt DateTime @default(now())

  payment PaymentTransaction @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([tenantId, network, txRef])
  @@index([paymentId])
  @@map("transfer_tx_ref")
  @@schema("billing")
}

/// F-1001-a: what a sale was, for the analytics rollup — a catalog product
/// bought up front, or traffic and meters paid as used.
enum AnalyticsSaleKind {
  package
  usage

  @@schema("billing")
}

/// F-1001-a: sales per tenant day (a flow). Written only by the rollup
/// (`analytics/analytics-rollup.ts`); every analytics read reads this, never a
/// ledger. The grain is a NULLS NOT DISTINCT unique index in the migration.
model AnalyticsSalesDay {
  id           String            @id @default(uuid()) @db.Uuid
  tenantId     String            @db.Uuid
  day          DateTime          @db.Date
  currencyCode String
  productId    String?           @db.Uuid
  variantId    String?           @db.Uuid
  panelId      String?           @db.Uuid
  kind         AnalyticsSaleKind
  gross        Decimal           @db.Decimal(20, 4)
  refunds      Decimal           @db.Decimal(20, 4)
  net          Decimal           @db.Decimal(20, 4)
  orders       Int
  bytesSold    BigInt
  discounts    Decimal           @db.Decimal(20, 4)

  @@map("analytics_sales_day")
  @@schema("billing")
}

/// F-1001-a: per user per tenant day, only users with activity — what
/// distinct buyers are counted from, since distinct counts do not sum. Per
/// product and panel too (F-1001-b); a top-up's row has neither. The grain is
/// a NULLS NOT DISTINCT unique index in the migration.
model AnalyticsUserDay {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  day           DateTime @db.Date
  currencyCode  String
  userId        String   @db.Uuid
  productId     String?  @db.Uuid
  panelId       String?  @db.Uuid
  net           Decimal  @db.Decimal(20, 4)
  orders        Int
  topUps        Decimal  @db.Decimal(20, 4)
  firstPurchase Boolean

  @@index([tenantId, userId])
  @@map("analytics_user_day")
  @@schema("billing")
}

/// F-1001-a: top-up attempts per tenant day and gateway kind (a flow); a null
/// kind holds the coupon and gift credits no gateway carried.
model AnalyticsPaymentDay {
  id            String               @id @default(uuid()) @db.Uuid
  tenantId      String               @db.Uuid
  day           DateTime             @db.Date
  currencyCode  String
  gatewayKind   PaymentProviderName?
  started       Int
  settled       Int
  failed        Int
  settledAmount Decimal              @db.Decimal(20, 4)
  giftsCredited Decimal              @db.Decimal(20, 4)

  @@map("analytics_payment_day")
  @@schema("billing")
}

/// F-1001-a: what stood at the end of a tenant day (a stock, never summed
/// over days) per product and panel.
model AnalyticsStockDay {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  day          DateTime @db.Date
  productId    String?  @db.Uuid
  panelId      String?  @db.Uuid
  activeGrants Int
  frozenGrants Int
  activeUsers  Int
  bytesUsed    BigInt

  @@map("analytics_stock_day")
  @@schema("billing")
}

/// F-1001-n (ADR-0148): use per meter per tenant day (a flow), in the meter's
/// unit. From `billing.usage_event`, except `vpn.traffic`, which comes only
/// from the network's daily aggregate. `panelId` is a VPN Grant's first
/// config's, null for anything else. The grain is a NULLS NOT DISTINCT unique
/// index in the migration.
model AnalyticsMeterDay {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  day       DateTime @db.Date
  productId String?  @db.Uuid
  panelId   String?  @db.Uuid
  meterKey  String
  quantity  BigInt
  grants    Int

  @@map("analytics_meter_day")
  @@schema("billing")
}

/// F-1001-f: where a renewal stands — renewed within the tenant's window,
/// lapsed once it passed without one, pending while it is open.
enum AnalyticsRenewalState {
  renewed
  lapsed
  pending

  @@schema("billing")
}

/// F-1001-f: one ended term of a Grant — its end now, once passed, or an end
/// an admin moved later. `renewedOn` is the nearest renewal within 30 days
/// (the widest window), so a window change re-states rows without a rebuild.
/// Written only by the rollup.
model AnalyticsGrantEnd {
  id        String                @id @default(uuid()) @db.Uuid
  tenantId  String                @db.Uuid
  grantId   String                @db.Uuid
  userId    String                @db.Uuid
  productId String?               @db.Uuid
  panelId   String?               @db.Uuid
  endedOn   DateTime              @db.Date
  renewedOn DateTime?             @db.Date
  state     AnalyticsRenewalState

  @@unique([grantId, endedOn])
  @@index([tenantId, endedOn])
  @@map("analytics_grant_end")
  @@schema("billing")
}

/// F-1001-f: one row per user who signed up, from identity's
/// `identity.user.signed_up` event (never a read of identity's tables) —
/// what signups and signup -> first purchase are counted from.
model AnalyticsSignup {
  userId     String   @id @db.Uuid
  tenantId   String   @db.Uuid
  signedUpAt DateTime
  /// `web`, or the bot platform the phone was proven over.
  source     String

  @@index([tenantId, signedUpAt])
  @@map("analytics_signup")
  @@schema("billing")
}

/// F-1001-f: signups per tenant day and source (a flow), and how many of them
/// bought within 7 and 30 days of signing up.
model AnalyticsSignupDay {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  day         DateTime @db.Date
  source      String
  signups     Int
  purchased7  Int
  purchased30 Int

  @@unique([tenantId, day, source])
  @@map("analytics_signup_day")
  @@schema("billing")
}

/// F-1001-f: a tenant's analytics settings; none = the defaults in code.
/// Changed in place.
model AnalyticsSetting {
  tenantId          String   @id @db.Uuid
  /// Days before or after a term's end a renewal counts in, 1..30 (CHECK in the migration).
  renewalWindowDays Int
  /// F-1003 (ADR-0149 (4)): a user is reported when their 30-day cost passes their net by more than this percent, 0..500 (CHECK).
  lossAlertPercent  Int      @default(20)
  updatedByUserId   String?  @db.Uuid
  updatedAt         DateTime @updatedAt

  @@map("analytics_setting")
  @@schema("billing")
}

/// F-1003: a user reported as costing more than they pay, once per tenant
/// month (`month` = its first day); the claim that keeps a second run silent.
model AnalyticsLossAlert {
  tenantId     String   @db.Uuid
  userId       String   @db.Uuid
  month        DateTime @db.Date
  net          Decimal  @db.Decimal(20, 4)
  cost         Decimal  @db.Decimal(20, 4)
  currencyCode String
  createdAt    DateTime @default(now())

  @@id([tenantId, userId, month])
  @@map("analytics_loss_alert")
  @@schema("billing")
}

/// F-1002-b: what a cost row is — a panel's day split by bytes, a panel's day
/// with no traffic, what a reseller pays the platform per use, its subscription.
enum AnalyticsCostKind {
  panel
  idle
  wholesale
  subscription
  /// F-1002-e (ADR-0151): a sale at its variant's cost; a meter's use at its unit cost.
  sale
  usage
  /// F-1001-t: a general expense, spread over its months' days; no product, panel or user.
  overhead
  /// F-1001-v: a settled payment's provider commission less the fee its payer was charged; no product, panel or user.
  gateway

  @@schema("billing")
}

/// F-1002-b: what each tenant day cost (a flow), per panel, served tenant,
/// product and the tenant's own user — the platform's rows a panel's
/// monthly price split by bytes, a reseller's what it pays the platform.
/// Written only by the rollup (`analytics-rollup-cost.ts`). The grain is a
/// NULLS NOT DISTINCT unique index in the migration.
model AnalyticsCostDay {
  id             String            @id @default(uuid()) @db.Uuid
  tenantId       String            @db.Uuid
  day            DateTime          @db.Date
  kind           AnalyticsCostKind
  panelId        String?           @db.Uuid
  servedTenantId String?           @db.Uuid
  productId      String?           @db.Uuid
  userId         String?           @db.Uuid
  currencyCode   String
  cost           Decimal           @db.Decimal(18, 6)
  bytes          BigInt
  /// F-1001-l (ADR-0149): the tenant's operating currency when the pass ran, and `cost` in it at the day's rate; null = no rate.
  saleCurrencyCode String
  saleCost       Decimal?          @db.Decimal(18, 6)

  @@map("analytics_cost_day")
  @@schema("billing")
}

/// F-1001-t: what a general expense was for — a category the panel names, never free text.
enum GeneralExpenseCategory {
  equipment
  advertising
  staff
  domain
  rent
  other

  @@schema("billing")
}

/// F-1001-t: a cost no panel or product carries, paid by its tenant on
/// `spentOn` (a tenant day) and spread over `months`. History: a trigger
/// refuses an edit; a mistake is taken back (`GeneralExpenseTakeBack`) and
/// added again. Its tenant's only (RLS).
model GeneralExpense {
  id              String                  @id @default(uuid()) @db.Uuid
  tenantId        String                  @db.Uuid
  category        GeneralExpenseCategory
  amount          Decimal                 @db.Decimal(20, 4)
  currencyCode    String
  spentOn         DateTime                @db.Date
  months          Int                     @db.SmallInt
  note            String?
  createdByUserId String?                 @db.Uuid
  createdAt       DateTime                @default(now())
  takeBack        GeneralExpenseTakeBack?

  @@index([tenantId, createdAt])
  @@index([tenantId, spentOn])
  @@map("general_expense")
  @@schema("billing")
}

/// F-1001-v: what a gateway's provider deducts from its merchant — `percent`
/// of what was charged plus `fixedAmount` in the gateway's currency — from
/// `effectiveFrom` (a tenant day) on. Exactly one gateway column (CHECK);
/// `tenantId` the gateway's owner. History: a change is a new row (trigger).
model GatewayCommission {
  id                    String               @id @default(uuid()) @db.Uuid
  tenantId              String               @db.Uuid
  gatewayId             String?              @db.Uuid
  tenantGatewayConfigId String?              @db.Uuid
  percent               Decimal              @db.Decimal(9, 4)
  fixedAmount           Decimal              @db.Decimal(20, 4)
  currencyCode          String
  effectiveFrom         DateTime             @db.Date
  createdByUserId       String?              @db.Uuid
  createdAt             DateTime             @default(now())
  gateway               PaymentGateway?      @relation(fields: [gatewayId], references: [id], onDelete: Restrict)
  tenantGatewayConfig   TenantGatewayConfig? @relation(fields: [tenantGatewayConfigId], references: [id], onDelete: Restrict)

  @@index([gatewayId, effectiveFrom])
  @@index([tenantGatewayConfigId, effectiveFrom])
  @@map("gateway_commission")
  @@schema("billing")
}

/// F-1001-t: an expense that no longer counts, from the day it was paid —
/// one row per expense, never edited.
model GeneralExpenseTakeBack {
  expenseId       String         @id @db.Uuid
  tenantId        String         @db.Uuid
  createdByUserId String?        @db.Uuid
  createdAt       DateTime       @default(now())
  expense         GeneralExpense @relation(fields: [expenseId], references: [id], onDelete: Restrict)

  @@map("general_expense_take_back")
  @@schema("billing")
}

/// F-1005-a: a panel's traffic per UTC date (a flow), every tenant's users,
/// on the rollup of the panel's owner. Written only by the rollup
/// (`analytics-rollup-panels.ts`); the grain is a unique index in the migration.
model AnalyticsPanelTrafficDay {
  id       String   @id @default(uuid()) @db.Uuid
  tenantId String   @db.Uuid
  day      DateTime @db.Date
  panelId  String   @db.Uuid
  bytes    BigInt

  @@map("analytics_panel_traffic_day")
  @@schema("billing")
}

/// F-1005-a: the Grants with a live config on a panel at a UTC date's last
/// pass (a stock — a snapshot, today only), on the rollup of the panel's owner.
model AnalyticsPanelClientsDay {
  id       String   @id @default(uuid()) @db.Uuid
  tenantId String   @db.Uuid
  day      DateTime @db.Date
  panelId  String   @db.Uuid
  clients  Int

  @@map("analytics_panel_clients_day")
  @@schema("billing")
}

/// F-1006-a: how often a scheduled report goes (ADR-0150).
enum AnalyticsReportFrequency {
  daily
  weekly
  monthly

  @@schema("billing")
}

/// F-1006-a: the calendar a report's month is cut in — the reader's, as the page's.
enum AnalyticsReportCalendar {
  jalali
  gregorian

  @@schema("billing")
}

/// F-1006-a: one person's scheduled analytics report (ADR-0150 (3)): the
/// tenant whose figures, the person it goes to — who made it — when (the
/// tenant's hour; a weekly one's weekday, 0 = Sunday), the tab its link
/// opens and its channels. Not derived: a rebuild never touches it.
/// CHECKs in the migration: a weekday only for weekly, an hour 0–23, a channel.
model AnalyticsReportSchedule {
  id         String                   @id @default(uuid()) @db.Uuid
  tenantId   String                   @db.Uuid
  userId     String                   @db.Uuid
  frequency  AnalyticsReportFrequency
  weekday    Int?                     @db.SmallInt
  hour       Int                      @db.SmallInt
  calendar   AnalyticsReportCalendar
  tab        String
  bot        Boolean
  email      Boolean
  pausedAt   DateTime?
  nextRunAt  DateTime
  lastSentAt DateTime?
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @default(now()) @updatedAt

  @@index([tenantId, userId])
  @@map("analytics_report_schedule")
  @@schema("billing")
}

/// F-1001-a: one row per tenant — the zone its rollup days were cut in (a
/// change rebuilds them), the version read caches are keyed by, the last
/// refresh, and a whole rebuild in progress.
model AnalyticsRollupState {
  tenantId        String    @id @db.Uuid
  timeZone        String
  /// The currency the rows were converted into (ADR-0152): the tenant's now, or the next tick rebuilds it. Null: never converted.
  currencyCode    String?
  version         Int       @default(0)
  refreshedAt     DateTime?
  rebuildingSince DateTime?
  /// F-1002-e: a cost written from an earlier day — the next pass restates cost rows from it, then clears it.
  costsFrom       DateTime? @db.Date
  updatedAt       DateTime  @default(now()) @updatedAt

  @@map("analytics_rollup_state")
  @@schema("billing")
}
