// بخش هفت: Schema `billing` — بخش الف: کیف پول و ساب‌اکانت
// =============================================================================
// اصل طلایی: هیچ‌وقت موجودی رو مستقیم UPDATE نکن — همیشه Ledger بساز.

enum LedgerDirection {
  credit
  debit

  @@schema("billing")
}

enum WalletReasonType {
  payment_gateway
  coupon_redemption
  traffic_consumption
  admin_manual_adjust
  affiliate_commission
  sub_account_charge
  wallet_transfer_in
  wallet_transfer_out

  @@schema("billing")
}

enum TransferStatus {
  pending_otp
  confirmed
  cancelled
  expired

  @@schema("billing")
}

enum CouponVisibility {
  public
  targeted

  @@schema("billing")
}

enum RedemptionStatus {
  pending
  confirmed
  expired
  cancelled

  @@schema("billing")
}

enum PaymentProviderName {
  zarinpal
  idpay
  nowpayments
  stripe

  @@schema("billing")
}

enum GatewayCategory {
  domestic_rial
  international_card
  crypto

  @@schema("billing")
}

enum FeeCalcMode {
  manual
  automatic

  @@schema("billing")
}

enum FeeType {
  fixed
  percentage

  @@schema("billing")
}

/// How a gateway's quoted rate is rounded to its `roundingStep` (catalog F-0609).
/// There is deliberately no `down`: rounding a rate down is a loss on every sale.
enum RateRoundingMode {
  up
  nearest

  @@schema("billing")
}

enum ConfirmationMode {
  automatic
  manual_admin_required

  @@schema("billing")
}

enum PaymentStatus {
  pending
  success
  failed
  expired

  @@schema("billing")
}

enum ConfirmationSource {
  webhook_auto
  reconciliation_auto
  admin_manual

  @@schema("billing")
}

enum ReconciliationAction {
  auto_confirmed
  no_action_needed
  flagged_mismatch

  @@schema("billing")
}

enum CryptoAsset {
  USDT
  BTC
  ETH

  @@schema("billing")
}

enum CryptoNetwork {
  TRC20
  ERC20
  BEP20
  Bitcoin

  @@schema("billing")
}

enum CommissionStatus {
  pending
  paid

  @@schema("billing")
}

/// 6.1 — کیف‌پول کاربر؛ cachedBalance فقط Cache است، منبع حقیقت
/// WalletTransaction است.
model Wallet {
  id            String  @id @default(uuid()) @db.Uuid
  ownerUserId   String  @unique @db.Uuid
  cachedBalance Decimal @default(0) @db.Decimal(18, 2)
  version       Int     @default(0) // Optimistic Locking

  owner        User               @relation(fields: [ownerUserId], references: [id])
  transactions WalletTransaction[]
  subAccounts  SubAccount[]

  @@map("wallet")
  @@schema("billing")
}

/// 6.2 — Append-only؛ تاریخچه کامل مثل صورت‌حساب بانکی.
model WalletTransaction {
  id           String            @id @default(uuid()) @db.Uuid
  walletId     String            @db.Uuid
  tenantId     String?           @db.Uuid // denormalized indexed برای گزارش/فیلتر سریع Tenant
  amount       Decimal           @db.Decimal(18, 2) // همیشه مثبت
  direction    LedgerDirection
  reasonType   WalletReasonType
  referenceId  String?           @db.Uuid
  balanceAfter Decimal           @db.Decimal(18, 2)
  createdAt    DateTime          @default(now())

  wallet                Wallet                 @relation(fields: [walletId], references: [id])
  affiliateCommission   AffiliateCommission?
  spinWheelAttempt      SpinWheelAttempt?

  @@index([walletId, createdAt(sort: Desc)])
  @@index([tenantId])
  @@map("wallet_transaction")
  @@schema("billing")
}

/// 6.3 — کیف پول اشتراکی (Sub-account) روی یک Config مشخص.
model SubAccount {
  id              String  @id @default(uuid()) @db.Uuid
  parentWalletId  String  @db.Uuid
  configId        String  @unique @db.Uuid
  label           String
  dataCapBytes    BigInt
  consumedBytes   BigInt  @default(0)
  isActive        Boolean @default(true)

  parentWallet Wallet @relation(fields: [parentWalletId], references: [id])
  config       Config @relation(fields: [configId], references: [id])

  @@map("sub_account")
  @@schema("billing")
}

/// 6.4 — انتقال کیف پول بین کاربران با تأیید OTP (اتمیک).
model WalletTransferRequest {
  id               String         @id @default(uuid()) @db.Uuid
  senderUserId     String         @db.Uuid
  receiverUserId   String         @db.Uuid
  amount           Decimal        @db.Decimal(18, 2)
  note             String?
  status           TransferStatus @default(pending_otp)
  otpCodeHash      String // SENSITIVE — never default-select
  otpExpiresAt     DateTime
  otpAttemptCount  Int            @default(0) // بعد از ۵ تلاش → cancelled
  createdAt        DateTime       @default(now())
  confirmedAt      DateTime?

  @@map("wallet_transfer_request")
  @@schema("billing")
}

/// موتور کوپن — Coupon
model Coupon {
  id                  String            @id @default(uuid()) @db.Uuid
  tenantId            String?           @db.Uuid // null = کوپن سراسری پلتفرم
  code                String            @unique
  discountType        DiscountType
  discountValue       Decimal           @db.Decimal(18, 2)
  maxDiscountCap      Decimal?          @db.Decimal(18, 2) // فقط برای درصدی
  minPurchaseAmount   Decimal?          @db.Decimal(18, 2)
  totalUsageLimit     Int? // null = نامحدود
  perUserUsageLimit   Int               @default(1) // 0 = unlimited
  usedCount           Int               @default(0)
  reservedCount       Int               @default(0)
  expiresAt           DateTime?
  isActive            Boolean           @default(true)
  visibility          CouponVisibility  @default(public)
  createdByAdminId    String            @db.Uuid

  serviceScopes CouponServiceScope[]
  allowedUsers  CouponAllowedUser[]
  redemptions   CouponRedemption[]

  @@map("coupon")
  @@schema("billing")
}

/// اسکوپ کوپن روی یک پلن یا یک دسته؛ نبود رکورد یعنی Open Scope.
model CouponServiceScope {
  id            String  @id @default(uuid()) @db.Uuid
  couponId      String  @db.Uuid
  servicePlanId String? @db.Uuid
  categoryId    String? @db.Uuid

  coupon      Coupon           @relation(fields: [couponId], references: [id])
  servicePlan ServicePlan?     @relation(fields: [servicePlanId], references: [id])
  category    ProductCategory? @relation(fields: [categoryId], references: [id])

  @@map("coupon_service_scope")
  @@schema("billing")
}

/// کوپن هدفمند (visibility=targeted)؛ صدور برای N نفر = N رکورد Bulk Insert.
model CouponAllowedUser {
  id       String @id @default(uuid()) @db.Uuid
  couponId String @db.Uuid
  userId   String @db.Uuid

  coupon Coupon @relation(fields: [couponId], references: [id])

  @@index([couponId, userId])
  @@map("coupon_allowed_user")
  @@schema("billing")
}

/// State Machine دومرحله‌ای آزادسازی کوپن معلق (pending→confirmed/expired/cancelled).
model CouponRedemption {
  id                       String           @id @default(uuid()) @db.Uuid
  couponId                 String           @db.Uuid
  userId                   String           @db.Uuid
  status                   RedemptionStatus @default(pending)
  paymentTransactionId     String?          @db.Uuid
  discountAppliedAmount    Decimal          @db.Decimal(18, 2)
  orderReferenceId         String           @db.Uuid
  redeemedAt               DateTime         @default(now())

  coupon             Coupon              @relation(fields: [couponId], references: [id])
  paymentTransaction PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id])

  // No unique (couponId, userId): perUserUsageLimit may exceed 1 (D-21), so
  // the limit is counted in the redemption transaction, not by an index.
  @@index([couponId, userId])
  @@map("coupon_redemption")
  @@schema("billing")
}

/// 8.1 — تعریف درگاه پرداخت پلتفرم (فقط برای برند خودِ شما،
/// tenantType=platform_owner؛ Resellerها همیشه از tenant.TenantGatewayConfig استفاده می‌کنند).
model PaymentGateway {
  id                  String           @id @default(uuid()) @db.Uuid
  displayName         String
  description         String?
  providerName        PaymentProviderName
  gatewayCategory     GatewayCategory
  supportedCurrencies Json // Array مثل ["USD","EUR"] یا ["USDT","BTC"]
  isActive            Boolean          @default(true)
  merchantId          String // DEPRECATED (D-25): never read — a platform gateway's merchant id is the platform_owner tenant's vault entry
  minAcceptAmount     Decimal          @db.Decimal(18, 2)
  maxAcceptAmount     Decimal          @db.Decimal(18, 2)
  feeCalculationMode  FeeCalcMode
  feeType             FeeType
  feeValue            Decimal          @db.Decimal(18, 4)
  feeFloor            Decimal?         @db.Decimal(18, 2)
  feeCeiling          Decimal?         @db.Decimal(18, 2)
  // Rate from base currency to what the gateway charges in (F-0609). The same
  // columns sit on tenant.TenantGatewayConfig; one calculator reads both.
  useLiveRate         Boolean          @default(true)
  staticRate          Decimal?         @db.Decimal(18, 8)
  percentageModifier  Decimal          @default(0) @db.Decimal(9, 4) // + = markup
  fixedAmountModifier Decimal          @default(0) @db.Decimal(18, 8)
  minRate             Decimal?         @db.Decimal(18, 8)
  maxRate             Decimal?         @db.Decimal(18, 8)
  roundingStep        Decimal?         @db.Decimal(18, 8)
  roundingMode        RateRoundingMode @default(up)
  confirmationMode    ConfirmationMode @default(automatic)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  transactions PaymentTransaction[]
  /// Grants of this gateway to tenants that do not own it (ADR-0041, F-096-a).
  grants       PaymentGatewayGrant[]

  @@map("payment_gateway")
  @@schema("billing")
}

/// 8.2 — تراکنش پرداخت با دو خط دفاعی تأیید (Webhook + Reconciliation)
/// به‌علاوه Fallback تأیید دستی ادمین.
model PaymentTransaction {
  id                    String              @id @default(uuid()) @db.Uuid
  tenantId              String?             @db.Uuid // denormalized indexed
  userId                String              @db.Uuid
  // Exactly one of the two gateway columns is set — the platform brand's or a
  // reseller's own (ADR-0006). A CHECK in 20260911000000_payment_legacy_port
  // enforces it; Prisma cannot express it.
  gatewayId             String?             @db.Uuid
  tenantGatewayConfigId String?             @db.Uuid
  amountRequested       Decimal             @db.Decimal(18, 2) // base, before coupons
  feeApplied            Decimal             @db.Decimal(18, 2)
  discountApplied       Decimal             @default(0) @db.Decimal(18, 2) // every coupon together
  amountCredited        Decimal             @db.Decimal(18, 2) // base + adjustment gap
  // What the gateway is asked to charge, in its own currency's minor unit, and
  // the base->that-currency rate that produced it (ADR-0019). Frozen at intent.
  chargedAmountMinor    BigInt
  exchangeRateSnapshot  Decimal?            @db.Decimal(18, 8)
  // Which rate that was: the `currency_exchange_rate` row the number was read
  // from (F-0606-b, ADR-0019). The FX worker appends a row every accepted poll,
  // so the rate alone does not say which reading priced this payment. NULL on a
  // gateway that priced from its own `staticRate`, and before F-092-c.
  exchangeRateSnapshotId String?            @db.Uuid
  status                PaymentStatus       @default(pending)
  gatewayTrackingCode   String? // the id a duplicate callback shares — Zarinpal `authority` (ADR-0028)
  gatewayReferenceId    String? // the receipt number of a paid payment — Zarinpal `ref_id`
  cardPanMasked         String?
  failureCode           String?
  confirmationSource    ConfirmationSource?
  confirmedByAdminId    String?             @db.Uuid
  /// The grant this payment was taken under (ADR-0041, F-096-a). NULL is the
  /// ordinary case: the tenant used a gateway it owns. Non-null means the money
  /// landed in somebody else's merchant account and this tenant is owed it.
  grantId               String?             @db.Uuid
  manualConfirmReason   String? // اجباری در سطح اپلیکیشن اگر confirmationSource=admin_manual
  createdAt             DateTime            @default(now())
  expiresAt             DateTime? // معمولاً now()+15min

  // Restrict, not the optional-relation default SetNull: a payment is a
  // permanent record, and nulling its gateway would also break the CHECK.
  gateway                 PaymentGateway?           @relation(fields: [gatewayId], references: [id], onDelete: Restrict)
  // Restrict for the same reason as the gateway: the snapshot is the evidence
  // the payment was priced correctly, and the rate table is append-only anyway.
  exchangeRateSnapshotRow CurrencyExchangeRate?     @relation(fields: [exchangeRateSnapshotId], references: [id], onDelete: Restrict)
  tenantGatewayConfig     TenantGatewayConfig?      @relation(fields: [tenantGatewayConfigId], references: [id], onDelete: Restrict)
  grant                   PaymentGatewayGrant?      @relation(fields: [grantId], references: [id], onDelete: Restrict)
  settlementEntry         GatewaySettlementEntry?
  couponRedemptions       CouponRedemption[]
  reconciliationLogs      PaymentReconciliationLog[]
  cryptoDetail            CryptoPaymentDetail?
  affiliateCommissions    AffiliateCommission[]

  // ADR-0028, once per gateway column. NULLs never collide, so a pending row
  // with no code yet, or a row on the other column, is outside each key.
  @@unique([gatewayId, gatewayTrackingCode])
  @@unique([tenantGatewayConfigId, gatewayTrackingCode])
  @@index([tenantId])
  @@index([status, expiresAt])
  @@map("payment_transaction")
  @@schema("billing")
}

/// 8.3 — خط دوم دفاع: Reconciliation Worker (Inquiry API خودِ درگاه).
model PaymentReconciliationLog {
  id                    String               @id @default(uuid()) @db.Uuid
  paymentTransactionId  String               @db.Uuid
  checkedAt             DateTime             @default(now())
  gatewayReportedStatus String // پاسخ خام Inquiry API درگاه
  actionTaken           ReconciliationAction
  notes                 String?

  paymentTransaction PaymentTransaction @relation(fields: [paymentTransactionId], references: [id])

  @@map("payment_reconciliation_log")
  @@schema("billing")
}

/// 8.4 — جزئیات پرداخت کریپتو؛ exchangeRateSnapshot هرگز بعداً بر اساس
/// نرخ روز حساب نمی‌شود.
model CryptoPaymentDetail {
  id                       String        @id @default(uuid()) @db.Uuid
  paymentTransactionId     String        @unique @db.Uuid
  cryptoAsset              CryptoAsset
  network                  CryptoNetwork
  depositAddress           String
  requiredConfirmations    Int
  receivedConfirmations    Int           @default(0)
  exchangeRateSnapshot     Decimal       @db.Decimal(18, 8)
  txHash                   String?

  paymentTransaction PaymentTransaction @relation(fields: [paymentTransactionId], references: [id])

  @@map("crypto_payment_detail")
  @@schema("billing")
}

/// 8.5 — سیستم Affiliate؛ جدا از User.referredByUserId چون باید تاریخچه
/// کامل واریزها را با وضعیت جدا نگه دارد.
model AffiliateReferral {
  id               String   @id @default(uuid()) @db.Uuid
  referrerUserId   String   @db.Uuid
  referredUserId   String   @db.Uuid
  signedUpAt       DateTime @default(now())

  commissions AffiliateCommission[]

  @@map("affiliate_referral")
  @@schema("billing")
}

model AffiliateCommission {
  id                       String            @id @default(uuid()) @db.Uuid
  referralId               String            @db.Uuid
  triggeringPaymentId      String            @db.Uuid
  commissionAmount         Decimal           @db.Decimal(18, 2)
  status                   CommissionStatus  @default(pending)
  payoutWalletTransactionId String?          @unique @db.Uuid

  referral            AffiliateReferral   @relation(fields: [referralId], references: [id])
  triggeringPayment   PaymentTransaction  @relation(fields: [triggeringPaymentId], references: [id])
  payoutTransaction   WalletTransaction?  @relation(fields: [payoutWalletTransactionId], references: [id])

  @@map("affiliate_commission")
  @@schema("billing")
}

// =============================================================================

// =============================================================================
// 8.5 — Granted gateways and what they collect (ADR-0041, F-096-a)
// =============================================================================

/// ADR-0041 — یک tenant می‌تواند از درگاهی که مالکش نیست استفاده کند، فقط با
/// اعطای صریح مالک پلتفرم. Schema only for now: no service reads it (F-096-b).
///
/// `tenantId` is the **borrowing** tenant — the one the grant is *to*. It
/// carries that name and not `granteeTenantId` because it is the column RLS
/// and `withTenant` key on, and a grant is exactly the borrower's to see.
/// Which tenant *owns* the gateway is the gateway row's business, not this one's.
model PaymentGatewayGrant {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @db.Uuid
  // Exactly one of the two, like `payment_transaction`: the platform's own
  // gateway or another reseller's. A CHECK enforces it (Prisma cannot).
  gatewayId             String?   @db.Uuid
  tenantGatewayConfigId String?   @db.Uuid
  grantedByAdminId      String    @db.Uuid
  /// Withdrawn, not deleted: a payment that was taken through this grant keeps
  /// pointing at it, and what was owed stays explicable (ADR-0041 §6).
  isActive              Boolean   @default(true)
  grantedAt             DateTime  @default(now())
  withdrawnAt           DateTime?
  withdrawnByAdminId    String?   @db.Uuid
  note                  String?

  // Restrict, like `payment_transaction`'s: a grant is a record, and nulling
  // its gateway would break the CHECK as well as the story.
  gateway             PaymentGateway?      @relation(fields: [gatewayId], references: [id], onDelete: Restrict)
  tenantGatewayConfig TenantGatewayConfig? @relation(fields: [tenantGatewayConfigId], references: [id], onDelete: Restrict)
  payments            PaymentTransaction[]
  settlementEntries   GatewaySettlementEntry[]

  @@index([tenantId, isActive])
  @@map("payment_gateway_grant")
  @@schema("billing")
}

/// ADR-0041 §4 — بدهی پلتفرم به tenant قرض‌گیرنده: هر پرداخت موفق از درگاه
/// اعطاشده، مبلغ واریزشده (منهای کارمزد درگاه) را اینجا انباشته می‌کند.
/// Append-only, one row per payment, written inside the crediting transaction.
model GatewaySettlementEntry {
  id                   String   @id @default(uuid()) @db.Uuid
  grantId              String   @db.Uuid
  /// The tenant that is **owed** — the borrower whose user was credited.
  tenantId             String   @db.Uuid
  /// One accrual per payment, so a retried callback cannot accrue twice.
  paymentTransactionId String   @unique @db.Uuid
  /// Base currency (ADR-0019, C-02). `amountCredited` net of the gateway fee.
  amount               Decimal  @db.Decimal(18, 2)
  accruedAt            DateTime @default(now())

  grant              PaymentGatewayGrant @relation(fields: [grantId], references: [id])
  paymentTransaction PaymentTransaction  @relation(fields: [paymentTransactionId], references: [id])

  @@index([tenantId, accruedAt(sort: Desc)])
  @@map("gateway_settlement_entry")
  @@schema("billing")
}

/// ADR-0041 §5 — تسویه، یک پرداخت دستیِ ثبت‌شده است؛ هرگز خودکار نیست.
/// اپراتور پول را بیرون از سیستم منتقل می‌کند و اینجا با سند و هویت خودش ثبت.
model GatewaySettlementPayout {
  id                String   @id @default(uuid()) @db.Uuid
  /// The tenant that was paid.
  tenantId          String   @db.Uuid
  /// Base currency (ADR-0019, C-02). What is still owed is the accruals minus these.
  amount            Decimal  @db.Decimal(18, 2)
  paidAt            DateTime @default(now())
  /// Never null in practice: a payout is a person's act and is attributed (ADR-0041 §5).
  recordedByAdminId String   @db.Uuid
  /// Free text: "bank transfer", "sheba", a gateway's own payout id.
  method            String?
  reference         String?
  /// The transfer's proof. A **key**, not a URL: the object store is D-8's port
  /// and lands with F-033, so nothing resolves this yet (F-096-e).
  proofAttachmentKey String?
  notes             String?

  @@index([tenantId, paidAt(sort: Desc)])
  @@map("gateway_settlement_payout")
  @@schema("billing")
}
