// Schema `catalog` — what is for sale (F-026-a, D-34, ADR-0049).
// Spec: `tools/spec.py --section 4.1` .. `4.3`, F-501, F-0601, F-0602.
// =============================================================================

/// How a sold variant is fulfilled (§4.1). A new product type is a new kind and
/// a handler — never a new billing table.
enum FulfilmentKind {
  network_access
  external_order
  feature_access
  wallet_topup

  @@schema("catalog")
}

/// §4.2: `public` is listed; `unlisted` is sold by a direct link only;
/// `admin_only` is never sold, only assigned by an admin (F-506).
enum VariantVisibility {
  public
  unlisted
  admin_only

  @@schema("catalog")
}

/// §4.4: paid up front, or metered against a billing cursor.
enum VariantBillingMode {
  prepaid
  metered

  @@schema("catalog")
}

/// F-408: a node quality tier with its own price multiplier.
enum QualityTier {
  standard
  premium

  @@schema("catalog")
}

enum DiscountType {
  percentage
  fixed_amount
  wallet_credit // a gift code: redeemed straight into the wallet (D-21, F-092-m)
  free_grant // a free service: redeemed into a Grant of `coupon.grantVariantId` (F-502-l, D-35)

  @@schema("catalog")
}

/// A group of products (`vpn`, `followers`, ...). `tenantId` null = the
/// platform's, read by every tenant; a set one is that tenant's own. The key is
/// unique inside a tenant (a partial index in the migration).
model ProductCategory {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @db.Uuid
  key       String
  /// An i18n key, not text (§4.3).
  nameKey   String
  /// The language the admin wrote the name in, and a reader's fallback
  /// (F-1533-f, ADR-0050 amendment 2). Null = DEFAULT_LANGUAGE (older rows).
  sourceLang String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  products Product[]

  @@index([tenantId])
  @@map("product_category")
  @@schema("catalog")
}

/// The marketing object (§4.2). Name and description are i18n keys (§4.3).
model Product {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String?        @db.Uuid
  categoryId     String         @db.Uuid
  key            String
  nameKey        String
  descriptionKey String?
  /// The language name and description were written in; a reader's fallback
  /// (F-1533-f). Null = DEFAULT_LANGUAGE (older rows).
  sourceLang     String?
  fulfilmentKind FulfilmentKind
  /// What a Grant of this product unlocks (§4.4).
  featureKeys    String[]       @default([])
  /// Quotas a new variant starts from, by metric (§4.5).
  defaultQuotas  Json           @default("{}")
  isActive       Boolean        @default(true)
  /// Set when a removal found it referenced and kept it (F-026-h): out of the
  /// list and never sold, every Grant of it untouched. A product nothing
  /// referenced is deleted instead.
  archivedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now()) @updatedAt

  category            ProductCategory      @relation(fields: [categoryId], references: [id])
  variants            ProductVariant[]
  couponServiceScopes CouponServiceScope[]

  @@index([tenantId])
  @@index([categoryId])
  @@map("product")
  @@schema("catalog")
}

/// The sellable unit, a SKU (§4.2). `tenantId` is its product's — a trigger
/// holds it — so RLS reads it without a join. The SKU is unique inside a tenant.
model ProductVariant {
  id           String             @id @default(uuid()) @db.Uuid
  tenantId     String?            @db.Uuid
  productId    String             @db.Uuid
  sku          String
  /// Optional wording of its own; the product's name otherwise.
  nameKey      String?
  /// Quota per metric (§4.5), e.g. `{"traffic_bytes": {"limit": 53687091200, "resetPolicy": "none"}}`.
  quotas       Json               @default("{}")
  /// Null = permanent.
  durationDays Int?
  billingMode  VariantBillingMode
  visibility   VariantVisibility
  /// Where a `network_access` Grant is provisioned (§7.3). The platform's
  /// groups serve anyone's variants, a tenant's only its own (a trigger).
  panelGroupId String?            @db.Uuid
  qualityTier  QualityTier        @default(standard)
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @default(now()) @updatedAt

  product             Product              @relation(fields: [productId], references: [id])
  panelGroup          PanelGroup?          @relation(fields: [panelGroupId], references: [id], onDelete: Restrict)
  prices              Price[]
  meteredRates        MeteredRate[]
  couponServiceScopes CouponServiceScope[]
  grants              Grant[]
  grantingCoupons     Coupon[]
  invoices            Invoice[]

  @@index([tenantId])
  @@index([productId])
  @@map("product_variant")
  @@schema("catalog")
}

/// A variant's price in USD (ADR-0019, C-02) from `effectiveFrom` on. History:
/// a change is a new row, and a trigger refuses any update but `isActive` and
/// any delete (F-0602) — yesterday's invoice is computed at yesterday's price.
/// The one exception is its variant's own delete, which cascades (F-026-h):
/// a variant is deletable only while nothing references it.
model Price {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String?  @db.Uuid
  variantId        String   @db.Uuid
  amount           Decimal  @db.Decimal(18, 2)
  effectiveFrom    DateTime
  isActive         Boolean  @default(true)
  createdByAdminId String?  @db.Uuid
  createdAt        DateTime @default(now())

  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([variantId, effectiveFrom(sort: Desc)])
  @@index([tenantId])
  @@map("price")
  @@schema("catalog")
}

/// What a `metered` variant charges per 2^30 bytes (ADR-0073, F-027-g), in the
/// same USD as `Price` but at the precision a rate needs — `(18, 8)`, as
/// `tenant_usage_meter.unitPrice` and `currency_exchange_rate.rate` already
/// are. `C-02` governs amounts, and every amount derived from this rate is
/// rounded to whole cents before the ledger sees it (ADR-0072).
///
/// History, exactly as `Price` is: a change is a new row, and a trigger refuses
/// any update but `isActive` and any delete. `GrantService.issue` copies the
/// rate in effect onto `Grant.meteredRate` (F-027-p), so a catalog edit
/// tomorrow never reprices bytes already sold — or, under ADR-0072, blocks
/// already bought.
model MeteredRate {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String?  @db.Uuid
  variantId        String   @db.Uuid
  /// Money per `METERED_RATE_UNIT_BYTES` (shared-core). Bytes are the only
  /// stored unit; "GB" is a rendering concern. Strictly positive
  /// (`metered_rate_is_positive`, F-027-al): a block priced at zero cents is
  /// one nobody can buy, so a rate of zero stalls the user rather than
  /// serving free traffic. Free metered service is a quota with no rate.
  rate             Decimal  @db.Decimal(18, 8)
  effectiveFrom    DateTime
  isActive         Boolean  @default(true)
  createdByAdminId String?  @db.Uuid
  createdAt        DateTime @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, effectiveFrom(sort: Desc)])
  @@index([tenantId])
  @@map("metered_rate")
  @@schema("catalog")
}

