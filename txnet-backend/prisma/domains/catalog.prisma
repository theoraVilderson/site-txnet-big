// Schema `catalog` — what is for sale (F-026-a, D-34, ADR-0049).
// Spec: `tools/spec.py --section 4.1` .. `4.3`, F-501, F-0601, F-0602.
// =============================================================================

/// How a sold variant is fulfilled (§4.1). A new product type is a new kind and
/// a handler — never a new billing table.
enum FulfilmentKind {
  network_access
  external_order
  feature_access
  wallet_topup

  @@schema("catalog")
}

/// §4.2: `public` is listed; `unlisted` is sold by a direct link only;
/// `admin_only` is never sold, only assigned by an admin (F-506).
enum VariantVisibility {
  public
  unlisted
  admin_only

  @@schema("catalog")
}

/// §4.4: paid up front, or metered against a billing cursor.
enum VariantBillingMode {
  prepaid
  metered

  @@schema("catalog")
}

/// F-408: a node quality tier with its own price multiplier.
enum QualityTier {
  standard
  premium

  @@schema("catalog")
}

enum DiscountType {
  percentage
  fixed_amount
  wallet_credit // a gift code: redeemed straight into the wallet (D-21, F-092-m)
  free_grant // a free service: redeemed into a Grant of `coupon.grantVariantId` (F-502-l, D-35)

  @@schema("catalog")
}

/// A group of products (`vpn`, `followers`, ...). `tenantId` null = the
/// platform's, read by every tenant; a set one is that tenant's own. The key is
/// unique inside a tenant (a partial index in the migration).
model ProductCategory {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @db.Uuid
  /// The category this one sits under; null = a top-level one (F-026-q). The
  /// platform's or its own tenant's, never a descendant of itself (triggers).
  parentId  String?  @db.Uuid
  key       String
  /// An i18n key, not text (§4.3).
  nameKey   String
  /// The language the admin wrote the name in, and a reader's fallback
  /// (F-1533-f, ADR-0050 amendment 2). Null = DEFAULT_LANGUAGE (older rows).
  sourceLang String?
  isActive  Boolean  @default(true)
  /// Set when a removal with its products kept it for a sold product still
  /// in it (F-026-l): out of the list, nothing new filed in it.
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  parent   ProductCategory?      @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children ProductCategory[]     @relation("CategoryTree")
  products ProductCategoryLink[]
  discountRules DiscountRule[]

  @@index([tenantId])
  @@index([parentId])
  @@map("product_category")
  @@schema("catalog")
}

/// Something a Grant of a product unlocks (F-114-f-a, ADR-0086): a product's
/// `featureKeys` may name only a row its tenant can see — the platform's
/// (`tenantId` null, seen by every tenant) or its own. The key is unique among
/// what one tenant sees and never changes: products and Grants hold it as a
/// string. The name is text in `catalog-texts` (kind `capability`).
model ProductCapability {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String?  @db.Uuid
  /// `vpn.access`. Immutable.
  key            String
  nameKey        String
  descriptionKey String?
  /// The language the name was written in; null = DEFAULT_LANGUAGE (a row the
  /// migration wrote from a key already in use, named after the key).
  sourceLang     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@index([tenantId])
  @@map("product_capability")
  @@schema("catalog")
}

/// What a meter counts (F-118-c, ADR-0105). `METER_UNITS` in shared-core
/// mirrors it; a rate card's `unitSize` is in this unit.
enum MeterUnit {
  bytes
  count
  seconds
  tokens

  @@schema("catalog")
}

/// What is counted and billed on use (F-118-c, ADR-0105 decision 2): the
/// registry a rate card prices. Platform rows only, shaped like
/// `ProductCapability` (ADR-0086) but with no tenant: a meter exists only where
/// code reports it, so a migration writes it and no service role may insert,
/// update or delete one. `key` and `unit` never change (`meter_is_immutable`):
/// rate cards and Grants hold them. Keys in code: `METER_KEYS` (shared-core).
model Meter {
  id             String    @id @default(uuid()) @db.Uuid
  /// `vpn.traffic`. Immutable.
  key            String    @unique
  /// Immutable.
  unit           MeterUnit
  /// The service whose code reports this meter's usage, e.g. `network-service`.
  reportedBy     String
  /// `catalog.meter.<key>.name` in the `catalog` namespace (ADR-0050).
  nameKey        String
  descriptionKey String?
  createdAt      DateTime  @default(now())

  rateCards   RateCard[]
  grantMeters GrantMeter[]

  @@map("meter")
  @@schema("catalog")
}

/// The marketing object (§4.2). Name and description are i18n keys (§4.3).
model Product {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String?        @db.Uuid
  key            String
  nameKey        String
  descriptionKey String?
  /// The language name and description were written in; a reader's fallback
  /// (F-1533-f). Null = DEFAULT_LANGUAGE (older rows).
  sourceLang     String?
  fulfilmentKind FulfilmentKind
  /// What a Grant of this product unlocks (§4.4): keys of `ProductCapability`
  /// rows its tenant can see (F-114-f-a).
  featureKeys    String[]       @default([])
  /// Quotas a new variant starts from, by metric (§4.5).
  defaultQuotas  Json           @default("{}")
  isActive       Boolean        @default(true)
  /// Set when a removal found it referenced and kept it (F-026-h): out of the
  /// list and never sold, every Grant of it untouched. A product nothing
  /// referenced is deleted instead.
  archivedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now()) @updatedAt

  /// The categories it is filed in, one or more (F-026-q); `position` orders them.
  categories          ProductCategoryLink[]
  variants            ProductVariant[]
  couponServiceScopes CouponServiceScope[]
  discountRules       DiscountRule[]

  @@index([tenantId])
  @@map("product")
  @@schema("catalog")
}

/// A product filed in a category (F-026-q). `tenantId` is the product's — a
/// trigger holds it, and that the category is the platform's or that tenant's —
/// so RLS reads it without a join. The category side is RESTRICT: a category
/// any product sits in is kept (`has_products`).
model ProductCategoryLink {
  productId  String   @db.Uuid
  categoryId String   @db.Uuid
  tenantId   String?  @db.Uuid
  /// The product's own order of its categories; 0 is shown first.
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  category ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@index([tenantId])
  @@map("product_category_link")
  @@schema("catalog")
}

/// The sellable unit, a SKU (§4.2). `tenantId` is its product's — a trigger
/// holds it — so RLS reads it without a join. The SKU is unique inside a tenant.
model ProductVariant {
  id           String             @id @default(uuid()) @db.Uuid
  tenantId     String?            @db.Uuid
  productId    String             @db.Uuid
  sku          String
  /// Optional wording of its own; the product's name otherwise.
  nameKey      String?
  /// Quota per metric (§4.5), e.g. `{"traffic_bytes": {"limit": 53687091200, "resetPolicy": "none"}}`.
  quotas       Json               @default("{}")
  /// Null = permanent.
  durationDays Int?
  billingMode  VariantBillingMode
  visibility   VariantVisibility
  /// Where a `network_access` Grant is provisioned (§7.3). The platform's
  /// groups serve anyone's variants, a tenant's only its own (a trigger).
  panelGroupId String?            @db.Uuid
  qualityTier  QualityTier        @default(standard)
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @default(now()) @updatedAt

  product             Product              @relation(fields: [productId], references: [id])
  panelGroup          PanelGroup?          @relation(fields: [panelGroupId], references: [id], onDelete: Restrict)
  prices              Price[]
  meteredRates        MeteredRate[]
  rateCards           RateCard[]
  couponServiceScopes CouponServiceScope[]
  grants              Grant[]
  grantingCoupons     Coupon[]
  invoices            Invoice[]

  @@index([tenantId])
  @@index([productId])
  @@map("product_variant")
  @@schema("catalog")
}

/// A variant's price in its `currencyCode` (ADR-0098, C-02) from `effectiveFrom` on. History:
/// a change is a new row, and a trigger refuses any update but `isActive` and
/// any delete (F-0602) — yesterday's invoice is computed at yesterday's price.
/// The one exception is its variant's own delete, which cascades (F-026-h):
/// a variant is deletable only while nothing references it.
model Price {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String?  @db.Uuid
  variantId        String   @db.Uuid
  amount           Decimal  @db.Decimal(18, 2)
  /// The currency `amount` is in (F-116-d, ADR-0098): the tenant's operating
  /// currency when written — the platform's for a platform row. A reader
  /// takes only the rows in its tenant's currency; no default (C-02).
  currencyCode     String
  effectiveFrom    DateTime
  isActive         Boolean  @default(true)
  createdByAdminId String?  @db.Uuid
  createdAt        DateTime @default(now())

  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([variantId, effectiveFrom(sort: Desc)])
  @@index([tenantId])
  @@map("price")
  @@schema("catalog")
}

/// Whether a rate card's usage is paid before it is served or held and
/// captured as it is (F-118-d, ADR-0105 decisions 1 and 6). The seller picks it
/// per meter.
enum RateCardMode {
  prepaid
  postpaid

  @@schema("catalog")
}

/// What happens past a card's `includedQuantity`: `stop` serves no more,
/// `metered` charges each further unit at `unitPrice` (ADR-0105 decision 3).
enum RateCardAfterIncluded {
  stop
  metered

  @@schema("catalog")
}

/// What a variant charges for one meter (F-118-d, ADR-0105 decision 3):
/// `unitPrice` per `unitSize` of the meter's unit, in `currencyCode` — the
/// tenant's operating currency when written (ADR-0098) — at the precision a
/// rate needs, `(18, 8)`. Every amount derived from it is rounded to whole
/// minor units before the ledger sees it (C-02).
///
/// `includedQuantity` comes with the plan's price; past it, `afterIncluded`
/// says whether the meter stops or charges. So one row sells per-GB VPN
/// (0 included, then metered) and a hybrid (50 GB with the plan, then per GB).
///
/// History, exactly as `Price` is: a change is a new row, and a trigger refuses
/// any update but `isActive` and any delete but its variant's. A tenant writes
/// cards on its own variants only (RLS, `same_tenant_as_parent`). Replaces
/// `MeteredRate`: its rows became `vpn.traffic` prepaid cards.
model RateCard {
  id               String                @id @default(uuid()) @db.Uuid
  tenantId         String?               @db.Uuid
  variantId        String                @db.Uuid
  /// A `Meter.key` (`METER_KEYS`).
  meterKey         String
  /// How many of the meter's unit one `unitPrice` buys — 2^30 for a GiB of bytes.
  unitSize         BigInt
  unitPrice        Decimal               @db.Decimal(18, 8)
  /// On the same terms as `Price.currencyCode` (F-116-d).
  currencyCode     String
  mode             RateCardMode
  /// In the meter's unit, paid with the plan. 0 = nothing included.
  includedQuantity BigInt                @default(0)
  afterIncluded    RateCardAfterIncluded
  effectiveFrom    DateTime
  isActive         Boolean               @default(true)
  createdByAdminId String?               @db.Uuid
  createdAt        DateTime              @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  meter   Meter          @relation(fields: [meterKey], references: [key], onDelete: Restrict, onUpdate: Restrict)

  @@index([variantId, meterKey, effectiveFrom(sort: Desc)])
  @@index([tenantId])
  @@map("rate_card")
  @@schema("catalog")
}

/// Retired by F-118-d: its rows are `vpn.traffic` cards in `RateCard`, nothing
/// reads it, and no service role may write it. Dropped with F-118-l.
///
/// What a `metered` variant charges per 2^30 bytes (ADR-0073, F-027-g), in the
/// same currency as `Price` but at the precision a rate needs — `(18, 8)`, as
/// `tenant_usage_meter.unitPrice` and `currency_exchange_rate.rate` already
/// are. `C-02` governs amounts, and every amount derived from this rate is
/// rounded to whole cents before the ledger sees it (ADR-0072).
///
/// History, exactly as `Price` is: a change is a new row, and a trigger refuses
/// any update but `isActive` and any delete. `GrantService.issue` copies the
/// rate in effect onto `Grant.meteredRate` (F-027-p), so a catalog edit
/// tomorrow never reprices bytes already sold — or, under ADR-0072, blocks
/// already bought.
model MeteredRate {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String?  @db.Uuid
  variantId        String   @db.Uuid
  /// Money per `METERED_RATE_UNIT_BYTES` (shared-core). Bytes are the only
  /// stored unit; "GB" is a rendering concern. Strictly positive
  /// (`metered_rate_is_positive`, F-027-al): a block priced at zero cents is
  /// one nobody can buy, so a rate of zero stalls the user rather than
  /// serving free traffic. Free metered service is a quota with no rate.
  rate             Decimal  @db.Decimal(18, 8)
  /// The currency `rate` is in, on the same terms as `Price.currencyCode` (F-116-d).
  currencyCode     String
  effectiveFrom    DateTime
  isActive         Boolean  @default(true)
  createdByAdminId String?  @db.Uuid
  createdAt        DateTime @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, effectiveFrom(sort: Desc)])
  @@index([tenantId])
  @@map("metered_rate")
  @@schema("catalog")
}

// =============================================================================
