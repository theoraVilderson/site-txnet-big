// بخش دو: Schema `tenant` — هسته چندمستأجری و White-Label فروشندگان (Reseller)
// =============================================================================
// تصمیم قطعی مالی: پول مشتریان Tenant هرگز از درگاه پلتفرم عبور نمی‌کند؛ هر
// Tenant موظف است درگاه پرداخت مستقل خودش را متصل کند (TenantGatewayConfig).
// بنابراین هیچ کیف‌پول درآمدی/تسویه‌حساب معکوس (Tenant<-Platform) وجود ندارد.

enum TenantType {
  platform_owner
  reseller

  @@schema("tenant")
}

enum TenantStatus {
  trial
  active
  suspended
  terminated

  @@schema("tenant")
}

/// F-019-c. Why a tenant is `suspended`: by the platform owner's hand, or by a
/// renewal its billing wallet could not pay. Only `non_payment` is lifted by a payment.
enum TenantSuspensionCause {
  manual
  non_payment

  @@schema("tenant")
}

enum TenantBillingModel {
  subscription_monthly
  subscription_yearly
  pay_as_you_go_metered

  @@schema("tenant")
}

enum TenantDomainType {
  subdomain
  custom_domain

  @@schema("tenant")
}

/// What a domain is for (catalog 13.1 / C-16). A tenant holds several at once,
/// and the roles never collapse onto one host: the panel is served on a `panel`
/// domain, subscription links on a `subscription` one. Resolution treats all of
/// them alike — every purpose names the same tenant — but what may be *served*
/// on each differs, which is what `surfaceServesPath` enforces (F-066-q).
///
/// `state` / `tlsStatus` / the health columns of that catalog block are F-102
/// and F-113 and are deliberately not here: this column is the one F-1212 needs.
enum TenantDomainPurpose {
  panel
  subscription
  assets

  @@schema("tenant")
}

enum DomainVerificationStatus {
  pending
  /// The tenant says its TXT record is in place; the sweep checks it until it
  /// passes or the window closes (F-018-i). Does not route.
  verifying
  verified
  failed

  @@schema("tenant")
}

enum EntitlementSource {
  package_included
  addon_purchased
  admin_granted

  @@schema("tenant")
}

enum TenantLedgerDirection {
  credit
  debit

  @@schema("tenant")
}

enum TenantBillingReasonType {
  topup_payment
  subscription_charge
  metered_usage_charge
  /// F-118-h: wholesale units bought on a per-use door and not used, given back; `referenceId` = the `usage_authorization`.
  metered_usage_refund
  sms_usage_charge
  admin_manual_adjust
  /// F-019-h: the buyer's payment for the first period lands here before it is charged; `referenceId` = the tenant id.
  reseller_purchase
  /// F-116-f: the platform's currency changed; a closing and an opening row, `referenceId` = the `billing.currency_change`.
  currency_change
  /// F-019-v2 (ADR-0107 point 5): units sold past a quota, prepaid at the act; `referenceId` = the `reseller_quota_usage` row.
  quota_overage_charge
  /// F-019-v2 (ADR-0107 point 10): an overage charge given back when its act is cancelled; `referenceId` = the same usage row.
  quota_overage_refund

  @@schema("tenant")
}

enum TenantMeterKey {
  active_configs_count
  sms_sent
  ai_recommendation_calls
  custom_bot_messages
  storage_gb

  @@schema("tenant")
}

enum TenantGatewayVerificationStatus {
  pending_test_transaction
  verified
  failed

  @@schema("tenant")
}

enum TenantSmsMode {
  use_platform_sms
  own_credentials

  @@schema("tenant")
}

/// ۱. جدول Tenant — دقیقاً یک رکورد باید tenantType=platform_owner باشد
/// (اجرا با CHECK/Trigger در بخش ۹۹؛ همان الگوی Currency.isBaseCurrency).
model Tenant {
  id              String             @id @default(uuid()) @db.Uuid
  tenantType      TenantType
  ownerUserId     String             @db.Uuid
  slug            String             @unique // names the CNAME target `<slug>.edge.<domain>` (ADR-0063)
  status          TenantStatus       @default(trial)
  billingModel    TenantBillingModel
  suspendedReason String?
  /// F-018-f. When the tenant was last suspended; null unless `suspended` (or terminated from it).
  suspendedAt     DateTime?
  /// F-018-f. `/sub` is served until this instant while suspended (`suspensionHoldDays` after `suspendedAt`).
  graceEndsAt     DateTime?
  /// F-019-c. Set while `suspended`; null otherwise. A payment lifts only `non_payment`.
  suspensionCause TenantSuspensionCause?
  /// F-027-f, ADR-0075. Days a suspended Grant's configs stay on their panels
  /// before they are purged and the seats released. `0` = never. Read as it is
  /// now, so shortening it applies to the Grants already waiting.
  purgeAfterDays  Int                    @default(7)
  /// F-118-x: days after the purge before a suspended Grant is closed (`expired`),
  /// its remainder and wholesale given back. `0` = never. Read live, like the purge.
  closeAfterDays  Int                    @default(30)
  /// F-116-a, ADR-0098 part 1. The currency this tenant keeps its books in;
  /// the `platform_owner` row's is the platform's. A CHECK holds the shape
  /// (`^[A-Z]{3}$`); tenant-service admits only a currency with a rate. Changed
  /// only while the tenant has no money until F-116-f converts it.
  operatingCurrencyCode String                 @default("USD")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users               User[]                     @relation("TenantUsers")
  branding            TenantBranding?
  domains             TenantDomain[]
  featureEntitlements TenantFeatureEntitlement[]
  staffMembers        TenantStaffMember[]
  billingWallet       TenantBillingWallet?
  usageMeters         TenantUsageMeter[]
  gatewayConfigs      TenantGatewayConfig[]
  smsConfigs          TenantSmsConfig[]
  limits              ResellerLimit[]
  quotaOverages       ResellerQuotaOverage[]
  quotaUsages         ResellerQuotaUsage[]
  quotaTermsLocks     ResellerQuotaTermsLock[]
  overageCap          ResellerOverageCap?
  deks                TenantDek[]
  credentials         TenantCredential[]
  subscription        TenantSubscription?
  statusHistory       TenantStatusHistory[]
  storedObjects       StoredObject[]

  @@map("tenant")
  @@schema("tenant")
}

/// ۲. برندینگ اختصاصی هر Tenant.
/// A reseller's own brand (F-018-h, catalog 13.8). Every image is a **key** in
/// object storage (`tenants/<tenantId>/branding/<slot>`, a CHECK holds it to the
/// row's own tenant), never a URL: the URL is built at read time from the
/// tenant's current `assets` or `panel` domain, because domains rotate.
model TenantBranding {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @unique @db.Uuid
  brandName         String
  logoLightKey      String?
  logoDarkKey       String?
  faviconKey        String?
  ogImageKey        String?
  primaryColorHex   String?
  secondaryColorHex String?
  supportEmail      String?
  supportPhone      String?
  /// An `https` link to where support answers — a Telegram account, a help page.
  supportUrl        String?
  /// `{ <network>: <https link> }`, the networks `tenant-branding.schema.ts` names.
  socials           Json     @default("{}")
  aboutText         String?
  termsUrl          String?
  privacyUrl        String?
  defaultLanguage   Language @default(fa)
  /// The default name of a served config line (F-307-j, ADR-0089 rule 4), e.g.
  /// `{brand} · {region}`; `null` is the platform's `{region}`. Evaluated per
  /// request by billing's config list and `/sub`, never stored per config.
  lineNameTemplate  String?
  updatedAt         DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_branding")
  @@schema("tenant")
}

/// ۳. دامنه اختصاصی/زیردامنه هر Tenant (بخش ح سند: مکانیزم CNAME آروان‌کلاد).
model TenantDomain {
  id                 String                   @id @default(uuid()) @db.Uuid
  tenantId           String                   @db.Uuid
  domainType         TenantDomainType
  domainValue        String                   @unique // myvpn.txnet.app یا myvpn.com
  /// What this door is for. `panel` is the default because every domain that
  /// existed before this column was a panel domain, and because it is the only
  /// value that serves anything today (F-066-q).
  purpose            TenantDomainPurpose      @default(panel)
  verificationStatus DomainVerificationStatus @default(pending) // فقط برای custom_domain معتبر
  verificationToken  String? // برای رکورد TXT اثبات مالکیت
  verifiedAt         DateTime?
  arvanRegisteredAt  DateTime? // فیلد پیشنهادی بخش ح-۱: زمان ثبت در آروان‌کلاد
  /// When `verificationStatus` last changed: where a `verifying` window starts (F-018-i).
  statusChangedAt    DateTime?
  /// The last check of a custom domain, and what it expected and found (`DomainCheck`).
  lastCheckedAt      DateTime?
  lastCheck          Json?
  /// The last re-validation that found the TXT record (catalog 13.2 step 6).
  lastRevalidatedAt  DateTime?
  /// Set while a `verified` domain's record is missing: still routed until the
  /// grace ends, then `pending`. The catalog's `revalidating` is this, not a status,
  /// so every routing reader keeps checking `verified` alone.
  revalidatingSince  DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_domain")
  @@schema("tenant")
}

/// ۴. پلن‌هایی که شما (پلتفرم) به Reseller می‌فروشید.
model TenantFeaturePackage {
  id                  String   @id @default(uuid()) @db.Uuid
  name                String   @unique // «Starter»، «Growth»، «Enterprise»
  // F-018-d: in `currencyCode` (C-02). Either may be null — a package sold for one
  // period only — but not both, and neither is zero (CHECKs in migration
  // 20260917001200_tenant_feature_package).
  monthlyPrice        Decimal? @db.Decimal(18, 2)
  yearlyPrice         Decimal? @db.Decimal(18, 2)
  /// The platform's currency (ADR-0098 part 4); converted with it (F-116-f).
  currencyCode        String
  includedFeatureKeys Json // Array of TENANT_FEATURE_KEYS (shared-core)
  // D-41: no metering, so the two below stay `{}` and unused.
  usageIncludedJson   Json     @default("{}")
  overageRuleJson     Json     @default("{}")
  // Deactivated: not offered any more; its subscribers keep it until renewal.
  isActive            Boolean  @default(true)

  subscriptions TenantSubscription[]
  meterRates    TenantPackageMeterRate[]
  limits        PackageLimit[]
  quotaOverages PackageQuotaOverage[]
  products      PackageProduct[]

  @@map("tenant_feature_package")
  @@schema("tenant")
}

/// F-118-n1 (ADR-0105 (10)): the wholesale price list — what the platform
/// charges a reseller on this package per `unitSize` of a platform meter its
/// users consume on the platform's panels. History like `rate_card`: a new
/// price is a new row, only `isActive` changes (trigger). In force: the newest
/// active row at or before the instant, in the package's currency.
model TenantPackageMeterRate {
  id               String   @id @default(uuid()) @db.Uuid
  packageId        String   @db.Uuid
  /// A `Meter.key` (`METER_KEYS`).
  meterKey         String
  unitSize         BigInt
  unitPrice        Decimal  @db.Decimal(18, 8)
  /// The package's, the platform's (ADR-0098 part 4); a currency change writes new rows (F-116-f).
  currencyCode     String
  effectiveFrom    DateTime @default(now())
  isActive         Boolean  @default(true)
  createdByAdminId String?  @db.Uuid
  createdAt        DateTime @default(now())

  package TenantFeaturePackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
  meter   Meter                @relation(fields: [meterKey], references: [key], onDelete: Restrict, onUpdate: Restrict)

  @@index([packageId, meterKey, effectiveFrom(sort: Desc)])
  @@map("tenant_package_meter_rate")
  @@schema("tenant")
}

/// F-018-e — a reseller's subscription: which package it is on and when the
/// current period ends. The period itself (monthly / yearly) is
/// `Tenant.billingModel`, not repeated here. The first package starts the trial
/// (`currentPeriodEnd` = now + `TenantSubscriptionSetting.trialDays`); a later
/// package or period change keeps `currentPeriodEnd`. Renewal and every charge
/// are F-019-c's, which reads `currentPeriodEnd`.
model TenantSubscription {
  tenantId         String    @id @db.Uuid
  packageId        String    @db.Uuid
  currentPeriodEnd DateTime
  /// F-019-c. When the owner was last warned that the renewal is unpaid; cleared by a renewal.
  renewalWarnedAt  DateTime?
  /// F-019-g. The platform owner's extra time to pay: the renewal does not suspend before it. Cleared by a paid renewal.
  graceUntil       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant  Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  package TenantFeaturePackage @relation(fields: [packageId], references: [id], onDelete: Restrict)

  @@index([packageId])
  @@index([currentPeriodEnd])
  @@map("tenant_subscription")
  @@schema("tenant")
}

/// F-018-e — the platform's subscription settings: one row (`id = 1`, CHECK),
/// edited by the platform owner. `trialDays` is 0..365 (CHECK).
model TenantSubscriptionSetting {
  id                 Int      @id @default(1)
  trialDays          Int      @default(14)
  /// F-018-f. Days a suspended tenant's `/sub` links are still served (CHECK 0..90).
  suspensionHoldDays Int      @default(7)
  /// F-019-c. Days an unpaid renewal is waited for before the tenant is suspended (CHECK 0..30).
  renewalGraceDays   Int      @default(3)
  /// F-019-v2 (ADR-0107 point 7). The clock a sold quota's day and week are read on (an IANA zone, checked in code).
  quotaTimeZone      String   @default("Asia/Tehran")
  updatedByUserId    String?  @db.Uuid
  updatedAt          DateTime @updatedAt

  @@map("tenant_subscription_setting")
  @@schema("tenant")
}

/// F-018-f. Every change of a tenant's status, append-only (a trigger refuses
/// UPDATE and DELETE). `actorUserId` is null for a change the platform made
/// itself (F-019-c's renewal).
model TenantStatusHistory {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @db.Uuid
  fromStatus  TenantStatus
  toStatus    TenantStatus
  reason      String?
  actorUserId String?      @db.Uuid
  createdAt   DateTime     @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("tenant_status_history")
  @@schema("tenant")
}

/// ۵. کدام قابلیت برای این Tenant فعال است — Guard مرکزی قبل از اجرای هر
/// قابلیت این جدول را چک می‌کند (حتی اگر فیچر روی کل پلتفرم فعال باشد).
model TenantFeatureEntitlement {
  id         String            @id @default(uuid()) @db.Uuid
  tenantId   String            @db.Uuid
  featureKey String // ai_recommendation, spin_wheel, affiliate_system, coupon_engine,
  // custom_bot_telegram, custom_bot_bale, own_gateway, own_sms,
  // multi_currency, dedicated_node_pool
  isEnabled  Boolean           @default(false)
  source     EntitlementSource
  expiresAt  DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, featureKey])
  @@map("tenant_feature_entitlement")
  @@schema("tenant")
}

/// ۶. تیم داخلی خود Reseller — عضویت، نه نقش.
/// A reseller's own team (F-018-j, catalog F-1201). This row says **who is on
/// the team and until when**; what they may do is their `identity.User.roleId`,
/// a role of this tenant (F-018-n, ADR-0062) — D-42 (2)'s one RBAC. `revokedAt`
/// removes a member without losing the trail; `(tenantId, userId)` is unique, so
/// re-inviting a removed member reuses their row. Migration
/// `20260919000300_tenant_staff_member`.
model TenantStaffMember {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  userId   String @db.Uuid
  /// Who invited them; null = the platform owner's staff, who are in another tenant.
  invitedByUserId String?   @db.Uuid
  invitedAt       DateTime  @default(now())
  /// When they accepted. Null = invited and not yet in.
  joinedAt        DateTime?
  /// Time-bound access (F-1201): null = no end date.
  accessExpiresAt DateTime?
  /// Removed. The row stays; nothing about them is admitted after this.
  revokedAt       DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@map("tenant_staff_member")
  @@schema("tenant")
}

// ── بیلینگ Tenant↔پلتفرم — تنها جریان مالی مجاز بین شما و Tenant ───────────

/// ب-۱. TenantBillingWallet — a reseller's prepaid balance with the platform (D-41);
/// `cachedBalance >= 0` is a CHECK (migration 20260917000900), never a debt.
model TenantBillingWallet {
  id            String  @id @default(uuid()) @db.Uuid
  tenantId      String  @unique @db.Uuid
  cachedBalance Decimal @default(0) @db.Decimal(18, 2) // فقط Cache؛ منبع حقیقت TenantBillingTransaction است
  /// The platform's currency (ADR-0098 part 4), converted with it (F-116-f).
  currencyCode  String
  version       Int     @default(0) // Optimistic Locking
  /// F-118-w: when a refused wholesale leg told the owner; null = armed. A block this wallet funds on a platform panel clears it.
  unfundedNoticeAt DateTime?

  tenant       Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions TenantBillingTransaction[]

  @@map("tenant_billing_wallet")
  @@schema("tenant")
}

/// TenantBillingTransaction — Append-only، همان الگوی Ledger سند اصلی.
/// F-019-a: written only by `TenantBillingLedger` (shared-core). Migration
/// 20260917000900 adds what Prisma cannot model: `amount > 0`, `balanceAfter >= 0`,
/// and a partial unique (reasonType, referenceId) where the reference is set.
model TenantBillingTransaction {
  id           String                  @id @default(uuid()) @db.Uuid
  walletId     String                  @db.Uuid
  amount       Decimal                 @db.Decimal(18, 2)
  direction    TenantLedgerDirection
  reasonType   TenantBillingReasonType
  referenceId  String?                 @db.Uuid
  balanceAfter Decimal                 @db.Decimal(18, 2)
  /// Always its wallet's (F-116-f); a trigger refuses another.
  currencyCode String
  /// A credit priced before a platform currency change and landing after it: what it was before conversion. Both or neither.
  sourceAmount       Decimal?          @db.Decimal(18, 2)
  sourceCurrencyCode String?
  createdAt    DateTime                @default(now())

  wallet      TenantBillingWallet @relation(fields: [walletId], references: [id])
  usageMeters TenantUsageMeter[]

  @@index([walletId, createdAt(sort: Desc)])
  @@map("tenant_billing_transaction")
  @@schema("tenant")
}

/// TenantUsageMeter — برای مدل pay_as_you_go_metered؛ Worker
/// `tenant_usage_metering` دوره‌ای مصرف را جمع می‌زند و از کیف‌پول کسر می‌کند.
model TenantUsageMeter {
  id                  String         @id @default(uuid()) @db.Uuid
  tenantId            String         @db.Uuid
  meterKey            TenantMeterKey
  periodStart         DateTime
  periodEnd           DateTime
  quantity            Decimal        @db.Decimal(18, 4)
  unitPrice           Decimal        @db.Decimal(18, 8) // از TenantFeaturePackage.overageRuleJson
  /// The platform's currency when written (F-116-f); an unbilled row is converted with it.
  currencyCode        String
  isBilled            Boolean        @default(false)
  billedTransactionId String?        @db.Uuid

  tenant            Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  billedTransaction TenantBillingTransaction? @relation(fields: [billedTransactionId], references: [id])

  @@index([tenantId, meterKey, periodStart])
  @@map("tenant_usage_meter")
  @@schema("tenant")
}

// ── یکپارچگی‌های اختصاصی هر Tenant (Bring-Your-Own-Integration) ────────────

/// TenantGatewayConfig — همیشه درگاه اختصاصی خودِ Tenant؛ هیچ گزینه‌ی
/// اشتراکی با billing.PaymentGateway پلتفرم وجود ندارد.
/// A reseller may run several, one per provider (D-20), each priced like a
/// billing.PaymentGateway: displayName and the fee / tax / min / max and rate
/// columns match it.
model TenantGatewayConfig {
  id                  String                          @id @default(uuid()) @db.Uuid
  tenantId            String                          @db.Uuid
  displayName         String // what the panel's gateway selector shows
  providerName        PaymentProviderName
  gatewayCategory     GatewayCategory
  merchantIdEncrypted String? // SENSITIVE — never default-select
  apiKeyEncrypted     String? // SENSITIVE — never default-select
  verificationStatus  TenantGatewayVerificationStatus @default(pending_test_transaction)
  verifiedByAdminId   String?                         @db.Uuid
  isActive            Boolean                         @default(false)
  minAcceptAmount     Decimal?                        @db.Decimal(18, 2) // null = no minimum
  maxAcceptAmount     Decimal?                        @db.Decimal(18, 2) // null = no maximum
  /// The tenant's currency its limits, fees and presets are in (F-116-b) —
  /// not what it charges in.
  currencyCode        String
  feeCalculationMode  FeeCalcMode
  feeType             FeeType
  feeValue            Decimal                         @db.Decimal(18, 4)
  feeFloor            Decimal?                        @db.Decimal(18, 2)
  feeCeiling          Decimal?                        @db.Decimal(18, 2)
  useLiveRate         Boolean                         @default(true)
  staticRate          Decimal?                        @db.Decimal(30, 18)
  percentageModifier  Decimal                         @default(0) @db.Decimal(9, 4) // + = markup
  fixedAmountModifier Decimal                         @default(0) @db.Decimal(30, 18)
  minRate             Decimal?                        @db.Decimal(30, 18)
  maxRate             Decimal?                        @db.Decimal(30, 18)
  roundingStep        Decimal?                        @db.Decimal(18, 8)
  roundingMode        RateRoundingMode                @default(up)
  // Quick amounts on the top-up page (F-092-v). Empty = the tenant's default.
  depositPresets      Decimal[]                       @default([]) @db.Decimal(18, 2)
  // Tax on a top-up through this gateway (ADR-0076, F-104-ae). Null = the
  // tenant's default on `billing.deposit_setting`. 0..100, CHECK in the migration.
  taxRatePercent      Decimal?                        @db.Decimal(9, 4)
  // The callback address the provider is given (F-092-w). Null = the tenant's panel domain.
  callbackUrl         String?
  createdAt           DateTime                        @default(now())
  updatedAt           DateTime                        @updatedAt

  tenant   Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments PaymentTransaction[]
  /// Grants of this gateway to other tenants (ADR-0041, F-096-a). The owner is
  /// unchanged by a grant; this is only who else may use it.
  grants   PaymentGatewayGrant[]
  /// Coupons limited to this gateway (`billing.coupon_gateway`, migration 20260914001100_coupon_limits).
  couponLimits CouponGateway[]

  @@unique([tenantId, providerName])
  @@map("tenant_gateway_config")
  @@schema("tenant")
}

/// TenantSmsConfig — use_platform_sms یعنی متری‌شدن با TenantUsageMeter،
/// own_credentials یعنی مستقیم از پنل خودش بدون کسر از پلتفرم.
/// One per tenant. The line's key and sender are vault values (`sms_api_key`,
/// `sms_sender_line`) since F-018-a, never a column (ADR-0026).
model TenantSmsConfig {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @unique @db.Uuid
  mode            TenantSmsMode
  ownProviderName String?
  isActive        Boolean       @default(true)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_sms_config")
  @@schema("tenant")
}

// TenantBotIntegration lived here until F-066-h and is now
// `automation.BotIntegration`: several bots per tenant with roles, and the
// token held as a vault reference instead of a `botTokenEncrypted` column
// (catalog 10.1, ADR-0026). The table was empty and no code ever read it.

/// ADR-0106 (F-019-m): the platform's value for one reseller limit key, for
/// every reseller. No row = the code default (`RESELLER_LIMITS`); `value` null
/// = no limit, on purpose. Platform-wide, so no tenant and no RLS.
model ResellerLimitSetting {
  key             String   @id
  /// >= 0 (CHECK); null = no limit.
  value           Int?
  updatedByUserId String   @db.Uuid
  updatedAt       DateTime @updatedAt

  @@map("reseller_limit_setting")
  @@schema("tenant")
}

/// ADR-0106: a package's value for one key — what every reseller on that tier
/// gets, over the platform's. `value` null = no limit.
model PackageLimit {
  packageId       String   @db.Uuid
  key             String
  value           Int?
  updatedByUserId String   @db.Uuid
  updatedAt       DateTime @updatedAt

  package TenantFeaturePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@id([packageId, key])
  @@map("package_limit")
  @@schema("tenant")
}

/// ADR-0106: one reseller's own value for one key, over its package's — set by
/// the platform's staff with a reason. `value` null = no limit. Strict tenant RLS.
model ResellerLimit {
  tenantId    String   @db.Uuid
  key         String
  value       Int?
  reason      String
  setByUserId String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, key])
  @@map("reseller_limit")
  @@schema("tenant")
}

/// ADR-0107 point 2: past a quota key's number, refuse (`stop`) or sell each
/// further unit from the reseller's billing wallet (`overage`). Only keys whose
/// registry `kind` is `quota` (checked in code); a guard always stops.
enum QuotaOverageMode {
  stop
  overage

  @@schema("tenant")
}

/// ADR-0107 point 2: the platform's answer past one quota key, over the code
/// default (`stop`). `unitPrice` + `currencyCode` (the platform's) are set
/// exactly when `mode` is `overage` (CHECK). Kept apart from
/// `reseller_limit_setting` so setting the number never resets the mode.
model QuotaOverageSetting {
  key             String           @id
  mode            QuotaOverageMode
  unitPrice       Decimal?         @db.Decimal(18, 2)
  currencyCode    String?
  updatedByUserId String           @db.Uuid
  updatedAt       DateTime         @updatedAt

  @@map("quota_overage_setting")
  @@schema("tenant")
}

/// ADR-0107 point 2: a package's answer past one quota key, over the platform's.
model PackageQuotaOverage {
  packageId       String           @db.Uuid
  key             String
  mode            QuotaOverageMode
  unitPrice       Decimal?         @db.Decimal(18, 2)
  currencyCode    String?
  updatedByUserId String           @db.Uuid
  updatedAt       DateTime         @updatedAt

  package TenantFeaturePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@id([packageId, key])
  @@map("package_quota_overage")
  @@schema("tenant")
}

/// ADR-0107 point 3 (F-019-v5): a platform product a package lets its
/// subscribers sell. No row = not sold by them; a reseller's own products are
/// never listed here. No tenant, no RLS (as `tenant_feature_package`).
model PackageProduct {
  packageId       String   @db.Uuid
  productId       String   @db.Uuid
  updatedByUserId String   @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  package TenantFeaturePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([packageId, productId])
  @@index([productId])
  @@map("package_product")
  @@schema("tenant")
}

/// ADR-0107 point 2: one reseller's own answer past one quota key, over its
/// package's — set by the platform's staff with a reason. Strict tenant RLS.
model ResellerQuotaOverage {
  tenantId     String           @db.Uuid
  key          String
  mode         QuotaOverageMode
  unitPrice    Decimal?         @db.Decimal(18, 2)
  currencyCode String?
  reason       String
  setByUserId  String           @db.Uuid
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, key])
  @@map("reseller_quota_overage")
  @@schema("tenant")
}

/// ADR-0107 point 8 (F-019-v3): one reseller's terms for one quota key, frozen
/// for one subscription period (`periodEnd` = its `currentPeriodEnd` then) the
/// moment before the platform first changes them in it. Read with the live
/// terms, the kinder part winning (user 2026-10-01). A renewal moves
/// `currentPeriodEnd`, so a past period's row is never read again. Insert only.
/// Strict tenant RLS.
model ResellerQuotaTermsLock {
  tenantId       String           @db.Uuid
  key            String
  periodEnd      DateTime
  /// null = no limit.
  included       Int?
  includedSource String
  mode           QuotaOverageMode
  unitPrice      Decimal?         @db.Decimal(18, 2)
  currencyCode   String?
  overageSource  String
  lockedAt       DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, key, periodEnd])
  @@map("reseller_quota_terms_lock")
  @@schema("tenant")
}

/// ADR-0107 point 4 (F-019-v2): one act's units of one quota meter — the
/// engine's whole state. One row per (tenant, meter, sourceRef): consuming the
/// same act again answers the same row. `includedQty + overageQty = qty`; an
/// overage row carries its price and the `tenant_billing_transaction` that paid
/// it (`overageAmount = overageQty × unitPrice`, CHECK). Released = given back:
/// its included units return to the period, its charge to the wallet. Append
/// and release only. Strict tenant RLS.
model ResellerQuotaUsage {
  id                  String    @id @db.Uuid
  tenantId            String    @db.Uuid
  meter               String
  sourceRef           String
  periodStart         DateTime
  periodEnd           DateTime
  qty                 Int
  includedQty         Int
  overageQty          Int
  unitPrice           Decimal?  @db.Decimal(18, 2)
  overageAmount       Decimal   @default(0) @db.Decimal(18, 2)
  currencyCode        String?
  chargeTransactionId String?   @db.Uuid
  releasedAt          DateTime?
  refundTransactionId String?   @db.Uuid
  createdAt           DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, meter, sourceRef])
  @@index([tenantId, meter, createdAt])
  @@index([tenantId, createdAt])
  @@map("reseller_quota_usage")
  @@schema("tenant")
}

/// ADR-0107 point 6 (F-019-v2): the most a reseller lets overage cost it per
/// subscription month, in the platform's currency; reaching it is `stop`. No
/// row = no cap of its own (the wallet still bounds it). Set by the reseller.
/// Strict tenant RLS.
model ResellerOverageCap {
  tenantId     String   @id @db.Uuid
  amount       Decimal  @db.Decimal(18, 2)
  currencyCode String
  setByUserId  String   @db.Uuid
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("reseller_overage_cap")
  @@schema("tenant")
}

// =============================================================================

// ── The Credential Vault (ADR-0026, catalog 20.4) ──────────────────────────
//
// Envelope encryption: one DEK per tenant, wrapped by a KEK that lives outside
// this database (a mounted Docker Swarm secret). A dump of these two tables is
// inert without that file, and a compromise of one tenant's DEK reaches only
// that tenant's credentials — which is catalog 20.2's layer 5.
//
// Nothing here is ever default-selected into an API response: the only shape
// an admin surface sees is `{configured, fingerprint, status, lastUsedAt}`
// (tenant invariant #8). `ciphertext`, `iv`, `authTag` and `wrappedKey` are
// read by `CredentialVaultService` and by nothing else.

/// What a stored credential is for. The list is catalog 20.4's, verbatim;
/// a new third-party integration adds a member here rather than a column
/// somewhere else, so the vault stays the only home for a secret.
enum TenantCredentialKind {
  telegram_bot_token
  bale_bot_token
  sms_api_key
  sms_sender_line
  gateway_merchant_id
  gateway_secret_key
  panel_credentials
  webhook_secret
  ai_provider_api_key
  /// A source panel's credentials, held only while a migration is in flight.
  source_panel_credentials
  cdn_dns_credentials

  @@schema("tenant")
}

/// Where a credential version sits in its rotation.
///
/// `superseded` is the grace window ADR-0026 decision 4 requires: a newer
/// version is already active, but an in-flight webhook signed against this one
/// must still verify. It is destroyed — the row deleted — once the window has
/// passed, which is why there is no `destroyed` member: a destroyed version is
/// an absent row, not a row that still holds its ciphertext.
enum TenantCredentialStatus {
  active
  superseded
  expired
  revoked

  @@schema("tenant")
}

/// One data key per tenant, wrapped by the KEK. `wrappedKey` is the DEK
/// sealed with AES-256-GCM under the KEK named by `kekId`; `kekId` is what
/// makes a KEK rotation possible without re-encrypting every credential —
/// only the DEK rows are re-wrapped.
///
/// A tenant may hold several rows over time; exactly one has `retiredAt = null`
/// and that is the one new credentials are encrypted under. Old ones stay so
/// credentials written under them remain readable.
model TenantDek {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  wrappedKey String // SENSITIVE — never default-select
  kekId      String
  createdAt  DateTime  @default(now())
  retiredAt  DateTime?

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  credentials TenantCredential[]

  @@index([tenantId, retiredAt])
  @@map("tenant_dek")
  @@schema("tenant")
}

/// One version of one credential, encrypted under its tenant's DEK.
///
/// `fingerprint` is a truncated hash of the plaintext (F-1214): it answers
/// "is this the same value I already have?" without revealing anything, which
/// is what makes the no-plaintext rule liveable for an admin UI.
///
/// `(tenantId, kind, label, version)` is unique so a rotation cannot collide
/// with itself. "At most one `active` version per (tenantId, kind, label)" is
/// a *partial* unique index, which Prisma cannot express — it is hand-written
/// in this model's migration rather than deferred to F-041, because the vault
/// depends on it to know which version to read.
model TenantCredential {
  id          String                 @id @default(uuid()) @db.Uuid
  tenantId    String                 @db.Uuid
  kind        TenantCredentialKind
  /// Which one, when a tenant holds several of a kind — an SMS sender line, a
  /// second bot. Empty string when the kind is singular for a tenant.
  label       String                 @default("")
  ciphertext  String // SENSITIVE — never default-select
  iv          String // SENSITIVE — never default-select
  authTag     String // SENSITIVE — never default-select
  dekId       String                 @db.Uuid
  fingerprint String
  status      TenantCredentialStatus @default(active)
  version     Int                    @default(1)
  createdBy   String?                @db.Uuid
  createdAt   DateTime               @default(now())
  rotatedAt   DateTime?
  lastUsedAt  DateTime?
  expiresAt   DateTime?

  tenant Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dek    TenantDek @relation(fields: [dekId], references: [id])

  @@unique([tenantId, kind, label, version])
  @@index([tenantId, kind, status])
  @@index([status, rotatedAt])
  @@map("tenant_credential")
  @@schema("tenant")
}

/// One decryption of one credential (ADR-0026 decision 5, F-1215): who, which
/// tenant, which kind, which caller. **Never the value, and never the
/// fingerprint** — a log or an audit row is the one place a short secret and
/// unlimited guesses meet (tenant invariant #8).
///
/// Written by `CredentialVaultService.use()`, which is the only method that
/// returns a plaintext, and awaited before the plaintext is handed over: an
/// unaudited decryption is a failed decryption. `verify` and `matches` write
/// nothing, because they compare fingerprints and decrypt nothing.
///
/// **Deliberately carries no foreign key**, not to `tenant_credential` and not
/// to `tenant`. An audit trail has to outlive what it describes, and both
/// available FK behaviours are wrong here: `RESTRICT` would make
/// `destroyExpiredVersions` unable to destroy a superseded version, which is
/// the one thing ADR-0026 decision 4 requires it to do, and `CASCADE` would
/// erase the record of every use of a credential at the moment it is removed.
/// `audit.admin_audit_log` holds its `tenantId` the same way and for the same
/// reason.
model TenantCredentialAccess {
  id           String               @id @default(uuid()) @db.Uuid
  tenantId     String               @db.Uuid
  /// The row that was decrypted. Not an FK — see the note above; the row it
  /// names may legitimately be gone.
  credentialId String               @db.Uuid
  kind         TenantCredentialKind
  label        String               @default("")
  /// Which version was decrypted, so a rotation is visible in the trail.
  version      Int
  /// The code path that asked, e.g. `messenger:BotClientRegistry`. A string
  /// rather than an enum: the set of callers grows with every integration,
  /// and a migration per integration is not what this record is worth.
  caller       String
  /// The person on whose behalf, when there is one. A background worker or a
  /// webhook has none, and `null` says so rather than naming a fake actor.
  actorId      String?              @db.Uuid
  createdAt    DateTime             @default(now())

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([credentialId, createdAt(sort: Desc)])
  @@map("tenant_credential_access")
  @@schema("tenant")
}
