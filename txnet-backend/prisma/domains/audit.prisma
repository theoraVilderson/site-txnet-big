// بخش سیزده: Schema `audit` — لاگ حسابرسی، Impersonation، سوییچ اکانت
// =============================================================================

enum AdminAction {
  wallet_manual_adjust
  user_ban
  user_unban
  config_force_disable
  role_change
  gateway_toggle
  coupon_create_targeted
  payment_manual_confirm
  currency_policy_lock
  restriction_assign
  bot_toggle
  user_impersonate_start
  user_impersonate_end
  // اکشن‌های اضافه‌شده برای چندمستأجری:
  tenant_suspend
  tenant_settlement_approve
  tenant_feature_grant
  tenant_gateway_config_change
  tenant_domain_verify

  @@schema("audit")
}

enum AuditTargetType {
  user
  wallet
  config
  gateway
  coupon
  payment
  currency_policy
  bot_worker
  restriction

  @@schema("audit")
}

/// 14.1 — Append-only مطلق؛ حتی Super Admin هم نباید بتواند رکورد حذف کند.
model AdminAuditLog {
  id               String          @id @default(uuid()) @db.Uuid
  tenantId         String?         @db.Uuid
  adminId          String          @db.Uuid
  action           AdminAction
  targetEntityType AuditTargetType
  targetEntityId   String          @db.Uuid
  oldValue         Json?
  newValue         Json?
  adminIpAddress   String
  createdAt        DateTime        @default(now())

  @@index([targetEntityId, createdAt(sort: Desc)])
  @@index([tenantId])
  @@map("admin_audit_log")
  @@schema("audit")
}

/// 14.2 — ورود ادمین به‌جای کاربر بدون رمز؛ اکشن اجباری در AdminAuditLog.
model ImpersonationSession {
  id             String    @id @default(uuid()) @db.Uuid
  adminId        String    @db.Uuid
  targetUserId   String    @db.Uuid
  reasonNote     String
  linkedTicketId String?   @db.Uuid
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  adminIpAddress String

  linkedTicket Ticket?   @relation(fields: [linkedTicketId], references: [id])
  sessions     Session[]

  @@map("impersonation_session")
  @@schema("audit")
}

/// 14.3 — Account switching (the user's own accounts). A group belongs to the
/// surface instance it was built on — one bot chat, or one browser — never to
/// the person globally (ADR-0015). The same account therefore holds a different
/// set in each place it is used, and neither leaks into the other.
model LinkedAccountGroup {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())

  members LinkedAccountMember[]

  @@map("linked_account_group")
  @@schema("audit")
}

model LinkedAccountMember {
  id             String   @id @default(uuid()) @db.Uuid
  groupId        String   @db.Uuid
  userId  String @db.Uuid

  /// Which surface instance this membership was proved for (ADR-0015):
  /// `bot:<platform>:<chatId>` for a chat, `device:<uuid>` for a browser.
  /// It is a partition key, not a credential — forging one buys nothing,
  /// because a member row still has to exist under it.
  ///
  /// Invariant: every member row of one `groupId` shares one `scopeKey`.
  /// `AccountSwitchService.join` is the only writer, and it is what holds this.
  scopeKey String

  addedAt        DateTime @default(now())
  verifiedViaOtp Boolean  @default(false)

  group LinkedAccountGroup @relation(fields: [groupId], references: [id])

  // Was `userId @unique` before ADR-0015: one group per person, everywhere.
  // Uniqueness moved onto the pair, so an account may hold one group per
  // scope and joining is still a move *within* a scope (audit invariant #3).
  @@unique([scopeKey, userId])
  @@index([groupId])
  @@map("linked_account_member")
  @@schema("audit")
}

