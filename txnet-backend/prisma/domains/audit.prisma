// بخش سیزده: Schema `audit` — لاگ حسابرسی، Impersonation، سوییچ اکانت
// =============================================================================

enum AdminAction {
  wallet_manual_adjust
  user_ban
  user_unban
  config_force_disable
  role_change
  gateway_toggle
  coupon_create_targeted
  payment_manual_confirm
  currency_policy_lock
  restriction_assign
  bot_toggle
  user_impersonate_start
  user_impersonate_end
  // اکشن‌های اضافه‌شده برای چندمستأجری:
  tenant_suspend
  tenant_settlement_approve
  tenant_feature_grant
  tenant_gateway_config_change
  tenant_domain_verify
  // ADR-0041 §5/§6, F-096-e — the operator surface over granted gateways.
  // Three values rather than one `tenant_settlement_approve`, because a trail
  // that cannot tell a grant from its withdrawal does not answer the question
  // it exists for: who let this tenant collect, and who stopped it.
  gateway_grant_create
  gateway_grant_withdraw
  gateway_settlement_payout
  // F-102-b (D-31) — managing the gateway itself. Delete is its own value
  // because a deleted gateway and a deactivated one leave different trails.
  gateway_create
  gateway_update
  gateway_delete
  // F-092-v — a tenant's default quick amounts on the top-up page.
  deposit_presets_update
  // F-092-ak — a person ends an open payment nobody paid. Its own value beside
  // `payment_manual_confirm`: a credit by hand and a refusal by hand are
  // opposite acts, and the trail must say which one a person took.
  payment_manual_reject
  // F-502-c (D-33) — managing a coupon. Delete is its own value; `newValue.mode`
  // tells a hard delete from a soft one.
  coupon_create
  coupon_update
  coupon_delete
  // F-502-d — a gift-code batch. Export is audited: the file is the credit.
  coupon_batch_create
  coupon_batch_export
  // F-026-d — catalog management. Nothing is deleted, so no delete values; a
  // price has its own two, because a new price and a switched-off one are
  // opposite acts on what an invoice is computed at.
  catalog_category_create
  catalog_category_update
  catalog_product_create
  catalog_product_update
  catalog_variant_create
  catalog_variant_update
  catalog_price_set
  catalog_price_deactivate
  coupon_batch_deactivate
  campaign_send
  // F-019-a (D-41) — the platform owner credits or debits a reseller's billing wallet by hand.
  tenant_billing_adjust

  @@schema("audit")
}

enum AuditTargetType {
  user
  wallet
  config
  gateway
  coupon
  payment
  currency_policy
  bot_worker
  restriction
  // F-096-e. A grant and a payout are their own things: neither is the
  // `gateway` row (which the grant only points at) nor the `payment` that
  // accrued under it.
  gateway_grant
  settlement_payout
  // F-502-d. A batch of gift codes, not any one coupon in it.
  coupon_batch
  // F-026-d. Catalog management audits the item it touched; a price is its
  // own target because it is written as history, never as an edit.
  product_category
  product
  product_variant
  price
  notification_campaign
  // F-019-a. A reseller's billing wallet with the platform, not a user's `wallet`.
  tenant_billing_wallet

  @@schema("audit")
}

/// 14.1 — Append-only مطلق؛ حتی Super Admin هم نباید بتواند رکورد حذف کند.
model AdminAuditLog {
  id               String          @id @default(uuid()) @db.Uuid
  tenantId         String?         @db.Uuid
  adminId          String          @db.Uuid
  action           AdminAction
  targetEntityType AuditTargetType
  targetEntityId   String          @db.Uuid
  oldValue         Json?
  newValue         Json?
  adminIpAddress   String
  createdAt        DateTime        @default(now())

  @@index([targetEntityId, createdAt(sort: Desc)])
  @@index([tenantId])
  @@map("admin_audit_log")
  @@schema("audit")
}

/// 14.2 — ورود ادمین به‌جای کاربر بدون رمز؛ اکشن اجباری در AdminAuditLog.
model ImpersonationSession {
  id             String    @id @default(uuid()) @db.Uuid
  adminId        String    @db.Uuid
  targetUserId   String    @db.Uuid
  reasonNote     String
  linkedTicketId String?   @db.Uuid
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  adminIpAddress String

  linkedTicket Ticket?   @relation(fields: [linkedTicketId], references: [id])
  sessions     Session[]

  @@map("impersonation_session")
  @@schema("audit")
}

/// 14.3 — Account switching (the user's own accounts). A group belongs to the
/// surface instance it was built on — one bot chat, or one browser — never to
/// the person globally (ADR-0015). The same account therefore holds a different
/// set in each place it is used, and neither leaks into the other.
model LinkedAccountGroup {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())

  /// Which member this **place** is currently acting as (ADR-0034).
  ///
  /// A group belongs to one scope, so this is the scope's own answer to "who
  /// am I signed in as here" — and it is deliberately *not* a session: the
  /// bot chat and its Mini App are one place holding two sessions (ADR-0032),
  /// and before this column a switch moved whichever one made it and left the
  /// other on the outgoing account.
  ///
  /// Read only where the sign-in is **implicit** — the messenger link is the
  /// credential (ADR-0012), so there is no account named by the caller to
  /// override. A password login names its account and is never redirected.
  ///
  /// `null` means the place has never switched: sign-in falls back to the
  /// `LinkedBotAccount`, which is exactly ADR-0014's behaviour. It survives a
  /// logout on purpose — that is the "accepted cost" ADR-0014 wrote down, and
  /// this column is what closes it.
  actingAsUserId String? @db.Uuid

  members LinkedAccountMember[]

  @@map("linked_account_group")
  @@schema("audit")
}

model LinkedAccountMember {
  id             String   @id @default(uuid()) @db.Uuid
  groupId        String   @db.Uuid
  userId  String @db.Uuid

  /// Which surface instance this membership was proved for (ADR-0015):
  /// `bot:<platform>:<chatId>` for a chat, `device:<uuid>` for a browser.
  /// It is a partition key, not a credential — forging one buys nothing,
  /// because a member row still has to exist under it.
  ///
  /// Invariant: every member row of one `groupId` shares one `scopeKey`.
  /// `AccountSwitchService.join` is the only writer, and it is what holds this.
  scopeKey String

  addedAt        DateTime @default(now())
  verifiedViaOtp Boolean  @default(false)

  group LinkedAccountGroup @relation(fields: [groupId], references: [id])

  // Was `userId @unique` before ADR-0015: one group per person, everywhere.
  // Uniqueness moved onto the pair, so an account may hold one group per
  // scope and joining is still a move *within* a scope (audit invariant #3).
  @@unique([scopeKey, userId])
  @@index([groupId])
  @@map("linked_account_member")
  @@schema("audit")
}

