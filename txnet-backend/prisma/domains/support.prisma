// Schema `support` — one Conversation (ADR-0112, catalog §11)
// =============================================================================
// Tickets and live chat are not two products: they are one thread whose `mode`
// says whether a human is answering right now. The ticket/chat tables the
// schema was born with were dropped empty (20261003001100).

/// Who the thread is waiting on (ADR-0112 point 9): `open` until the first
/// agent reply, then `pending_user` / `pending_agent` by who wrote last.
enum ConversationStatus {
  open
  pending_user
  pending_agent
  resolved
  closed

  @@schema("support")
}

/// A moment-in-time attribute, never a record type (catalog §11.1).
enum ConversationMode {
  live
  async

  @@schema("support")
}

/// Queue position only (catalog §11.5) — never what a user may say or see.
enum ConversationPriority {
  low
  normal
  high
  urgent

  @@schema("support")
}

enum MessageSenderKind {
  user
  agent
  system
  bot
  ai

  @@schema("support")
}

enum AttachmentScanStatus {
  pending
  clean
  infected
  failed

  @@schema("support")
}

/// One open interval of a tenant's weekly support hours (F-033-g), on the
/// tenant's wall clock (`Tenant.timezone`). No row at all = always open.
/// Replaced whole by `PUT /api/support/settings/hours`.
model SupportWorkingHours {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  /// 0 = Sunday … 6 = Saturday.
  weekday     Int      @db.SmallInt
  /// Minutes past local midnight; `endMinute` exclusive, at most 1440.
  startMinute Int      @db.SmallInt
  endMinute   Int      @db.SmallInt
  createdAt   DateTime @default(now())

  @@index([tenantId, weekday])
  @@map("working_hours")
  @@schema("support")
}

/// SLA targets for one priority (F-033-h), in working minutes. `tenantId` NULL
/// is the platform's default; a tenant's own row replaces it for that priority.
model SupportSlaPolicy {
  id                   String               @id @default(uuid()) @db.Uuid
  tenantId             String?              @db.Uuid
  priority             ConversationPriority
  firstResponseMinutes Int
  resolutionMinutes    Int
  updatedAt            DateTime             @default(now()) @updatedAt

  @@unique([tenantId, priority])
  @@map("sla_policy")
  @@schema("support")
}

/// A support category (ADR-0112 point 6). `tenantId` NULL is the platform's
/// default set, which a tenant sees only while it has no active category of
/// its own. Retired with `isActive`, never deleted while a thread names it.
model SupportCategory {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @db.Uuid
  /// Stable per tenant; what a bot button or an analytics row names.
  key       String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  texts         SupportCategoryText[]
  conversations SupportConversation[]

  @@unique([tenantId, key])
  @@map("support_category")
  @@schema("support")
}

/// A category's name in one language. `tenantId` is the category's, copied so
/// the row is policied on its own (NULL for the platform's defaults).
model SupportCategoryText {
  categoryId String   @db.Uuid
  tenantId   String?  @db.Uuid
  lang       Language
  name       String

  category SupportCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([categoryId, lang])
  @@map("support_category_text")
  @@schema("support")
}

/// A canned reply (F-033-j, catalog §11.3): a short key and a text per
/// language that an agent inserts into a reply. Owned like a category:
/// `tenantId` NULL is the platform's defaults every tenant reads, and a
/// tenant's own reply with the same key hides that default.
model SupportCannedReply {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @db.Uuid
  /// Stable per tenant; what the agent's picker searches by.
  key       String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  texts SupportCannedReplyText[]

  @@unique([tenantId, key])
  @@map("canned_reply")
  @@schema("support")
}

/// A canned reply's text in one language, `{variable}`s unfilled. `tenantId`
/// is the reply's, copied so the row is policied on its own.
model SupportCannedReplyText {
  cannedReplyId String   @db.Uuid
  tenantId      String?  @db.Uuid
  lang          Language
  body          String

  cannedReply SupportCannedReply @relation(fields: [cannedReplyId], references: [id], onDelete: Cascade)

  @@id([cannedReplyId, lang])
  @@map("canned_reply_text")
  @@schema("support")
}

/// A tenant's own lifecycle days (F-033-k); no row = the platform's 7 and 7.
model SupportLifecyclePolicy {
  tenantId           String   @id @db.Uuid
  /// A thread waiting on the user, or resolved, closes after this many days without a word from them.
  autoCloseAfterDays Int      @db.SmallInt
  /// A closed thread may be reopened by its user for this many days. 0 = closed is final.
  reopenWithinDays   Int      @db.SmallInt
  updatedAt          DateTime @updatedAt

  @@map("lifecycle_policy")
  @@schema("support")
}

/// The one support entity (catalog §11.1).
model SupportConversation {
  id               String               @id @default(uuid()) @db.Uuid
  tenantId         String               @db.Uuid
  /// The owning reseller node (C-15). Always null until reseller nodes exist (F-901).
  resellerPath     String?
  userId           String               @db.Uuid
  subject          String
  categoryId       String?              @db.Uuid
  status           ConversationStatus   @default(open)
  mode             ConversationMode     @default(async)
  priority         ConversationPriority @default(normal)
  assignedToUserId String?              @db.Uuid
  /// The last message's `seq`. Incremented in the insert's transaction, so the
  /// row lock orders two senders (ADR-0112 point 4).
  lastSeq          Int                  @default(0)
  firstResponseAt  DateTime?
  lastMessageAt    DateTime             @default(now())
  resolvedAt       DateTime?
  closedAt         DateTime?
  /// SLA (F-033-h), in the tenant's working minutes from `createdAt`.
  firstResponseDueAt DateTime?
  /// Pushed later by the working time the clock spent stopped.
  resolutionDueAt  DateTime?
  /// Set while the resolution clock is stopped: waiting on the user, or resolved.
  slaPausedAt      DateTime?
  slaPausedSeconds Int                  @default(0)
  /// The clock running now (first response, then resolution); null while stopped.
  slaDueAt         DateTime?
  /// The user's rating (F-033-k): once, 1–5, on a resolved or closed thread.
  ratingScore      Int?                 @db.SmallInt
  ratingComment    String?
  ratedAt          DateTime?
  /// Closed by the idle sweep rather than by an agent (F-033-k).
  closedAutomatically Boolean           @default(false)
  aiTriageLabel    String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  category              SupportCategory?          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  messages              SupportMessage[]
  reads                 SupportConversationRead[]
  impersonationSessions ImpersonationSession[]

  /// "My conversations", newest activity first.
  @@index([tenantId, userId, lastMessageAt(sort: Desc)])
  /// The agent queue (F-033-d): by status, then priority, then age.
  @@index([tenantId, status, priority, lastMessageAt])
  /// The queue once SLA exists (F-033-h): priority, then the nearest due.
  @@index([tenantId, status, priority, slaDueAt])
  @@map("conversation")
  @@schema("support")
}

/// One message — append-only, monthly range-partitioned on `createdAt`
/// (ADR-0112 point 3, migration 20261003001100). Postgres requires the
/// partition key in every unique constraint, so the key is the pair.
model SupportMessage {
  id             String            @default(uuid()) @db.Uuid
  createdAt      DateTime          @default(now())
  tenantId       String            @db.Uuid
  conversationId String            @db.Uuid
  /// 1, 2, 3 … within the conversation; gap-free (ADR-0112 point 4).
  seq            Int
  senderKind     MessageSenderKind
  /// Null for `system` / `bot` / `ai`.
  senderUserId   String?           @db.Uuid
  body           String
  /// An agent's internal note (catalog §11.3). Never returned to a user.
  internal       Boolean           @default(false)

  conversation SupportConversation        @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  attachments  SupportMessageAttachment[]

  @@id([id, createdAt], map: "message_pkey")
  @@index([conversationId, seq])
  @@map("message")
  @@schema("support")
}

/// How far one reader has read one conversation (ADR-0112 point 5).
model SupportConversationRead {
  conversationId String   @db.Uuid
  userId         String   @db.Uuid
  tenantId       String   @db.Uuid
  lastReadSeq    Int      @default(0)
  readAt         DateTime @default(now())

  conversation SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@map("conversation_read")
  @@schema("support")
}

/// A file on a message, held by the storage port (D-8, ADR-0112 point 7).
/// Never a URL: a 5-minute signed one is minted on read.
model SupportMessageAttachment {
  id               String               @id @default(uuid()) @db.Uuid
  tenantId         String               @db.Uuid
  conversationId   String               @db.Uuid
  messageId        String               @db.Uuid
  messageCreatedAt DateTime
  /// NULL once the file was deleted by retention (F-033-n); `expiredAt` says when.
  objectKey        String?              @unique
  fileName         String
  contentType      String
  sizeBytes        Int
  scanStatus       AttachmentScanStatus @default(pending)
  /// When retention deleted the file (F-033-n): 90 days after the conversation closed.
  expiredAt        DateTime?
  createdAt        DateTime             @default(now())

  message SupportMessage @relation(fields: [messageId, messageCreatedAt], references: [id, createdAt], onDelete: Restrict)
  object  StoredObject?  @relation(fields: [objectKey], references: [key], onDelete: Restrict)

  @@index([conversationId])
  @@index([messageId, messageCreatedAt])
  @@map("message_attachment")
  @@schema("support")
}

