// Schema `entitlement` — what a user holds (F-026-b, D-34, ADR-0049).
// Spec: `tools/spec.py --section 4.4` .. `4.6`.
// =============================================================================

/// Why a Grant exists (§4.4).
enum GrantSource {
  purchase
  admin_grant
  /// Only on a `quota_adjustment` row: bytes an admin gave a metered Grant,
  /// with no wallet debit (F-311-l). Never a Grant's own source.
  admin_gift
  coupon
  affiliate_reward
  migration
  trial
  rollover
  /// A wheel or lottery prize (F-707-b, ADR-0111 point 2): a free Grant's own
  /// source, or the `quota_adjustment` row of bonus GB. Never cash.
  engagement_reward

  @@schema("entitlement")
}

/// `pending → active → (suspended | exhausted | expired | cancelled)`; only
/// `suspended → active` goes back. A trigger holds it (`grant_status_one_way`).
enum GrantStatus {
  pending
  active
  suspended
  exhausted
  expired
  cancelled

  @@schema("entitlement")
}

/// Who may lift a freeze (F-0401-a): `hard` only an admin, `soft` the user too
/// (an admin chose it), `self` the user froze it. Hard beats soft beats self.
enum FreezeMode {
  hard
  soft
  self

  @@schema("entitlement")
}

enum SharingPolicy {
  exclusive
  shared_pool

  @@schema("entitlement")
}

/// The countable quota metrics (§4.5). Duration is `endsAt`, not a metric.
enum QuotaMetric {
  traffic_bytes
  concurrent_devices
  order_units
  feature_items
  api_calls

  @@schema("entitlement")
}

/// One entitlement: "does an active Grant with this feature key exist?" is the
/// only access question (§4.4). Quotas, duration and feature keys are copied
/// from the variant at issue, so a later catalog edit never changes what was
/// sold. Strictly tenant-scoped: never shared-read.
model Grant {
  id                    String             @id @default(uuid()) @db.Uuid
  tenantId              String             @db.Uuid
  userId                String             @db.Uuid
  /// The variant it was issued from; null for one issued without a catalog item (`migration`).
  variantId             String?            @db.Uuid
  /// The panel group it is served by (F-027-er, ADR-0127 decision 4): the
  /// variant's at issue, then its own — a renewal keeps it, a move between
  /// groups changes it and nothing else. Every reader of "this Grant's group"
  /// reads this, never the variant's. Null = served by no group.
  panelGroupId          String?            @db.Uuid
  source                GrantSource
  /// What issued it — the payment, the coupon redemption, the admin action. With
  /// `source`, unique when set, so issuing twice for one cause is refused.
  sourceReferenceId     String?            @db.Uuid
  /// The source panel's client this Grant was imported from (F-201-a, D-63):
  /// the import's idempotency key, so a second run updates instead of issuing
  /// again (F-207). Only on a `migration` Grant (CHECK
  /// `grant_remote_identity_is_migration`); unique per tenant.
  remoteIdentity        String?
  status                GrantStatus        @default(pending)
  statusReason          String?
  startsAt              DateTime
  /// Null = permanent.
  endsAt                DateTime?
  billingMode           VariantBillingMode
  featureKeys           String[]           @default([])
  /// Per metric, copied from the variant: `{"traffic_bytes": {"limit": ..., "resetPolicy": "none"}}`.
  quotas                Json               @default("{}")
  sharingPolicy         SharingPolicy      @default(exclusive)
  /// SHA-256 of the subscription token, lowercase hex: what `/sub` looks a Grant up by.
  subscriptionTokenHash String             @unique
  /// The buyer's own name for this service (F-307-x): display only — My
  /// services, its search and a combined notice show it before the config
  /// labels. Null is the catalog's name. Trimmed, 1..40 characters (CHECK
  /// `grant_user_label_shape`, raw SQL).
  userLabel             String?
  /// The same token sealed, `{kekId, iv, authTag, ciphertext}` (AES-256-GCM under a
  /// key derived from the vault KEK, ADR-0085), so My services can show the link
  /// again. Null for a Grant from before it, or issued with no KEK loaded.
  subscriptionTokenSealed Json?
  tokenRotatedAt        DateTime           @default(now())
  /// What the panels have reported (F-027-n). Measured, not paid for: a panel
  /// whose limit was overridden can report past the ceiling, and that gap is
  /// what the holds queue exists to settle (ADR-0074).
  consumedBytes         BigInt             @default(0)
  /// What the source panel had served an imported Grant's client (F-208):
  /// counted in Used beside the configs' lifetime counters (network
  /// `contract.lease.md`), so the bag left is `purchasedBytes` less it. Written
  /// once by the commit (F-207), never moved; 0 unless `source = migration`
  /// (CHECK `grant_imported_used_bytes_shape`, raw SQL).
  importedUsedBytes     BigInt             @default(0)
  /// What has been bought (ADR-0072). `Σ ceilings ≤ purchasedBytes` across
  /// every config of this Grant — this is the number the allocator is bounded
  /// by. The bag of every Grant, a package plan's too; a metered one's money
  /// cursor is its `vpn.traffic` meter's `billed` (F-118-l).
  purchasedBytes        BigInt             @default(0)
  /// Used (Σ lifetime counters) at the last admin traffic reset (F-311-k); 0
  /// = never reset. A reset adds `Used - this` to Quota and moves it to Used,
  /// so a second reset adds only what was used since the first. A cursor, not
  /// a meter: `consumedBytes` and the counters are never rewritten.
  trafficResetFromBytes BigInt             @default(0)
  /// Sold with `traffic_bytes.limit = 0` (F-111-q): no ceiling, never
  /// exhausted, never buys a block. The catalog is the only place 0 means
  /// unlimited; here the bag stays 0 and this says why. Only on a prepaid
  /// Grant, and only with `purchasedBytes = 0` (`grant_traffic_unlimited_is_prepaid`).
  trafficUnlimited      Boolean            @default(false)
  /// When the owner's open page was last told `consumedBytes`
  /// (`entitlement.grant.usage`, F-307-t). A throttle, not a record: metering
  /// claims the next slot in the charge's own transaction, 30 s after this.
  usagePushedAt         DateTime?
  /// When the bag ran empty (ADR-0075). Starts the purge clock; cleared when a
  /// top-up returns the Grant to `active`.
  suspendedAt           DateTime?
  /// Per-Grant override of the tenant's purge window. Null = use
  /// `tenant.purgeAfterDays`; `0` = never purge.
  purgeAfterDays        Int?
  /// F-118-x: per-Grant override of the tenant's close window, counted from the
  /// purge. Null = use `tenant.closeAfterDays`; `0` = never close.
  closeAfterDays        Int?
  /// The owning reseller node (C-15). Always null until reseller nodes exist (F-901).
  resellerPath          String?
  issuedByAdminId       String?            @db.Uuid
  /// Delivery of a paid Grant (F-111-d, spec §5.8 step 3): the checks that
  /// found it not yet delivered, and when the next one is due. Null = due now.
  /// Only a `pending` Grant is ever checked; the clock is left as it stood.
  deliveryAttempts      Int                @default(0)
  nextDeliveryAt        DateTime?
  /// The check that found it still `pending` 5 minutes after purchase and
  /// announced it (F-601-i): set once, conditionally on null, so the buyer and
  /// the tenant's owner hear once however many checks follow.
  deliveryDelayedAt     DateTime?
  /// When it first turned `active` — at delivery for a purchase, at `startsAt`
  /// for any other source (F-601-c). Null for a Grant from before it.
  activatedAt           DateTime?
  /// The next "not connected yet?" check (F-601-c): 24 h after activation,
  /// then 72 h; null once told twice, once anything was consumed, or never for
  /// a `migration` / `rollover` Grant. A clock, as `nextDeliveryAt` is.
  unusedCheckAt         DateTime?
  /// `consumedBytes` when the current usage period opened (F-601-d): 0 at
  /// issue, set by a renewal that adds bytes. A usage threshold is a share of
  /// `purchasedBytes - usagePeriodFromBytes`, never of the cumulative Quota.
  usagePeriodFromBytes  BigInt             @default(0)
  /// When that period opened; null = at `startsAt`. The ledger's `period` for
  /// a usage threshold (notification `contract.retention.md`).
  usagePeriodStartedAt  DateTime?
  /// The `endsAt` the time-threshold clock was last set for (F-601-e). A
  /// Grant whose end no longer matches it — renewed, or never checked — is
  /// due again from the new end's levels; nothing else resets the clock.
  endNoticeFor          DateTime?
  /// When the current `endsAt` was set (F-601-r, ADR-0097): at issue, and by
  /// every write that moves the end — a renewal, an admin's days. An unfreeze
  /// does not: it gives back time the user already had. Its span to `endsAt`
  /// decides which time levels are news. Null only for a permanent Grant.
  endSetAt              DateTime?
  /// The next 7 / 3 / 1-day level of that end (F-601-e); null once the last
  /// is told. Read only while `endNoticeFor = endsAt`.
  endNoticeAt           DateTime?
  /// A usage level crossed and not yet told (F-601-n): 50 or 80, held up to
  /// 24 h for a time level, so two due the same day are one message. 95 is
  /// never held. Null when nothing is held.
  usageNoticeLevel      Int?
  /// When the period's first untold crossing happened: the hold's start. A
  /// value before the current usage period opened is stale, never told.
  usageNoticeSince      DateTime?
  /// When a metered Grant's wallet was last told it buys under a GB (F-601-g):
  /// set by the block purchase that saw the crossing, cleared by the first one
  /// that sees the balance buy a GB again. Null = armed. The notice's `period`.
  lowBalanceNoticeAt    DateTime?
  /// The `suspendedAt` whose purge the owner was told of, a day before it
  /// (F-601-j). A suspension that no longer matches it is due again; nothing
  /// resets it. Written conditionally on the value read, so it is told once.
  purgeNoticeFor        DateTime?
  /// The "trouble connecting?" check-in (F-601-l): 7 days after the last
  /// charge that consumed a byte, moved by every such charge (metering), and
  /// cleared by the check. Null = never used, or already asked this stretch.
  idleCheckAt           DateTime?
  /// The usage period (`usagePeriodStartedAt ?? startsAt`) whose exhaustion
  /// forecast was told (F-602): "at this rate, your volume runs out in N days".
  /// A period that no longer matches it can be told again; written
  /// conditionally on the value read, so each period is told once.
  forecastNoticeFor     DateTime?
  /// The plan's period in days, copied from the variant at issue as `quotas`
  /// is (F-311-d): what an admin's renewal of "one more period" adds, so a
  /// catalog edit after the sale never changes it. Null = permanent, or a
  /// Grant issued without a variant (`migration`).
  periodDays            Int?
  /// When a timed admin freeze ends by itself (F-311-h): the hourly sweep
  /// unfreezes it then. Null = not frozen, or frozen until the admin unfreezes
  /// it. Only on a frozen Grant (`grant_frozen_until_is_frozen`).
  frozenUntil           DateTime?
  /// Frozen because an evict left it with no line (F-027-eg): the drain sweep
  /// unfreezes it once its group has a healthy member again. A trigger clears
  /// it whenever the Grant stops being `admin_frozen`, so an admin's own later
  /// freeze is never lifted by the sweep.
  awaitingPanel         Boolean            @default(false)
  /// How a frozen Grant was frozen (F-0401-a), set at the freeze; only on a
  /// frozen Grant — a trigger clears it, and `freezeStopsClock`, whenever the
  /// Grant stops being one (`grant_freeze_mode_is_frozen`).
  freezeMode            FreezeMode?
  /// Whether this freeze stopped the clock, fixed at the freeze: the unfreeze
  /// moves `endsAt` by the frozen span only when it did. A self-freeze takes
  /// the tenant's setting then (F-0401-b); an admin's always stops it.
  freezeStopsClock      Boolean?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @default(now()) @updatedAt

  user             User              @relation(fields: [userId], references: [id])
  variant          ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: Restrict)
  panelGroup       PanelGroup?       @relation(fields: [panelGroupId], references: [id], onDelete: Restrict)
  quotaAdjustments QuotaAdjustment[]
  durationChanges  GrantDurationChange[]
  renewals         GrantRenewal[]
  linkResets       GrantLinkReset[]
  legacySubLinks   LegacySubLink[]
  meters           GrantMeter[]
  wholesale        GrantWholesale?
  spendingCap      SpendingCap?
  deletion         GrantDeletion?
  configs          Config[]
  leaseClose       LeaseClose?
  rateLimit        GrantRateLimit?

  @@unique([tenantId, remoteIdentity])
  @@index([tenantId, userId])
  @@index([userId, status])
  /// A group's Grants: the due scan, drain and a group's delete (F-027-er).
  @@index([panelGroupId])
  /// The purge job's only question: which suspended Grants are now due (F-027-y).
  @@index([status, suspendedAt], map: "grant_status_suspendedAt_idx")
  /// The delivery sweep's only question: which `pending` Grants are due a check (F-111-d).
  @@index([status, nextDeliveryAt], map: "grant_status_nextDeliveryAt_idx")
  /// The "not connected yet?" sweep's only question: which active Grants are due a check (F-601-c).
  @@index([status, unusedCheckAt], map: "grant_status_unusedCheckAt_idx")
  /// The time-threshold sweep's question: which active Grants end within 7 days (F-601-e).
  @@index([status, endsAt], map: "grant_status_endsAt_idx")
  /// The idle check-in sweep's only question: which active Grants are due one (F-601-l).
  @@index([status, idleCheckAt], map: "grant_status_idleCheckAt_idx")
  /// The same sweep's other question: which held usage notices are 24 h old (F-601-n).
  @@index([status, usageNoticeSince], map: "grant_status_usageNoticeSince_idx")
  /// The unfreeze sweep's only question: which timed freezes are due (F-311-h).
  @@index([status, frozenUntil], map: "grant_status_frozenUntil_idx")
  @@map("grant")
  @@schema("entitlement")
}

/// An admin moved a Grant's end (F-311-i). Duration is `endsAt`, not a quota
/// metric (§4.5), so its history is its own: who, from which end, to which,
/// and why. History: a trigger refuses any update or delete. `actorUserId` has
/// no foreign key — the admin may be the platform's staff, another tenant's user.
model GrantDurationChange {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  grantId      String   @db.Uuid
  actorUserId  String   @db.Uuid
  endsAtBefore DateTime
  endsAtAfter  DateTime
  reason       String
  createdAt    DateTime @default(now())

  grant Grant @relation(fields: [grantId], references: [id])

  @@index([grantId, createdAt])
  @@index([tenantId])
  @@map("grant_duration_change")
  @@schema("entitlement")
}

/// An admin renewed a Grant in place (F-311-d): `renewGrant` with
/// `source = admin_grant`. One row per request (`requestId` unique), so a
/// repeat answers the first renewal instead of giving a second period. Days
/// alone leave no `quota_adjustment` row, so this is the renewal's record:
/// who, whether it was the plan's period or typed, what was added, what was
/// forgiven, and the Grant before and after. History: a trigger refuses any
/// update or delete. No foreign key on the actor (may be the platform's staff).
model GrantRenewal {
  id                   String    @id @default(uuid()) @db.Uuid
  tenantId             String    @db.Uuid
  grantId              String    @db.Uuid
  requestId            String    @unique @db.Uuid
  actorUserId          String    @db.Uuid
  /// One period of the plan the user bought (true) or the amount the admin typed.
  plan                 Boolean
  bytes                BigInt
  days                 Int
  forgivenBytes        BigInt
  purchasedBytesBefore BigInt
  purchasedBytesAfter  BigInt
  endsAtBefore         DateTime?
  endsAtAfter          DateTime?
  reason               String?
  createdAt            DateTime  @default(now())

  grant Grant @relation(fields: [grantId], references: [id])

  @@index([grantId, createdAt])
  @@index([tenantId])
  @@map("grant_renewal")
  @@schema("entitlement")
}

/// The owner reset a Grant's subscription link (F-114-e-d): one row per reset
/// on the owner's path, so at most 3 fall in any 24 hours (`link-reset.ts`).
/// Staff and a reseller's admin write none — theirs are in the admin audit log.
/// History: a trigger refuses any update or delete.
model GrantLinkReset {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  grantId   String   @db.Uuid
  createdAt DateTime @default(now())

  grant Grant @relation(fields: [grantId], references: [id])

  @@index([grantId, createdAt])
  @@index([tenantId])
  @@map("grant_link_reset")
  @@schema("entitlement")
}

/// An admin deleted a Grant (F-311-m): it is `cancelled` (`admin_deleted`) and
/// its configs `absent`; this is the record of the admin's choice — whether the
/// remainder went back to the wallet (F-027-r), why, and what was credited
/// (user, 2026-09-26). One per Grant; history: a trigger refuses any update or
/// delete. No foreign key on the actor (may be the platform's staff) or the
/// wallet row (another domain's).
model GrantDeletion {
  id                  String      @id @default(uuid()) @db.Uuid
  tenantId            String      @db.Uuid
  grantId             String      @unique @db.Uuid
  actorUserId         String      @db.Uuid
  reason              String
  statusBefore        GrantStatus
  refundRemainder     Boolean
  /// Whole cents credited back; with `walletTransactionId`, only when asked.
  refundedAmount      Decimal?    @db.Decimal(20, 4)
  walletTransactionId String?     @db.Uuid
  /// A refund asked for that credited nothing: F-027-r's reason (prepaid, all served).
  refundSkipped       String?
  createdAt           DateTime    @default(now())

  grant Grant @relation(fields: [grantId], references: [id])

  @@index([tenantId])
  @@map("grant_deletion")
  @@schema("entitlement")
}

/// A signed change to one quota metric of a Grant (§4.4, C-09 rollover). History:
/// a trigger refuses any update or delete.
model QuotaAdjustment {
  id               String      @id @default(uuid()) @db.Uuid
  tenantId         String      @db.Uuid
  grantId          String      @db.Uuid
  metric           QuotaMetric
  delta            BigInt
  source           GrantSource
  /// Rollover only: the most of the old Grant's remainder carried, in percent.
  capPercent       Int?
  expiresAt        DateTime?
  reason           String?
  createdByAdminId String?     @db.Uuid
  createdAt        DateTime    @default(now())

  grant Grant @relation(fields: [grantId], references: [id])

  @@index([grantId])
  @@index([tenantId])
  @@map("quota_adjustment")
  @@schema("entitlement")
}

// =============================================================================

/// A meter this Grant was sold with (F-118-e, ADR-0105 decision 4): the rate
/// card in effect at the sale, copied beside the quotas (ADR-0073) — a
/// catalog change never reprices it. One row per meter; the terms never change
/// (`grant_meter_terms_are_locked`), only the counters — and the price with
/// its currency, when the tenant's currency changes (F-118-l).
///
/// Counters are in the meter's unit. `consumed` is what was used, `billed` the
/// rating cursor (how far the money has been taken), `funded` what is paid or
/// held for. A `vpn.traffic` meter is a metered VPN Grant's rate and money
/// cursor (F-118-l): per 2^30 bytes, its `consumed` read off the Grant's
/// `consumedBytes` and its bag `purchasedBytes`. A package plan has no row (decision 0).
model GrantMeter {
  id               String                @id @default(uuid()) @db.Uuid
  tenantId         String                @db.Uuid
  grantId          String                @db.Uuid
  /// A `Meter.key` (`METER_KEYS`).
  meterKey         String
  /// The card copied. No foreign key: a card goes with its variant, the sale does not.
  rateCardId       String?               @db.Uuid
  unitSize         BigInt
  unitPrice        Decimal               @db.Decimal(18, 8)
  currencyCode     String
  mode             RateCardMode
  includedQuantity BigInt
  afterIncluded    RateCardAfterIncluded
  consumed         BigInt                @default(0)
  billed           BigInt                @default(0)
  funded           BigInt                @default(0)
  /// The wholesale leg (F-118-n2, ADR-0105 decision 10): on a reseller's
  /// Grant, who pays the platform and the package rate in force at the sale
  /// (`tenant_package_meter_rate`, recorded not keyed), in the platform's
  /// currency. All five set or none (`grant_meter_wholesale_whole`); locked
  /// like the retail terms. The platform's own Grants carry none.
  wholesalePayerTenantId String?         @db.Uuid
  wholesaleRateId        String?         @db.Uuid
  wholesaleUnitSize      BigInt?
  wholesaleUnitPrice     Decimal?        @db.Decimal(18, 8)
  wholesaleCurrencyCode  String?
  /// The wholesale rating cursor, in the meter's unit: over `consumed`, or on
  /// `vpn.traffic` over `wholesaleConsumed`.
  wholesaleBilled        BigInt          @default(0)
  /// `vpn.traffic` only (F-118-n6, ADR-0105 decision 10): the bytes of this
  /// Grant served on platform-owned panels — what the reseller owes wholesale
  /// for. Bytes on its own panels are in `grant.consumedBytes` and not here.
  /// Advanced by `metering-service` beside that cursor; zero with no wholesale leg.
  wholesaleConsumed      BigInt          @default(0)
  /// `vpn.traffic` only (F-118-ac, D-59 (f)): the bytes platform staff gifted
  /// this Grant. They are in `wholesaleBilled` at no charge — the reseller
  /// never owes them — and at close they are unused before its own, so never
  /// given back as money. A reseller staff's gift is bought and not here.
  wholesaleGifted        BigInt          @default(0)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @default(now()) @updatedAt

  grant  Grant        @relation(fields: [grantId], references: [id])
  meter  Meter        @relation(fields: [meterKey], references: [key], onDelete: Restrict, onUpdate: Restrict)
  events UsageEvent[]
  authorizations UsageAuthorization[]

  @@unique([grantId, meterKey])
  @@index([tenantId])
  @@map("grant_meter")
  @@schema("entitlement")
}

/// A reseller's package plan, bought wholesale (F-118-p, ADR-0105 decision 0
/// amended 2026-09-29): a plan paid in full has no meter, so the platform's
/// charge for its bytes lives here — one row per such Grant, written at issue.
/// The package's `vpn.traffic` rate in force at the sale is locked (recorded,
/// not keyed), in the platform's currency; only the two cursors move.
/// `billed` is the bytes the reseller paid for; `consumed` the bytes of the
/// Grant served on platform-owned panels, advanced by `metering-service`.
/// The platform's own Grants and metered Grants carry none. An unlimited plan
/// locks `vpn.unlimited.time` instead and buys its days (F-118-z): `billed`
/// counts seconds, `consumed` stays 0.
model GrantWholesale {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  grantId       String   @unique @db.Uuid
  payerTenantId String   @db.Uuid
  rateId        String   @db.Uuid
  /// `vpn.traffic` (bytes) or `vpn.unlimited.time` (seconds): the rate locked.
  meterKey      String   @default("vpn.traffic")
  unitSize      BigInt
  unitPrice     Decimal  @db.Decimal(18, 8)
  currencyCode  String
  billed        BigInt   @default(0)
  consumed      BigInt   @default(0)
  /// The bag a plan sold before its leg still held when the leg was locked at its renewal (F-118-ab): counted in `billed`, never charged, never given back.
  inherited     BigInt   @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  grant Grant @relation(fields: [grantId], references: [id])

  @@index([tenantId])
  @@map("grant_wholesale")
  @@schema("entitlement")
}

/// How many open metered Grants a user of this tenant may buy (F-118-ao).
/// One row per tenant; none = the platform's default (`PLATFORM_METERED_CAP`).
model GrantLimitSetting {
  tenantId        String   @id @db.Uuid
  /// Open = `pending`, `active` or `suspended`. >= 0 (CHECK); 0 sells none.
  meteredOpenCap  Int
  updatedByUserId String?  @db.Uuid
  updatedAt       DateTime @updatedAt

  @@map("grant_limit_setting")
  @@schema("entitlement")
}

/// A tenant's freeze switches (F-0401-b). One row per tenant; none = the
/// platform's defaults (`SELF_FREEZE_DEFAULTS`): self-freeze on, clock running.
model GrantFreezeSetting {
  tenantId             String   @id @db.Uuid
  /// Whether this tenant's users may freeze their own metered Grant.
  selfFreezeEnabled    Boolean
  /// Whether a self-freeze stops the clock; copied onto the Grant at the
  /// freeze (`grant.freezeStopsClock`), so a change never moves a frozen one.
  selfFreezeStopsClock Boolean
  updatedByUserId      String?  @db.Uuid
  updatedAt            DateTime @updatedAt

  @@map("grant_freeze_setting")
  @@schema("entitlement")
}

/// How much a `grant.compensate` holder may add to one Grant over a rolling
/// 30 days (KS-1-c, ADR-0140 (2)), set by a `grant.assign` holder. One row per
/// tenant; none = the platform's default (`PLATFORM_COMPENSATION_CAP`). 0 closes that kind.
model GrantCompensationCap {
  tenantId        String   @id @db.Uuid
  /// >= 0 (CHECK).
  days            Int
  /// >= 0 (CHECK).
  bytes           BigInt
  updatedByUserId String?  @db.Uuid
  updatedAt       DateTime @updatedAt

  @@map("grant_compensation_cap")
  @@schema("entitlement")
}

/// One compensation given (KS-1-c): what the cap counts. Never edited; the act
/// itself is audited beside it (`grant_duration_change` / `grant_traffic_*`).
model GrantCompensation {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  grantId     String   @db.Uuid
  actorUserId String   @db.Uuid
  reason      String
  /// One of the two is > 0, the other 0 (CHECK).
  days        Int      @default(0)
  bytes       BigInt   @default(0)
  createdAt   DateTime @default(now())

  @@index([grantId, createdAt])
  @@map("grant_compensation")
  @@schema("entitlement")
}

/// What an import brings (F-201-a, D-63): a whole source panel, one old
/// subscription link, or a balances CSV.
enum MigrationRunKind {
  panel
  link
  csv

  @@schema("entitlement")
}

/// `draft → previewing → previewed → committing → committed → rolling_back →
/// rolled_back`; before the commit a run may be `cancelled` or `expired`. A
/// trigger holds it (`migration_run_status_moves`).
enum MigrationRunStatus {
  draft
  previewing
  previewed
  committing
  committed
  rolled_back
  cancelled
  expired
  /// The reseller asked for a rollback inside its window (F-211): undone a batch a tick.
  rolling_back

  @@schema("entitlement")
}

/// What the dry run plans for one source client (F-206).
enum MigrationItemAction {
  create
  update
  skip

  @@schema("entitlement")
}

/// Why the dry run skips a source client (F-206's report).
enum MigrationSkipReason {
  expired
  duplicate
  over_cap
  unknown_protocol
  /// The snapshot answered the client in a shape the import does not take (F-206).
  unreadable
  /// An unlimited client on a limited product, or the other way round (F-208).
  traffic_mismatch

  @@schema("entitlement")
}

/// What the commit did with one item (F-207); `pending` until it reaches it.
enum MigrationItemOutcome {
  pending
  created
  updated
  skipped
  failed
  rolled_back
  /// The rollback left it: its customer renewed, topped up or bought since (F-211, `keptReason`).
  kept

  @@schema("entitlement")
}

/// One import a reseller runs (F-201-a, D-63). Nothing outside this table and
/// its items is written before the commit; the counts are the dry run's report
/// and the commit's progress. No foreign key on the actor (may be staff).
model MigrationRun {
  id             String             @id @default(uuid()) @db.Uuid
  tenantId       String             @db.Uuid
  kind           MigrationRunKind
  /// The source panel's family; only on a `panel` run.
  sourceFamily   DriverType?
  /// The source's origin as read (`scheme://host[:port]`); on a `link` run the whole old link (F-201-g); null on a `csv` run.
  sourceAddress  String?
  /// The person a `link` run is for, and only on one (`migration_run_link_names_its_person`, F-201-g). No foreign key: identity's.
  userId         String?            @db.Uuid
  /// The prepaid variant a `link` run's client becomes, chosen by the admin (F-201-g); a panel run maps inbounds instead.
  variantId      String?            @db.Uuid
  status         MigrationRunStatus @default(draft)
  plannedCreate  Int                @default(0)
  plannedUpdate  Int                @default(0)
  plannedSkip    Int                @default(0)
  committedItems Int                @default(0)
  failedItems    Int                @default(0)
  /// The end of the rollback window (D-63: 7 days), set by the commit.
  rollbackUntil  DateTime?
  /// Why the last preview went back to `draft`: the source's refusal or `inbounds_unmapped` (F-206).
  failureReason  String?
  /// The drain's lease on the run (F-206, F-207): two ticks never read the source or commit it at once.
  workerClaimedAt DateTime?
  actorUserId    String             @db.Uuid
  /// Who asked for the rollback (F-211); no foreign key, may be staff.
  rollbackActorUserId String?       @db.Uuid
  /// When the window ended and the items' snapshots were cleared (F-211); null while they are kept.
  snapshotsPurgedAt DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  items    MigrationItem[]
  inbounds MigrationInbound[]

  /// The item's composite foreign key: an item is its run's tenant's.
  @@unique([id, tenantId])
  @@index([tenantId, createdAt])
  @@map("migration_run")
  @@schema("entitlement")
}

/// One source client in a run (F-201-a): its snapshot as read — the source
/// state a rollback restores from (F-211) — what the dry run planned, and what
/// the commit created. One per `remoteIdentity` in a run; across runs the
/// Grant's own `remoteIdentity` is the key. No foreign keys on the created ids:
/// the item is the record of them after a rollback removes them.
model MigrationItem {
  id               String               @id @default(uuid()) @db.Uuid
  runId            String               @db.Uuid
  tenantId         String               @db.Uuid
  remoteIdentity   String
  /// The normalised source client (F-201-b), never edited after the preview; null once its run's window ended (F-211).
  sourceSnapshot   Json?
  plannedAction    MigrationItemAction
  skipReason       MigrationSkipReason?
  outcome          MigrationItemOutcome @default(pending)
  /// Why the commit failed this item; the batch goes on (F-207).
  failureReason    String?
  createdUserId    String?              @db.Uuid
  createdGrantId   String?              @db.Uuid
  createdConfigIds String[]             @default([]) @db.Uuid
  /// Why the rollback kept the item (`renewed`, `topped_up`, `bought`, …), or why its person stayed (F-211).
  keptReason       String?
  /// A link run's admin over what the link said (F-201-g): null keeps the read figure; the snapshot is never edited.
  correctedDataLimitBytes BigInt?
  correctedUsedBytes      BigInt?
  correctedExpiresAt      DateTime?
  /// The rollback is done with the item, its person included (F-211).
  rolledBackAt     DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  run MigrationRun @relation(fields: [runId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([runId, remoteIdentity])
  @@index([runId, plannedAction])
  @@index([tenantId])
  @@map("migration_item")
  @@schema("entitlement")
}

/// One inbound of a run's source as the snapshot read it (F-206), and the
/// reseller's prepaid variant its clients become — a product, not a server
/// (user, 2026-10-21), so an imported Grant renews as any other. Null until
/// chosen; no foreign key, the variant is checked when it is chosen.
model MigrationInbound {
  id              String   @id @default(uuid()) @db.Uuid
  runId           String   @db.Uuid
  tenantId        String   @db.Uuid
  inboundRemoteId String
  tag             String   @default("")
  protocol        String   @default("")
  /// The snapshot's clients on it; an inbound with none needs no variant.
  clientCount     Int      @default(0)
  variantId       String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  run MigrationRun @relation(fields: [runId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([runId, inboundRemoteId])
  @@index([tenantId])
  @@map("migration_inbound")
  @@schema("entitlement")
}

/// An imported user's old subscription link (F-203-a): the host and path the
/// source panel served it at, so `sub-service` keeps answering it with the
/// Grant's current subscription once the old host points here (F-203-b,
/// F-204). Written by the commit, removed by the rollback and by a link
/// reset; one Grant per path in a tenant.
model LegacySubLink {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  /// Normalised as `normalizeHost` (lowercase, no port, no root dot).
  host            String
  /// Decoded, without its trailing slash; never the bare root.
  path            String
  grantId         String   @db.Uuid
  /// The import's item that captured it.
  migrationItemId String   @db.Uuid
  createdAt       DateTime @default(now())

  grant Grant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, host, path])
  @@index([grantId])
  @@map("legacy_sub_link")
  @@schema("entitlement")
}
