// Schema `entitlement` — what a user holds (F-026-b, D-34, ADR-0049).
// Spec: `tools/spec.py --section 4.4` .. `4.6`.
// =============================================================================

/// Why a Grant exists (§4.4).
enum GrantSource {
  purchase
  admin_grant
  coupon
  affiliate_reward
  migration
  trial
  rollover

  @@schema("entitlement")
}

/// `pending → active → (suspended | exhausted | expired | cancelled)`; only
/// `suspended → active` goes back. A trigger holds it (`grant_status_one_way`).
enum GrantStatus {
  pending
  active
  suspended
  exhausted
  expired
  cancelled

  @@schema("entitlement")
}

enum SharingPolicy {
  exclusive
  shared_pool

  @@schema("entitlement")
}

/// The countable quota metrics (§4.5). Duration is `endsAt`, not a metric.
enum QuotaMetric {
  traffic_bytes
  concurrent_devices
  order_units
  feature_items
  api_calls

  @@schema("entitlement")
}

/// One entitlement: "does an active Grant with this feature key exist?" is the
/// only access question (§4.4). Quotas, duration and feature keys are copied
/// from the variant at issue, so a later catalog edit never changes what was
/// sold. Strictly tenant-scoped: never shared-read.
model Grant {
  id                    String             @id @default(uuid()) @db.Uuid
  tenantId              String             @db.Uuid
  userId                String             @db.Uuid
  /// The variant it was issued from; null for one issued without a catalog item (`migration`).
  variantId             String?            @db.Uuid
  source                GrantSource
  /// What issued it — the payment, the coupon redemption, the admin action. With
  /// `source`, unique when set, so issuing twice for one cause is refused.
  sourceReferenceId     String?            @db.Uuid
  status                GrantStatus        @default(pending)
  statusReason          String?
  startsAt              DateTime
  /// Null = permanent.
  endsAt                DateTime?
  billingMode           VariantBillingMode
  featureKeys           String[]           @default([])
  /// Per metric, copied from the variant: `{"traffic_bytes": {"limit": ..., "resetPolicy": "none"}}`.
  quotas                Json               @default("{}")
  sharingPolicy         SharingPolicy      @default(exclusive)
  /// SHA-256 of the subscription token, lowercase hex: what `/sub` looks a Grant up by.
  subscriptionTokenHash String             @unique
  /// The same token sealed, `{kekId, iv, authTag, ciphertext}` (AES-256-GCM under a
  /// key derived from the vault KEK, ADR-0085), so My services can show the link
  /// again. Null for a Grant from before it, or issued with no KEK loaded.
  subscriptionTokenSealed Json?
  tokenRotatedAt        DateTime           @default(now())
  /// Billing cursor for metered usage: how far the money has been taken.
  billedBytes           BigInt             @default(0)
  /// What the panels have reported (F-027-n). Measured, not paid for: a panel
  /// whose limit was overridden can report past the ceiling, and that gap is
  /// what the holds queue exists to settle (ADR-0074).
  consumedBytes         BigInt             @default(0)
  /// What has been bought (ADR-0072). `Σ ceilings ≤ purchasedBytes` across
  /// every config of this Grant — this is the number the allocator is bounded
  /// by, which is why it is not folded into `billedBytes`.
  purchasedBytes        BigInt             @default(0)
  /// Price per 2^30 bytes, copied from the variant's rate history at issue
  /// (ADR-0073), exactly as `quotas` and `featureKeys` are. Null unless
  /// `billingMode = metered`. `(18, 8)` because a rate is not an amount: every
  /// amount derived from it is still whole cents before the ledger (C-02).
  meteredRate           Decimal?           @db.Decimal(18, 8)
  /// Sold with `traffic_bytes.limit = 0` (F-111-q): no ceiling, never
  /// exhausted, never buys a block. The catalog is the only place 0 means
  /// unlimited; here the bag stays 0 and this says why. Only on a prepaid
  /// Grant, and only with `purchasedBytes = 0` (`grant_traffic_unlimited_is_prepaid`).
  trafficUnlimited      Boolean            @default(false)
  /// When the owner's open page was last told `consumedBytes`
  /// (`entitlement.grant.usage`, F-307-t). A throttle, not a record: metering
  /// claims the next slot in the charge's own transaction, 30 s after this.
  usagePushedAt         DateTime?
  /// When the bag ran empty (ADR-0075). Starts the purge clock; cleared when a
  /// top-up returns the Grant to `active`.
  suspendedAt           DateTime?
  /// Per-Grant override of the tenant's purge window. Null = use
  /// `tenant.purgeAfterDays`; `0` = never purge.
  purgeAfterDays        Int?
  /// The owning reseller node (C-15). Always null until reseller nodes exist (F-901).
  resellerPath          String?
  issuedByAdminId       String?            @db.Uuid
  /// Delivery of a paid Grant (F-111-d, spec §5.8 step 3): the checks that
  /// found it not yet delivered, and when the next one is due. Null = due now.
  /// Only a `pending` Grant is ever checked; the clock is left as it stood.
  deliveryAttempts      Int                @default(0)
  nextDeliveryAt        DateTime?
  /// When it first turned `active` — at delivery for a purchase, at `startsAt`
  /// for any other source (F-601-c). Null for a Grant from before it.
  activatedAt           DateTime?
  /// The next "not connected yet?" check (F-601-c): 24 h after activation,
  /// then 72 h; null once told twice, once anything was consumed, or never for
  /// a `migration` / `rollover` Grant. A clock, as `nextDeliveryAt` is.
  unusedCheckAt         DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @default(now()) @updatedAt

  user             User              @relation(fields: [userId], references: [id])
  variant          ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quotaAdjustments QuotaAdjustment[]
  configs          Config[]
  leaseClose       LeaseClose?

  @@index([tenantId, userId])
  @@index([userId, status])
  /// The purge job's only question: which suspended Grants are now due (F-027-y).
  @@index([status, suspendedAt], map: "grant_status_suspendedAt_idx")
  /// The delivery sweep's only question: which `pending` Grants are due a check (F-111-d).
  @@index([status, nextDeliveryAt], map: "grant_status_nextDeliveryAt_idx")
  /// The "not connected yet?" sweep's only question: which active Grants are due a check (F-601-c).
  @@index([status, unusedCheckAt], map: "grant_status_unusedCheckAt_idx")
  @@map("grant")
  @@schema("entitlement")
}

/// A signed change to one quota metric of a Grant (§4.4, C-09 rollover). History:
/// a trigger refuses any update or delete.
model QuotaAdjustment {
  id               String      @id @default(uuid()) @db.Uuid
  tenantId         String      @db.Uuid
  grantId          String      @db.Uuid
  metric           QuotaMetric
  delta            BigInt
  source           GrantSource
  /// Rollover only: the most of the old Grant's remainder carried, in percent.
  capPercent       Int?
  expiresAt        DateTime?
  reason           String?
  createdByAdminId String?     @db.Uuid
  createdAt        DateTime    @default(now())

  grant Grant @relation(fields: [grantId], references: [id])

  @@index([grantId])
  @@index([tenantId])
  @@map("quota_adjustment")
  @@schema("entitlement")
}

// =============================================================================
