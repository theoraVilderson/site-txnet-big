// بخش چهار: Schema `currency` — سیستم چندارزی
// =============================================================================
// قانون طلایی: هیچ مبلغی در بیش از یک ارز/ستون ذخیره نمی‌شود. ارز انتخابی
// کاربر/ادمین فقط یک لایه‌ی نمایش است؛ تبدیل فقط لحظه‌ی نمایش انجام می‌شود.

enum RateSource {
  manual_admin
  external_api

  @@schema("currency")
}

enum PolicyScope {
  global
  user

  @@schema("currency")
}

/// 3.1 — دقیقاً یک رکورد باید isBaseCurrency=true باشد (CHECK/Trigger بخش ۹۹).
model Currency {
  id                 String  @id @default(uuid()) @db.Uuid
  code               String  @unique // ISO 4217 (IRR, USD, EUR) یا کد داخلی (IRT)
  name               String
  symbol             String
  decimalPlaces      Int     @default(0)
  isBaseCurrency     Boolean @default(false)
  isSelectableByUser Boolean @default(true)
  isActive           Boolean @default(true)

  exchangeRates       CurrencyExchangeRate[]
  userPreferences     UserCurrencyPreference[]
  enforcedByPolicies  CurrencyPolicy[]

  @@map("currency")
  @@schema("currency")
}

/// 3.2 — Append-only؛ هر تغییر نرخ رکورد جدید است، نه ویرایش قبلی
/// (کش می‌شود در Redis با کلید fx:rate:{currencyCode}).
model CurrencyExchangeRate {
  id             String     @id @default(uuid()) @db.Uuid
  currencyId     String     @db.Uuid
  rate           Decimal    @db.Decimal(18, 8) // نرخ تبدیل از ارز پایه به این ارز
  source         RateSource
  setByAdminId   String?    @db.Uuid // فقط اگر source=manual_admin
  effectiveAt    DateTime   @default(now())
  isActive       Boolean    @default(true)
  /// F-0608-a (ADR-0101): why a person pinned this rate, and until when it
  /// applies. Both set on a `manual_admin` row and only there (a CHECK holds
  /// it); a discovered rate has neither.
  reason         String?
  expiresAt      DateTime?
  /// F-116-j (ADR-0098 part 9): the tenant whose books a pin prices; null for
  /// the platform's pin and for every discovered rate (a CHECK holds it). No
  /// FK: `tenant` rows are never deleted, and a relation would reach across
  /// into the tenant schema for a column only readers filter on.
  tenantId       String?    @db.Uuid
  /// Set when the pin was ended before `expiresAt` — its own row, so the
  /// rate itself is never edited (invariant #3).
  pinEnd         CurrencyRatePinEnd?

  currency Currency @relation(fields: [currencyId], references: [id])
  // The payments priced at this reading (F-0606-b), as the charge currency's
  // leg or the payment currency's (F-116-e). Append-only: a row with payments
  // behind it cannot be deleted.
  payments     PaymentTransaction[] @relation("PaymentRateToLeg")
  paymentsFrom PaymentTransaction[] @relation("PaymentRateFromLeg")
  couponRedemptions     CouponRedemption[] @relation("CouponRedemptionRateToLeg")
  couponRedemptionsFrom CouponRedemption[] @relation("CouponRedemptionRateFromLeg")

  @@index([currencyId, effectiveAt(sort: Desc)])
  @@index([currencyId, tenantId, effectiveAt(sort: Desc)])
  @@map("currency_exchange_rate")
  @@schema("currency")
}

/// F-0608-a (ADR-0101) — a pinned rate ended before its expiry. One per pin,
/// insert-only: the pin row keeps its rate and its expiry as written, and this
/// says who ended it and when.
model CurrencyRatePinEnd {
  id        String   @id @default(uuid()) @db.Uuid
  rateId    String   @unique @db.Uuid
  endedById String   @db.Uuid
  endedAt   DateTime @default(now())

  rate CurrencyExchangeRate @relation(fields: [rateId], references: [id], onDelete: Restrict)

  @@map("currency_rate_pin_end")
  @@schema("currency")
}

/// 3.3 — ترجیح ارز نمایشی کاربر (هر کاربر یک ترجیح فعال).
model UserCurrencyPreference {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @unique @db.Uuid
  preferredCurrencyId  String   @db.Uuid
  updatedAt            DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  currency Currency @relation(fields: [preferredCurrencyId], references: [id])

  @@map("user_currency_preference")
  @@schema("currency")
}

/// 3.4 — قفل سطح ادمین روی ارز نمایشی (global یا یک user خاص).
/// ترتیب Resolve: user-lock > global-lock > UserCurrencyPreference > ارز پایه.
model CurrencyPolicy {
  id                  String      @id @default(uuid()) @db.Uuid
  scope               PolicyScope
  userId              String?     @db.Uuid // فقط وقتی scope=user
  isLocked            Boolean     @default(false)
  enforcedCurrencyId  String?     @db.Uuid
  setByAdminId        String      @db.Uuid
  updatedAt           DateTime    @updatedAt

  enforcedCurrency Currency? @relation(fields: [enforcedCurrencyId], references: [id])

  // یونیک (scope, userId) — برای scope=global مقدار userId باید NULL و یکتا
  // باشد؛ اجرای دقیق این محدودیت نیازمند Partial Unique Index است (بخش ۹۹).
  @@unique([scope, userId])
  @@map("currency_policy")
  @@schema("currency")
}

