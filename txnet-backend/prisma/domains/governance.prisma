// بخش هشت: Schema `governance` — تنظیمات، محدودیت کاربر، گروه‌ها
// =============================================================================

enum SettingCategory {
  notification
  privacy
  security
  display
  billing
  other

  @@schema("governance")
}

/// 9.1 — تنظیمات Key-Value کم‌مصرف؛ هر Feature جدید فقط یک key جدید در کد.
model UserSetting {
  id        String          @id @default(uuid()) @db.Uuid
  userId    String          @db.Uuid
  category  SettingCategory
  key       String // notify.telegram.low_balance, security.require_otp_on_transfer
  value     Json
  updatedAt DateTime        @updatedAt

  @@unique([userId, key])
  @@map("user_setting")
  @@schema("governance")
}

/// F-030-d (§3.9) — a cap or a bar on one person, one row per person and key
/// (`USER_RESTRICTIONS` in shared-core says which keys exist and what each
/// value is). Not the `restricted` status (ADR-0133). Lifting one deletes its
/// row; the audit trail keeps what it was. Strict RLS on the person's tenant.
model UserRestriction {
  userId      String    @db.Uuid
  tenantId    String    @db.Uuid
  key         String    @db.VarChar(64)
  /// A count, or the barred options sorted — as the key's kind reads it.
  value       Json
  /// Why, as staff wrote it; kept in the audit row too.
  reason      String    @db.VarChar(500)
  setByUserId String    @db.Uuid
  /// Null: until lifted. Past it the restriction counts for nothing (`liveRestriction`).
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@id([userId, key])
  @@index([tenantId])
  @@map("user_restriction")
  @@schema("governance")
}

// =============================================================================

/// Who is a member of a user group (F-114-j): a person, or — in the platform
/// owner's groups only — a whole reseller.
enum UserGroupMemberType {
  user
  tenant

  @@schema("governance")
}

/// How a group's members are decided. `manual` alone today: an admin adds
/// and removes them. A computed kind is a new value here, never a new table —
/// consumers ask `user-group.ts`, not the member rows (F-114-j).
enum UserGroupKind {
  manual

  @@schema("governance")
}

/// F-114-j — a named set of one tenant's users, the one target discount rules
/// (F-114-h), campaigns and restrictions share. Every group is exactly one
/// tenant's (strict RLS). The platform owner's groups may also hold resellers,
/// another tenant's users, or every reseller at once (`allTenants`) — a
/// trigger refuses those in any other tenant's group.
model UserGroup {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @db.Uuid
  name             String        @db.VarChar(80)
  kind             UserGroupKind @default(manual)
  /// Platform owner's groups only: every reseller is a member.
  allTenants       Boolean       @default(false)
  createdByAdminId String        @db.Uuid
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @default(now()) @updatedAt
  /// A role whose keys the group's user members hold while members (AC-1-m,
  /// ADR-0138): this tenant's or a template, never one holding `*`.
  roleId           String?       @db.Uuid

  role          Role?                 @relation(fields: [roleId], references: [id], onDelete: Restrict)
  /// Extra keys its user members hold while members (AC-1-m).
  permissions   UserGroupPermission[]
  members       UserGroupMember[]
  discountRules DiscountRule[]
  /// Gateways offered only to this group's users (F-102-g).
  gatewayAudience GatewayAudience[]
  /// Products sold only to this group's users (PT-1-b).
  productAudience ProductAudience[]

  @@unique([tenantId, name])
  /// The composite key members and discount rules point at, so neither can
  /// name another tenant's group.
  @@unique([id, tenantId])
  @@map("user_group")
  @@schema("governance")
}

/// One extra key a group gives its user members (AC-1-m, ADR-0138). Only the
/// group's own tenant's user members hold it; a trigger notifies
/// `{kind:"group"}` so each member's token moves.
model UserGroupPermission {
  groupId      String @db.Uuid
  tenantId     String @db.Uuid
  permissionId String @db.Uuid

  group      UserGroup  @relation(fields: [groupId, tenantId], references: [id, tenantId], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([groupId, permissionId])
  @@index([tenantId])
  @@map("user_group_permission")
  @@schema("governance")
}

/// One member of a group, once. `tenantId` is the group's (the RLS key);
/// exactly one of `userId` / `memberTenantId` is set, by `memberType` (CHECK).
model UserGroupMember {
  id             String              @id @default(uuid()) @db.Uuid
  groupId        String              @db.Uuid
  tenantId       String              @db.Uuid
  memberType     UserGroupMemberType
  userId         String?             @db.Uuid
  memberTenantId String?             @db.Uuid
  addedByAdminId String              @db.Uuid
  createdAt      DateTime            @default(now())
  /// When the membership ends (ADR-0139 (3)); null = no end. An ended one
  /// counts for nothing anywhere membership is asked (`liveMembership`).
  expiresAt      DateTime?

  group UserGroup @relation(fields: [groupId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([groupId, userId])
  @@unique([groupId, memberTenantId])
  @@index([userId])
  @@index([memberTenantId])
  @@index([expiresAt])
  @@map("user_group_member")
  @@schema("governance")
}
