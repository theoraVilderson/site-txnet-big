// بخش هشت: Schema `governance` — تنظیمات، دسترسی زمان‌بندی‌شده، محدودیت کاربر
// =============================================================================

enum SettingCategory {
  notification
  privacy
  security
  display
  billing
  other

  @@schema("governance")
}

enum GrantResourceType {
  config
  feature
  service_plan

  @@schema("governance")
}

enum GrantMode {
  one_time
  recurring_daily

  @@schema("governance")
}

enum RestrictionScope {
  soft_warning
  hard_block

  @@schema("governance")
}

/// 9.1 — تنظیمات Key-Value کم‌مصرف؛ هر Feature جدید فقط یک key جدید در کد.
model UserSetting {
  id        String          @id @default(uuid()) @db.Uuid
  userId    String          @db.Uuid
  category  SettingCategory
  key       String // notify.telegram.low_balance, security.require_otp_on_transfer
  value     Json
  updatedAt DateTime        @updatedAt

  @@unique([userId, key])
  @@map("user_setting")
  @@schema("governance")
}

/// 9.2 — دسترسی زمان‌بندی‌شده (اعطای دسترسی اضافه فراتر از نقش پایه).
model TemporalAccessGrant {
  id               String             @id @default(uuid()) @db.Uuid
  granteeUserId    String             @db.Uuid
  grantedByAdminId String?            @db.Uuid
  permissionKey    String
  resourceType     GrantResourceType?
  resourceId       String?            @db.Uuid
  grantMode        GrantMode
  startAt          DateTime? // فقط one_time
  endAt            DateTime? // فقط one_time
  dailyStartTime   DateTime?          @db.Time // فقط recurring_daily
  dailyEndTime     DateTime?          @db.Time // فقط recurring_daily
  timezone         String             @default("Asia/Tehran")
  validFrom        DateTime?          @db.Date
  validUntil       DateTime?          @db.Date
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())

  @@map("temporal_access_grant")
  @@schema("governance")
}

/// 9.3 — سقف/محدودیت عملکرد و مصرف کاربر (برعکس TemporalAccessGrant).
model UserRestriction {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @db.Uuid
  restrictionKey  String // max_daily_traffic_gb, max_active_configs, max_daily_spend_amount, ...
  limitValueJson  Json
  scope           RestrictionScope
  reason          String?
  setByAdminId    String           @db.Uuid
  isActive        Boolean          @default(true)
  expiresAt       DateTime?
  createdAt       DateTime         @default(now())

  // یونیک منطقی (userId, restrictionKey) فقط روی رکوردهای isActive=true؛
  // در پریزما به‌صورت یونیک ساده تعریف شده، نسخه Partial در بخش ۹۹.
  @@unique([userId, restrictionKey])
  @@index([userId])
  @@map("user_restriction")
  @@schema("governance")
}

// =============================================================================
