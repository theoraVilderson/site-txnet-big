// بخش هشت: Schema `governance` — تنظیمات، دسترسی زمان‌بندی‌شده، محدودیت کاربر
// =============================================================================

enum SettingCategory {
  notification
  privacy
  security
  display
  billing
  other

  @@schema("governance")
}

enum GrantResourceType {
  config
  feature
  service_plan

  @@schema("governance")
}

enum GrantMode {
  one_time
  recurring_daily

  @@schema("governance")
}

enum RestrictionScope {
  soft_warning
  hard_block

  @@schema("governance")
}

/// 9.1 — تنظیمات Key-Value کم‌مصرف؛ هر Feature جدید فقط یک key جدید در کد.
model UserSetting {
  id        String          @id @default(uuid()) @db.Uuid
  userId    String          @db.Uuid
  category  SettingCategory
  key       String // notify.telegram.low_balance, security.require_otp_on_transfer
  value     Json
  updatedAt DateTime        @updatedAt

  @@unique([userId, key])
  @@map("user_setting")
  @@schema("governance")
}

/// 9.2 — دسترسی زمان‌بندی‌شده (اعطای دسترسی اضافه فراتر از نقش پایه).
model TemporalAccessGrant {
  id               String             @id @default(uuid()) @db.Uuid
  granteeUserId    String             @db.Uuid
  grantedByAdminId String?            @db.Uuid
  permissionKey    String
  resourceType     GrantResourceType?
  resourceId       String?            @db.Uuid
  grantMode        GrantMode
  startAt          DateTime? // فقط one_time
  endAt            DateTime? // فقط one_time
  dailyStartTime   DateTime?          @db.Time // فقط recurring_daily
  dailyEndTime     DateTime?          @db.Time // فقط recurring_daily
  timezone         String             @default("Asia/Tehran")
  validFrom        DateTime?          @db.Date
  validUntil       DateTime?          @db.Date
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())

  @@map("temporal_access_grant")
  @@schema("governance")
}

/// 9.3 — سقف/محدودیت عملکرد و مصرف کاربر (برعکس TemporalAccessGrant).
model UserRestriction {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @db.Uuid
  restrictionKey  String // max_daily_traffic_gb, max_active_configs, max_daily_spend_amount, ...
  limitValueJson  Json
  scope           RestrictionScope
  reason          String?
  setByAdminId    String           @db.Uuid
  isActive        Boolean          @default(true)
  expiresAt       DateTime?
  createdAt       DateTime         @default(now())

  // یونیک منطقی (userId, restrictionKey) فقط روی رکوردهای isActive=true؛
  // در پریزما به‌صورت یونیک ساده تعریف شده، نسخه Partial در بخش ۹۹.
  @@unique([userId, restrictionKey])
  @@index([userId])
  @@map("user_restriction")
  @@schema("governance")
}

// =============================================================================

/// Who is a member of a user group (F-114-j): a person, or — in the platform
/// owner's groups only — a whole reseller.
enum UserGroupMemberType {
  user
  tenant

  @@schema("governance")
}

/// How a group's members are decided. `manual` alone today: an admin adds
/// and removes them. A computed kind is a new value here, never a new table —
/// consumers ask `user-group.ts`, not the member rows (F-114-j).
enum UserGroupKind {
  manual

  @@schema("governance")
}

/// F-114-j — a named set of one tenant's users, the one target discount rules
/// (F-114-h), campaigns and restrictions share. Every group is exactly one
/// tenant's (strict RLS). The platform owner's groups may also hold resellers,
/// another tenant's users, or every reseller at once (`allTenants`) — a
/// trigger refuses those in any other tenant's group.
model UserGroup {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @db.Uuid
  name             String        @db.VarChar(80)
  kind             UserGroupKind @default(manual)
  /// Platform owner's groups only: every reseller is a member.
  allTenants       Boolean       @default(false)
  createdByAdminId String        @db.Uuid
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @default(now()) @updatedAt

  members       UserGroupMember[]
  discountRules DiscountRule[]

  @@unique([tenantId, name])
  /// The composite key members and discount rules point at, so neither can
  /// name another tenant's group.
  @@unique([id, tenantId])
  @@map("user_group")
  @@schema("governance")
}

/// One member of a group, once. `tenantId` is the group's (the RLS key);
/// exactly one of `userId` / `memberTenantId` is set, by `memberType` (CHECK).
model UserGroupMember {
  id             String              @id @default(uuid()) @db.Uuid
  groupId        String              @db.Uuid
  tenantId       String              @db.Uuid
  memberType     UserGroupMemberType
  userId         String?             @db.Uuid
  memberTenantId String?             @db.Uuid
  addedByAdminId String              @db.Uuid
  createdAt      DateTime            @default(now())

  group UserGroup @relation(fields: [groupId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([groupId, userId])
  @@unique([groupId, memberTenantId])
  @@index([userId])
  @@index([memberTenantId])
  @@map("user_group_member")
  @@schema("governance")
}
