// بخش شش: Schema `network` — نود، کانفیگ، ترافیک
// =============================================================================

enum PanelType {
  x_ui
  core_xray

  @@schema("network")
}

enum NodeRole {
  active
  passive

  @@schema("network")
}

enum NodeStatus {
  healthy
  degraded
  maintenance
  down

  @@schema("network")
}

enum ConfigProtocol {
  vmess
  vless
  trojan
  shadowsocks

  @@schema("network")
}

enum ConfigStatus {
  active
  frozen
  disabled_by_admin
  disabled_by_system

  @@schema("network")
}

enum ActorType {
  user
  admin
  system

  @@schema("network")
}

enum IpRuleType {
  block
  allow_always
  custom_rate_limit

  @@schema("network")
}

/// 5.1 — نود؛ tenantId=null یعنی استخر مشترک، پر یعنی نود اختصاصی Tenant.
model Node {
  id                  String     @id @default(uuid()) @db.Uuid
  tenantId            String?    @db.Uuid
  name                String
  ipAddress           String
  panelType           PanelType
  panelApiCredentials String // SENSITIVE, encrypted — never default-select
  role                NodeRole
  pairedNodeId        String?    @db.Uuid // برای HA
  status              NodeStatus @default(healthy)
  region              String

  pairedNode Node?   @relation("NodeHAPair", fields: [pairedNodeId], references: [id])
  pairedWith Node[]  @relation("NodeHAPair")
  configs    Config[]

  @@index([tenantId])
  @@map("node")
  @@schema("network")
}

/// 5.2 — کانفیگ کاربر روی یک نود؛ tenantId denormalized indexed (کلید اول
/// ایندکس کامپوزیت) برای Query سریع بدون Join در پنل هر Tenant.
model Config {
  id                   String         @id @default(uuid()) @db.Uuid
  tenantId             String         @db.Uuid
  userId               String         @db.Uuid
  nodeId               String         @db.Uuid
  servicePlanId        String         @db.Uuid
  uuid                 String         @unique // UUID واقعی روی Xray
  protocol             ConfigProtocol
  status               ConfigStatus   @default(active)
  disabledReason       String?
  maxRegenerateCount   Int            @default(3)
  regenerateUsedCount  Int            @default(0)
  createdAt            DateTime       @default(now())

  node        Node        @relation(fields: [nodeId], references: [id])
  servicePlan ServicePlan @relation(fields: [servicePlanId], references: [id])

  actionLogs        ConfigActionLog[]
  trafficRawLogs    TrafficRawLog[]
  trafficDailyAggs  TrafficDailyAggregate[]
  subAccount        SubAccount?

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([userId, status])
  @@map("config")
  @@schema("network")
}

/// 5.3 — لاگ اکشن‌های روی یک کانفیگ.
model ConfigActionLog {
  id        String    @id @default(uuid()) @db.Uuid
  configId  String    @db.Uuid
  actorType ActorType
  actorId   String    @db.Uuid
  action    String
  createdAt DateTime  @default(now())

  config Config @relation(fields: [configId], references: [id])

  @@map("config_action_log")
  @@schema("network")
}

/// 5.4 — داده خام ترافیک؛ حجم بسیار بالا. الزامی: Native Partitioning
/// ماهانه (`PARTITION BY RANGE (recordedAt)`) — پیاده‌سازی در بخش ۹۹.
model TrafficRawLog {
  id             BigInt   @id @default(autoincrement())
  configId       String   @db.Uuid
  uploadBytes    BigInt
  downloadBytes  BigInt
  recordedAt     DateTime @default(now())

  config Config @relation(fields: [configId], references: [id])

  // پیشنهاد بخش ۱۸: BRIN Index به‌جای B-Tree روی recordedAt (SQL بخش ۹۹).
  @@index([configId, recordedAt])
  @@map("traffic_raw_log")
  @@schema("network")
}

/// خروجی Cron شبانه Aggregate؛ بعد از این، پارتیشن قدیمی TrafficRawLog
/// با DROP PARTITION حذف می‌شود (نه DELETE ردیفی).
model TrafficDailyAggregate {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @db.Uuid
  configId              String   @db.Uuid
  date                  DateTime @db.Date
  totalUploadBytes      BigInt
  totalDownloadBytes    BigInt

  config Config @relation(fields: [configId], references: [id])

  @@index([userId])
  @@index([date])
  @@map("traffic_daily_aggregate")
  @@schema("network")
}

/// 5.5 — قوانین پایدار IP (لایه ۲؛ لایه ۱ Rate Limiting بلادرنگ در Redis است
/// و عمداً جدول دائمی ندارد).
model IpAccessRule {
  id                   String     @id @default(uuid()) @db.Uuid
  ipAddressOrCidr      String // تک IP یا رنج (1.2.3.0/24)
  ruleType             IpRuleType
  customLimitPerMinute Int? // فقط برای custom_rate_limit
  reason               String?
  setByAdminId         String     @db.Uuid
  expiresAt            DateTime? // برای بلاک‌های موقت
  isActive             Boolean    @default(true)
  createdAt            DateTime   @default(now())

  @@index([ipAddressOrCidr])
  @@map("ip_access_rule")
  @@schema("network")
}

// =============================================================================
