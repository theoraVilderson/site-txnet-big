// بخش شش: Schema `network` — نود، کانفیگ، ترافیک
// =============================================================================

/// Which side's infrastructure, keys and cost a Panel is — the same
/// `ownershipType` pattern `ai.AIProvider` will carry (GLOSSARY).
enum PanelOwnershipType {
  platform
  tenant

  @@schema("network")
}

/// The management-system family one Driver wraps (ADR-0071). Adding one is a
/// questionnaire plus a conformance run, never a new pipeline; `fake` is the
/// in-repo driver the conformance suite runs against (F-027-j).
enum DriverType {
  marzban
  marzneshin
  sanaee
  x_ui_alireza
  x_ui_vaxilu
  three_x_ui
  s_ui
  hiddify
  core_xray
  ibsng
  cloudius
  mikrotik_user_manager
  mikrotik_wireguard
  fake

  @@schema("network")
}

/// How the source counts usage (ADR-0074). The delta arithmetic differs per
/// value and a wrong declaration is a silent wrong number, so it is answered
/// by the registration connection test, never by hand.
enum CounterSemantics {
  cumulative
  session
  reset_on_read

  @@schema("network")
}

/// Who starts the conversation (ADR-0074): we poll it, or it sends us RADIUS
/// accounting packets.
enum PanelTransport {
  pull
  push

  @@schema("network")
}

/// The acceptance questionnaire's verdict (ADR-0074). A panel failing a
/// load-bearing row is refused here, at registration, not at billing time;
/// `accepted_low_trust` is what a `reset_on_read` source gets.
enum PanelReviewState {
  pending
  accepted
  accepted_low_trust
  refused

  @@schema("network")
}

/// What the convergence loop does with a remote client we did not create
/// (F-027-aa's `orphan` verdict). The default reports and touches nothing.
enum OrphanPolicy {
  report_only
  adopt
  delete_remote

  @@schema("network")
}

enum PanelRole {
  active
  passive

  @@schema("network")
}

/// How a group places a Grant on its members (§7.3). `mirror` puts a config on
/// every non-drain healthy member (F-027-bl). `priority` and `weighted` are
/// declared (user 2026-09-24) and have no fulfilment yet.
enum PanelGroupStrategy {
  mirror
  priority
  weighted

  @@schema("network")
}

/// A member's part in its group, not the panel's HA role (`PanelRole`).
/// `drain` takes no new Grants and is then emptied (F-027-bm).
enum PanelGroupMemberRole {
  primary
  replica
  drain

  @@schema("network")
}

/// Why a connection test gave no verdict (F-027-aq, ADR-0080): the driver's six
/// fault kinds, plus the two that happen on our side of the call. A panel with
/// one of these was not refused — it did not answer, so it stays `pending`.
enum ConnectionTestFault {
  timeout
  rate_limited
  blocked
  unavailable
  unsupported
  protocol
  unopenable
  invalid_answers

  @@schema("network")
}

/// `throttled_or_blocked` is not `down` (ADR-0072): a `429`/`403` means the
/// panel is answering and refusing us, so it is not retried through and its
/// owner is alerted instead.
enum PanelState {
  healthy
  degraded
  maintenance
  down
  throttled_or_blocked

  @@schema("network")
}

/// Every protocol a driver family can hand us: the Xray set, the two modern
/// UDP protocols Hiddify/Marzneshin add, WireGuard, and the two an ISP
/// billing system reports over RADIUS.
enum ConfigProtocol {
  vmess
  vless
  trojan
  shadowsocks
  hysteria2
  tuic
  wireguard
  openvpn
  pppoe

  @@schema("network")
}

/// Whether the remote client should exist at all (ADR-0075). Purge is a
/// second, timed stage after a suspension, and it is desired state — never a
/// queued delete, which is why a top-up mid-purge rebuilds instead of racing.
enum DesiredRemote {
  present
  absent

  @@schema("network")
}

/// How far the convergence loop has got with this config's desired state. A
/// Grant reports `purged` only once every one of its configs is `complete`.
enum EnforcementState {
  pending
  partial
  complete

  @@schema("network")
}

/// The convergence loop's verdict on what the panel reports (F-027-aa), plus
/// the anti-flap stop (F-027-ab). A config the loop has given up repairing is
/// `contested`, which is not `synced`.
enum DriftState {
  synced
  reset
  renamed
  rebuilt
  missing
  orphan
  limit_overridden
  contested

  @@schema("network")
}

/// How a byte that was measured but not yet billed ends (ADR-0074, `in doubt,
/// do not charge`). `pending` is the only open state and there is no
/// `dropped`: a figure is either billed or written off by someone, on the
/// record. Shared by `UsageHold` and `UsageDeltaQuarantine` (C-09).
enum UsageDispositionState {
  pending
  released
  written_off

  @@schema("network")
}

/// Why bytes we believe are not being billed yet. Every value is a *declared*
/// incapacity (ADR-0074): the source cannot tell us something, so we hold the
/// bytes rather than guess at them.
enum HoldReason {
  gigawords_missing
  session_never_closed
  publish_failed_after_read
  attribution_ambiguous
  panel_drift_event
  low_trust_source

  @@schema("network")
}

/// Why a figure is not believed at all. A quarantined delta is never applied
/// to a Grant until someone releases it.
enum QuarantineReason {
  implausible_volume
  implausible_rate
  reset_with_unmeasured_bytes
  semantics_mismatch
  clock_went_backward
  panel_drift_event

  @@schema("network")
}

/// What a panel-wide drift verdict saw (F-027-ab). A backup restore reads as
/// thousands of individually plausible resets, so the population is the unit
/// of judgement, not the config.
enum PanelDriftEventType {
  mass_reset
  mass_missing
  mass_rename
  mass_limit_override

  @@schema("network")
}

/// What became of usage we measured and could not place. `dismissed` is a
/// decision someone made, which is the point: the bytes are never dropped by
/// the absence of one.
enum UnattributedUsageState {
  open
  attributed
  dismissed

  @@schema("network")
}

/// Why a RADIUS session stopped counting (F-027-d). Only `acct_stop` is the
/// NAS telling us the session ended; the other four are us deciding it did,
/// and a figure closed under one of them is worth less than a `Stop` figure.
enum RadiusSessionCloseReason {
  acct_stop
  stale_timeout
  nas_restart
  superseded
  administrative

  @@schema("network")
}

enum ConfigStatus {
  active
  frozen
  disabled_by_admin
  disabled_by_system
  /// Deleted, or the old side of a move (F-027-z). Never on a panel again:
  /// CHECK `config_retired_is_absent`, and a top-up revives only `active`.
  retired

  @@schema("network")
}

enum ActorType {
  user
  admin
  system

  @@schema("network")
}

enum IpRuleType {
  block
  allow_always
  custom_rate_limit

  @@schema("network")
}

/// 5.1 — نود؛ tenantId=null یعنی استخر مشترک، پر یعنی نود اختصاصی Tenant.
/// A Panel *declares* how it counts and how it is reached (ADR-0074); every
/// column below the credentials changes system behaviour rather than
/// documenting it.
model Panel {
  id                         String             @id @default(uuid()) @db.Uuid
  tenantId                   String?            @db.Uuid
  /// `tenant` exactly when `tenantId` is set (`panel_ownership_matches_tenant`).
  ownershipType              PanelOwnershipType @default(platform)
  name                       String
  /// A push panel's NAS address, its allowlist entry — the only reader.
  /// Optional for a pull panel, reached at `apiBaseUrl` (F-027-br,
  /// `panel_push_has_ip_address`).
  ipAddress                  String?
  /// Where the driver talks to it; null for a push source we never call.
  apiBaseUrl                 String?
  /// Where users are served their links, for a family that serves them apart
  /// from its API: Hiddify's client proxy path, often on another domain
  /// (F-027-bg). Null for none; pull only (`panel_client_base_url_is_pull_only`).
  clientBaseUrl              String?
  driverType                 DriverType
  counterSemantics           CounterSemantics
  transport                  PanelTransport
  /// The 16-row acceptance questionnaire as answered by the connection test
  /// (F-027-i). Validated and versioned on write — the database holds no shape.
  capabilities               Json?
  reviewState                PanelReviewState   @default(pending)
  /// When `network-service` last ran the connection test (ADR-0080).
  connectionTestedAt         DateTime?
  /// Set only while `pending`: why the last test gave no verdict, and the
  /// driver's own words. Cleared by a verdict, or by re-submitting.
  connectionTestFault        ConnectionTestFault?
  connectionTestDetail       String?
  orphanPolicy               OrphanPolicy       @default(report_only)
  panelApiCredentials        String // SENSITIVE, encrypted — never default-select
  /// A push panel's RADIUS shared secret, as a vault reference
  /// (`panelRadiusSecretRef`), never the secret (F-027-az). Its own reference
  /// because the REST login cannot also be the NAS's secret. Null on a pull
  /// panel (CHECK `panel_radius_secret_is_push_only`).
  panelRadiusSecret          String?
  role                       PanelRole
  pairedPanelId              String?            @db.Uuid // برای HA
  panelState                 PanelState         @default(healthy)
  /// Set when it first answered `429`/`403`, cleared when it stops.
  blockedSince               DateTime?
  region                     String
  /// The request budget we hold ourselves to on someone else's server.
  maxRequestsPerMinute       Int                @default(60)
  /// The first ceiling horizon is time-based and needs a rate before one has
  /// been observed (ADR-0072, F-027-u).
  maxLineRateBps             BigInt?
  /// How long this panel takes to accept a ceiling — the horizon must cover it.
  observedWriteLatencyMs     Int?
  lastHealthyAt              DateTime?
  /// The external watchdog's input (F-027-w): a stalled collector is visible
  /// here before it is visible as a wrong number.
  lastSuccessfulCollectionAt DateTime?

  pairedPanel Panel?   @relation("PanelHAPair", fields: [pairedPanelId], references: [id])
  pairedWith  Panel[]  @relation("PanelHAPair")
  configs     Config[]

  driftEvents       PanelDriftEvent[]
  quarantinedDeltas UsageDeltaQuarantine[]
  unattributedUsage UnattributedUsage[]
  radiusSessions    RadiusSession[]
  groupMemberships  PanelGroupMember[]

  @@index([tenantId])
  @@map("panel")
  @@schema("network")
}

/// 5.2 — کانفیگ کاربر روی یک نود؛ tenantId denormalized indexed (کلید اول
/// ایندکس کامپوزیت) برای Query سریع بدون Join در پنل هر Tenant.
model Config {
  id                  String         @id @default(uuid()) @db.Uuid
  tenantId            String         @db.Uuid
  userId              String         @db.Uuid
  panelId             String         @db.Uuid
  /// The Grant whose quota it draws on (§4.6, F-026-b); its tenant is the config's.
  grantId             String         @db.Uuid
  uuid                String         @unique // UUID واقعی روی Xray
  protocol            ConfigProtocol
  status              ConfigStatus   @default(active)
  disabledReason      String?
  maxRegenerateCount  Int            @default(3)
  regenerateUsedCount Int            @default(0)
  createdAt           DateTime       @default(now())

  /// The panel's own id for this client — the first of the three matching
  /// keys (F-027-aa). Cleared, never the row, when a purge completes.
  remoteId              String?
  /// What we write on every client we create, so a rename does not orphan its
  /// usage. The second matching key; `uuid` is the third. Required (F-027-aa):
  /// a key some rows lack is one the match cannot rely on.
  claimTag              String           @unique
  /// The configs issued together from one package, sharing one quota (§4.6).
  /// A panel group's placement writes it (F-027-bl); one row of a Grant per
  /// panel while it is set — partial unique `config_group_panel_once`, raw SQL.
  credentialGroupId     String?          @db.Uuid
  /// Desired state, not a command: the loop compares it as it is now and
  /// never replays an instruction (ADR-0075).
  desiredEnabled        Boolean          @default(true)
  desiredRemote         DesiredRemote    @default(present)
  enforcementState      EnforcementState @default(pending)
  driftState            DriftState       @default(synced)
  /// Two repairs and the loop stops (`contested`) rather than flapping.
  driftRepairCount      Int              @default(0)
  /// The last repair. Only repairs within 24 hours of the one before count
  /// (F-027-ab), so a repair months later starts the count again.
  driftRepairedAt       DateTime?
  lastReconciledAt      DateTime?
  /// What the allocator decided this config's share of the Grant is.
  allocatedCeilingBytes BigInt?
  /// What the panel confirmed it accepted. The gap to `allocated` is the
  /// loop's remaining work, and what the panel UI shows as `in queue`
  /// (ADR-0072).
  appliedCeilingBytes   BigInt?
  /// The measured rate the time-based horizon is sized from (F-027-u).
  observedRateBps       BigInt?
  ceilingAppliedAt      DateTime?
  /// What **money** says this config may carry while nobody is metering it
  /// (F-027-w): its share of a bag of `purchasedBytes` plus what the wallet
  /// would buy at the Grant's locked rate. The allocator keeps it fresh; the
  /// collector raises the panel's ceiling to it on a graceful shutdown, and
  /// the first pass after a restart pulls the panel back to `allocated`.
  /// Never below `allocatedCeilingBytes` — an extension only ever extends.
  walletBackedCeilingBytes BigInt?
  /// Every link line the panel gives this client, as the panel built them,
  /// captured on the read that confirms it (ADR-0082 rule 2, F-027-bj). `/sub`
  /// renders these and never asks a panel. Empty with `linksCapturedAt` set is
  /// a panel that gives none; with it null, the client was never captured.
  linkLines                String[]  @default([])
  /// The client the lines were read from. A capture runs again when either
  /// differs from the client the pass confirms: a regenerate, a move, a rename
  /// or a rebuild.
  linksRemoteId            String?
  linksUuid                String?
  linksCapturedAt          DateTime?
  /// Set by a drain's retire only (F-027-bm/bp): such a row no longer covers
  /// its panel, so a member re-added to the group is placed again.
  drainedAt                DateTime?

  panel Panel @relation(fields: [panelId], references: [id])
  grant Grant @relation(fields: [grantId], references: [id])

  actionLogs       ConfigActionLog[]
  trafficRawLogs   TrafficRawLog[]
  trafficDailyAggs TrafficDailyAggregate[]
  subAccount       SubAccount?

  counterState      ConfigCounterState?
  usageHolds        UsageHold[]
  quarantinedDeltas UsageDeltaQuarantine[]
  radiusSessions    RadiusSession[]

  @@unique([panelId, remoteId], map: "config_panel_remote_id_key")
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([userId, status])
  @@index([credentialGroupId])
  /// `/sub` reads a Grant's configs oldest first on every cache miss (F-027-bn).
  @@index([grantId, createdAt])
  @@index([panelId, enforcementState])
  @@map("config")
  @@schema("network")
}

/// Where a variant's Grants are provisioned (§7.3, F-027-bk). `tenantId` null
/// is a platform group: it holds platform panels only and serves anyone's
/// variants. A tenant's group holds its own panels and platform ones, and
/// serves its own variants only. The tenant never changes (a trigger).
model PanelGroup {
  id                     String             @id @default(uuid()) @db.Uuid
  tenantId               String?            @db.Uuid
  name                   String
  strategy               PanelGroupStrategy @default(mirror)
  /// Healthy members a Grant needs before it activates (F-027-bl).
  minHealthyPanels       Int                @default(1)
  /// How long a client keeps a subscription before asking again; draining
  /// waits twice this (F-027-bm). 3600 = `/sub`'s render TTL today.
  subscriptionTtlSeconds Int                @default(3600)
  /// The protocol every config of the group is placed with, one per member
  /// panel (F-027-bl, user 2026-09-24). A list later keys (group, panel, protocol).
  protocol               ConfigProtocol     @default(vless)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @default(now()) @updatedAt

  members  PanelGroupMember[]
  variants ProductVariant[]

  @@index([tenantId])
  @@map("panel_group")
  @@schema("network")
}

/// A panel in a group, once. `tenantId` is its group's — a trigger holds it —
/// so RLS reads it without a join. `priority` and `weight` are for the
/// strategies that choose among members; `mirror` reads neither.
model PanelGroupMember {
  groupId   String               @db.Uuid
  panelId   String               @db.Uuid
  tenantId  String?              @db.Uuid
  /// Lower first.
  priority  Int                  @default(0)
  weight    Int                  @default(1)
  role      PanelGroupMemberRole @default(primary)
  /// When `role` became `drain`; the database's clock, set and held by trigger
  /// `panel_group_member_drain_clock` (F-027-bm). Null when not draining.
  drainingSince DateTime?
  createdAt DateTime             @default(now())

  group PanelGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  panel Panel      @relation(fields: [panelId], references: [id], onDelete: Restrict)

  @@id([groupId, panelId])
  @@index([panelId])
  @@index([tenantId])
  @@map("panel_group_member")
  @@schema("network")
}

/// 5.3 — لاگ اکشن‌های روی یک کانفیگ.
model ConfigActionLog {
  id        String    @id @default(uuid()) @db.Uuid
  configId  String    @db.Uuid
  actorType ActorType
  actorId   String    @db.Uuid
  action    String
  createdAt DateTime  @default(now())

  config Config @relation(fields: [configId], references: [id])

  @@map("config_action_log")
  @@schema("network")
}

/// 5.4 — the raw traffic log; the highest-volume table in the platform.
/// **Monthly native range partitioning on `recordedAt`** (F-027-e), so
/// retention is `DROP PARTITION` and never a row-wise `DELETE` (invariant 2).
/// Partitioning and its per-month tables are hand-written SQL — Prisma cannot
/// express either. The BRIN index is declared below so Prisma sees no drift.
model TrafficRawLog {
  /// Postgres requires the partition key in every unique constraint, so the
  /// key is the pair. A bare `BIGSERIAL` id cannot be enforced unique across
  /// partitions, and Prisma has to agree with that or the next `migrate diff`
  /// proposes dropping the partitioning.
  id            BigInt   @default(autoincrement())
  /// Denormalized as `config.tenantId` is (invariant 6): the reporting read is
  /// per tenant, and reaching it through `config` is a join against this table.
  tenantId      String   @db.Uuid
  configId      String   @db.Uuid
  uploadBytes   BigInt
  downloadBytes BigInt
  recordedAt    DateTime @default(now())

  config Config @relation(fields: [configId], references: [id])

  @@id([id, recordedAt], map: "traffic_raw_log_pkey")
  @@index([configId, recordedAt])
  @@index([tenantId, recordedAt])
  @@index([recordedAt], type: Brin, map: "traffic_raw_log_recordedAt_brin_idx")
  @@map("traffic_raw_log")
  @@schema("network")
}

/// خروجی Cron شبانه Aggregate؛ بعد از این، پارتیشن قدیمی TrafficRawLog
/// با DROP PARTITION حذف می‌شود (نه DELETE ردیفی).
model TrafficDailyAggregate {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @db.Uuid
  configId           String   @db.Uuid
  date               DateTime @db.Date
  totalUploadBytes   BigInt
  totalDownloadBytes BigInt

  config Config @relation(fields: [configId], references: [id])

  /// A cron rerun — a retry, an operator re-running last night — wrote a
  /// second row for the same day and doubled the reported usage, with both
  /// rows individually correct (F-027-e).
  @@unique([configId, date], map: "traffic_daily_aggregate_config_date_key")
  @@index([userId])
  @@index([date])
  @@map("traffic_daily_aggregate")
  @@schema("network")
}

/// 5.6 — The collector's memory of one config's raw counter (F-027-c). It is
/// what makes a counter going backward a *reset* rather than negative usage
/// (ADR-0074), and it is written only after the delta it produced was
/// published — so a crash between the two re-reads rather than loses.
model ConfigCounterState {
  id                String           @id @default(uuid()) @db.Uuid
  configId          String           @unique @db.Uuid
  panelId           String           @db.Uuid
  /// The arithmetic the cursor below was computed under. A panel re-declared
  /// from `cumulative` to `session` invalidates it; a cursor that does not say
  /// what it meant cannot be invalidated.
  counterSemantics  CounterSemantics
  /// The last raw figures read off the source — not a total.
  lastUpBytes       BigInt           @default(0)
  lastDownBytes     BigInt           @default(0)
  /// What we have published for this config since it existed, across resets.
  lifetimeUpBytes   BigInt           @default(0)
  lifetimeDownBytes BigInt           @default(0)
  lastObservedAt    DateTime?
  /// Stored only after a successful publish (F-027-n): at-least-once delivery
  /// plus the dedupe table below is an exactly-once effect.
  lastPublishedAt   DateTime?
  resetCount        Int              @default(0)
  lastResetAt       DateTime?
  updatedAt         DateTime         @updatedAt

  config Config @relation(fields: [configId], references: [id])

  @@index([panelId])
  @@map("config_counter_state")
  @@schema("network")
}

/// 5.7 — Every delta this consumer has applied, keyed by the delta's own id.
/// The insert *is* the deduplication: a redelivered message is a primary-key
/// violation the consumer absorbs, never a second charge (F-027-n). Swept at
/// 48h, which is why `seenAt` is indexed.
model UsageDeltaSeen {
  deltaId    String   @id @db.Uuid
  configId   String   @db.Uuid
  panelId    String   @db.Uuid
  upBytes    BigInt
  downBytes  BigInt
  /// The end of the interval the delta covers, as the source reported it.
  observedAt DateTime
  seenAt     DateTime @default(now())

  @@index([seenAt], map: "usage_delta_seen_seenAt_idx")
  @@index([configId, observedAt])
  @@map("usage_delta_seen")
  @@schema("network")
}

/// 5.8 — A figure we measured and do not believe. It is not applied to a
/// Grant and it is not thrown away: someone releases it or writes it off
/// (ADR-0074). `configId` is nullable because attribution is one of the
/// things that can be what failed.
model UsageDeltaQuarantine {
  id                String                @id @default(uuid()) @db.Uuid
  deltaId           String?               @db.Uuid
  configId          String?               @db.Uuid
  panelId           String                @db.Uuid
  upBytes           BigInt
  downBytes         BigInt
  observedAt        DateTime
  reason            QuarantineReason
  state             UsageDispositionState @default(pending)
  detectedAt        DateTime              @default(now())
  /// Set exactly when the state is no longer `pending`
  /// (`usage_delta_quarantine_resolved_has_time`).
  resolvedAt        DateTime?
  resolvedByAdminId String?               @db.Uuid
  resolutionNote    String?

  config Config? @relation(fields: [configId], references: [id], onDelete: Restrict)
  panel  Panel   @relation(fields: [panelId], references: [id])

  @@index([state, detectedAt])
  @@map("usage_delta_quarantine")
  @@schema("network")
}

/// 5.9 — Bytes we believe and cannot bill yet, because the source declared it
/// cannot tell us something (ADR-0074). This table is the heart of `in doubt,
/// do not charge`, and the holds queue (F-027-ad) is its visible face: while
/// anything sits in it, nobody can claim the system dropped a byte in silence.
model UsageHold {
  id                String                @id @default(uuid()) @db.Uuid
  configId          String                @db.Uuid
  panelId           String                @db.Uuid
  upBytes           BigInt
  downBytes         BigInt
  reason            HoldReason
  state             UsageDispositionState @default(pending)
  /// The start of the window these bytes were measured over.
  heldFrom          DateTime
  heldAt            DateTime              @default(now())
  /// Set exactly when the state is no longer `pending`
  /// (`usage_hold_resolved_has_time`).
  resolvedAt        DateTime?
  resolvedByAdminId String?               @db.Uuid
  resolutionNote    String?

  config Config @relation(fields: [configId], references: [id])

  @@index([state, heldAt], map: "usage_hold_state_heldAt_idx")
  @@index([configId])
  @@map("usage_hold")
  @@schema("network")
}

/// 5.10 — A verdict over a whole panel's population (F-027-ab). One config
/// going backward is a reset; a third of them going backward together is a
/// backup restore, and carrying on is ~$16k of wrong charges in a minute —
/// so `collectionHalted` defaults to true and resuming is somebody's decision.
model PanelDriftEvent {
  id                    String              @id @default(uuid()) @db.Uuid
  panelId               String              @db.Uuid
  eventType             PanelDriftEventType
  /// Both counts are stored, never the ratio: a percentage cannot be checked
  /// afterwards (`panel_drift_event_counts_sane`).
  affectedConfigCount   Int
  observedConfigCount   Int
  detectedAt            DateTime            @default(now())
  collectionHalted      Boolean             @default(true)
  acknowledgedAt        DateTime?
  acknowledgedByAdminId String?             @db.Uuid
  note                  String?

  panel Panel @relation(fields: [panelId], references: [id])

  @@index([panelId, detectedAt(sort: Desc)])
  @@map("panel_drift_event")
  @@schema("network")
}

/// 5.11 — Usage measured against a remote client that matches none of our
/// configs by any of the three keys (F-027-aa's `orphan`). It has a row so
/// that the bytes exist somewhere; what happens to the client itself is the
/// panel's `orphanPolicy`. One row per remote client, accumulated — an orphan
/// is re-observed every pass, and per-reading rows would be a row a minute.
model UnattributedUsage {
  id                 String                 @id @default(uuid()) @db.Uuid
  panelId            String                 @db.Uuid
  /// The panel's own identifier for it — id, username or tag, as reported.
  remoteIdentifier   String
  upBytes            BigInt                 @default(0)
  downBytes          BigInt                 @default(0)
  observationCount   Int                    @default(1)
  firstSeenAt        DateTime               @default(now())
  lastSeenAt         DateTime
  state              UnattributedUsageState @default(open)
  /// Set exactly when the state is `attributed`
  /// (`unattributed_usage_attributed_has_config`).
  attributedConfigId String?                @db.Uuid
  resolvedAt         DateTime?
  note               String?

  panel Panel @relation(fields: [panelId], references: [id])

  @@unique([panelId, remoteIdentifier], map: "unattributed_usage_panel_remote_key")
  @@index([state, lastSeenAt])
  @@map("unattributed_usage")
  @@schema("network")
}

/// 5.12 — One RADIUS accounting session (F-027-d). A pull panel hands us a
/// running total and `ConfigCounterState` remembers where it was; a NAS hands
/// us packets about a *session*, and the session is the unit of everything
/// that can go wrong with one. It lands now, ahead of the receiver (F-027-af),
/// so one migration series covers the whole schema.
model RadiusSession {
  id                String                    @id @default(uuid()) @db.Uuid
  panelId           String                    @db.Uuid
  /// The NAS that issued the session — `NAS-Identifier`, or its IP.
  nasId             String
  /// `Acct-Session-Id`, which is unique only within that NAS.
  acctSessionId     String
  /// Null until attribution places it; the bytes have a row either way.
  configId          String?                   @db.Uuid
  /// `User-Name` as the NAS reported it — what a later pass matches on.
  remoteIdentifier  String
  /// A session counter only rises, so what is stored is a high water mark:
  /// a lower reading is a NAS restart, never negative usage (ADR-0074).
  /// 64-bit, because the wire figure is 32 and wraps at 4 GB.
  highWaterInBytes  BigInt                    @default(0)
  highWaterOutBytes BigInt                    @default(0)
  /// How much of the mark above has already been published as a delta. Never
  /// more than the mark (`radius_session_published_within_high_water`): that
  /// gap is the extrapolation ADR-0074 forbids, arriving as a charge.
  publishedInBytes  BigInt                    @default(0)
  publishedOutBytes BigInt                    @default(0)
  /// Whether this session's packets ever carried `Acct-*-Gigawords`. False
  /// past the first wrap is a `gigawords_missing` hold, not a guess.
  gigawordsSeen     Boolean                   @default(false)
  startedAt         DateTime
  /// Last accounting packet seen for it; the stale sweep ranges over this.
  lastSeenAt        DateTime
  /// Set exactly with `closeReason` (`radius_session_closed_has_reason`):
  /// open is the absence of both, never a half-closed row.
  closedAt          DateTime?
  closeReason       RadiusSessionCloseReason?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  config Config? @relation(fields: [configId], references: [id], onDelete: Restrict)
  panel  Panel   @relation(fields: [panelId], references: [id])

  @@unique([nasId, acctSessionId], map: "radius_session_nas_acct_key")
  @@index([closedAt, lastSeenAt])
  @@index([configId])
  @@map("radius_session")
  @@schema("network")
}

/// 5.5 — قوانین پایدار IP (لایه ۲؛ لایه ۱ Rate Limiting بلادرنگ در Redis است
/// و عمداً جدول دائمی ندارد).
model IpAccessRule {
  id                   String     @id @default(uuid()) @db.Uuid
  ipAddressOrCidr      String // تک IP یا رنج (1.2.3.0/24)
  ruleType             IpRuleType
  customLimitPerMinute Int? // فقط برای custom_rate_limit
  reason               String?
  setByAdminId         String     @db.Uuid
  expiresAt            DateTime? // برای بلاک‌های موقت
  isActive             Boolean    @default(true)
  createdAt            DateTime   @default(now())

  @@index([ipAddressOrCidr])
  @@map("ip_access_rule")
  @@schema("network")
}

