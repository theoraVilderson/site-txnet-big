// بخش نه: Schema `automation` — مدیریت Workerهای خودکار
// =============================================================================

enum BotWorkerCategory {
  campaign
  fraud_detection
  data_aggregation
  ai_task
  payment_reconciliation
  other

  @@schema("automation")
}

enum ScheduleType {
  always_on
  time_window
  cron_expression

  @@schema("automation")
}

enum TriggerSource {
  cron
  admin_manual
  event

  @@schema("automation")
}

enum ExecutionStatus {
  success
  failed
  partial

  @@schema("automation")
}

/// 10.1 — تعریف Worker؛ isActive سریع‌ترین راه خاموش‌کردن کلی.
/// رکوردهای پیشنهادی چندمستأجری: tenant_usage_metering, tenant_domain_verifier.
model BotWorker {
  id          String            @id @default(uuid()) @db.Uuid
  key         String            @unique // campaign_sender, fraud_scanner, traffic_aggregator, ...
  name        String
  description String?
  category    BotWorkerCategory
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())

  schedules     BotSchedule[]
  executionLogs BotExecutionLog[]

  @@map("bot_worker")
  @@schema("automation")
}

/// 10.2 — فعال/غیرفعال برای بازه‌ی خاص.
model BotSchedule {
  id             String       @id @default(uuid()) @db.Uuid
  botWorkerId    String       @db.Uuid
  scheduleType   ScheduleType
  windowStartAt  DateTime? // فقط time_window
  windowEndAt    DateTime? // فقط time_window
  cronExpression String? // فقط cron_expression
  timezone       String       @default("Asia/Tehran")
  setByAdminId   String       @db.Uuid
  isActive       Boolean      @default(true)

  botWorker BotWorker @relation(fields: [botWorkerId], references: [id])

  @@map("bot_schedule")
  @@schema("automation")
}

/// 10.3 — رصد عملکرد هر اجرای Worker.
model BotExecutionLog {
  id             String          @id @default(uuid()) @db.Uuid
  botWorkerId    String          @db.Uuid
  triggeredBy    TriggerSource
  startedAt      DateTime        @default(now())
  finishedAt     DateTime?
  status         ExecutionStatus
  itemsProcessed Int             @default(0)
  errorsCount    Int             @default(0)
  metricsJson    Json? // مثلاً برای campaign_sender: {"sent": 950, "failed": 12}

  botWorker BotWorker @relation(fields: [botWorkerId], references: [id])

  @@index([botWorkerId, startedAt(sort: Desc)])
  @@map("bot_execution_log")
  @@schema("automation")
}

// =============================================================================

// 10.1 — Multiple bots per tenant (F-315, F-316; catalog 10.1, constraint C-05).
// Replaces `tenant.TenantBotIntegration`, which no code ever read.

/// Which job a tenant's bot does. C-05: the `primary` bot is the one that
/// carries OTP and transactional alerts; `sales` / `support` / `secondary`
/// exist for campaigns, secondary brands, and spreading ban risk.
enum BotRole {
  primary
  sales
  support
  secondary

  @@schema("automation")
}

/// Where an integration is in its lifecycle. `error` plus `lastErrorAt` is how
/// a bot that upstream has banned or de-authorised stops being dialled.
enum BotIntegrationStatus {
  pending
  active
  disabled
  error

  @@schema("automation")
}

/// 10.1 — one bot instance a tenant owns, addressed by its own webhook path so
/// that a token, ban or outage on one bot never reaches another tenant's.
///
/// `tenantId` carries no foreign key, which is the pattern every schema outside
/// `tenant` uses for it. It is also deliberately NOT registered with the
/// `withTenant` extension (`platform/tenant-context`): a webhook is resolved by
/// its path in order to *discover* which tenant it belongs to, before any
/// tenant is resolved — the same exception the vault tables take.
model BotIntegration {
  id            String               @id @default(uuid()) @db.Uuid
  tenantId      String               @db.Uuid
  platform      SocialPlatform
  /// The @handle, without the leading `@`.
  botUsername   String
  role          BotRole              @default(primary)
  /// The vault `label` half of a `CredentialRef`. The other two halves are
  /// this row's `tenantId` and the kind implied by `platform`
  /// (`telegram_bot_token` / `bale_bot_token`), so the token itself is never a
  /// column here — ADR-0026, F-316. The webhook secret is the same label under
  /// kind `webhook_secret`, which is what lets a rotation keep verifying an
  /// in-flight update through its grace window.
  credentialRef String
  /// Unguessable, and the whole address: resolving it yields the tenant and
  /// the platform. An unknown path is a 404, never a hint (ADR-0009).
  webhookPath   String               @unique
  status        BotIntegrationStatus @default(pending)
  lastErrorAt   DateTime?
  /// What this bot's platform can actually do, cached from the driver
  /// (`platform/messenger`, F-301). Absent means "not probed yet".
  capabilities  Json?
  connectedAt   DateTime             @default(now())

  @@unique([tenantId, platform, botUsername])
  @@index([tenantId, status])
  @@map("bot_integration")
  @@schema("automation")
}

// Section 99 — `partial unique (tenantId, platform) where role = 'primary'`
// cannot be expressed in Prisma. It lives as hand-written SQL in
// `migrations/20260909000200_bot_integration`.

// =============================================================================

// F-067-d — the record of a message the queue could not deliver.

/// Which of this service's three ending paths a message took. Derived from the
/// message itself (`worker-service/src/app/automation/dead-letter.ts`), because
/// AMQP carries nothing back through a rejection.
enum DeadLetterReason {
  /// The handler threw. Its run is a `bot_execution_log` row with `failed`.
  handler_failed
  /// The body is not JSON, so no run was ever opened for it.
  unparseable
  /// The tenant concurrency gate gave up after `MAX_DEFERRALS` (invariant #8).
  gate_gave_up

  @@schema("automation")
}

/// 10.4 — one message that left the automation queue without being handled.
///
/// Before this table a rejected message was destroyed by the broker, which was
/// defensible only while every message was a tick that recurs on the next
/// interval. An OTP send, an outbox event or a bot update does not recur
/// (F-067-a, F-067-b, F-067-c), so the queue needed somewhere for them to land
/// and an operator needed somewhere to read it.
///
/// **No `tenantId` column**, like the three worker tables above it: a worker is
/// platform-wide, and a tick's tenant — when it has one — is already inside
/// `payload`. Adding the column would mean choosing an RLS policy shape for a
/// table with no tenant-scoped reader.
model DeadLetter {
  id         String           @id @default(uuid()) @db.Uuid
  /// `automation.tick.<key>` — the address the message was published to.
  routingKey String
  /// The worker it belonged to, from the body or the routing key. Null when
  /// neither said, which is itself worth seeing.
  workerKey  String?
  reason     DeadLetterReason
  /// Publishes or dead-letterings of this message, whichever counted higher.
  attempts   Int              @default(1)
  /// One line: which queue it died out of, what the broker said, and why.
  detail     String
  /// The body, when it was JSON.
  payload    Json?
  /// The body as text, only when it was not — never both.
  rawPayload String?

  deadLetteredAt DateTime @default(now())

  @@index([deadLetteredAt(sort: Desc)])
  @@index([workerKey, deadLetteredAt(sort: Desc)])
  @@map("dead_letter")
  @@schema("automation")
}

// =============================================================================

// F-067-c — the transactional outbox ADR-0021 decided on 2026-09-09.

/// 10.5 — one cross-domain event, written **inside the transaction that caused
/// it** and published afterwards by `OutboxRelayJob`.
///
/// ADR-0021's failure case is specific: a confirmed payment must provision a
/// config, and calling the panel synchronously means either the money
/// transaction rolls back after the money moved, or the money moves and no
/// service appears. Inserting this row in the same transaction as the ledger
/// append removes the window in which one happened and the other did not.
///
/// **Delivery is at-least-once, never exactly-once.** `id` is the event id and
/// rides as the AMQP `messageId`; a consumer that cannot safely process the
/// same event twice is a bug in the consumer (ADR-0021).
///
/// **No `tenantId` column**, the same call the four tables above it make: the
/// relay is a platform-wide process and reads under no scope, so a column here
/// would need an RLS policy shape chosen for a table with no tenant-scoped
/// reader. The tenant an event belongs to is inside `payload`, where the
/// domain that wrote it decides what its own event means.
///
/// **It lives in `automation` rather than in a unit of its own** (D-14): one
/// table and one job, beside the worker runtime that already owns the exchange
/// it publishes to. ADR-0021 called it a new unit; splitting it out later stays
/// cheap while it is still one of each.
model OutboxEvent {
  id          String @id @default(uuid()) @db.Uuid
  /// What the event is about: `billing.payment`, `network.config`.
  aggregate   String
  /// Which one — the id of the row inside that aggregate.
  aggregateId String
  /// What happened: `payment.confirmed`. It is the routing-key suffix under
  /// `outbox.`, so it must be a dot-separated path — `outboxRoutingKey`
  /// (`shared-core`) refuses anything else rather than publish to a key that
  /// silently matches no binding.
  type        String
  payload     Json
  /// When the producing transaction said it happened — not when it was sent.
  occurredAt  DateTime @default(now())
  /// Null until a **confirmed, routable** publish (invariant #10). This column
  /// is the whole relay state; there is no `claimedAt`, because a claim is a
  /// row lock (`FOR UPDATE SKIP LOCKED`) and a lock ends with its transaction.
  publishedAt DateTime?
  /// Publishes attempted, successful or not.
  attempts    Int      @default(0)
  /// Why the last attempt did not publish. Cleared when one does.
  lastError   String?

  @@index([publishedAt, occurredAt])
  @@map("outbox_event")
  @@schema("automation")
}

// Section 99 — the relay's own index is partial (`WHERE "publishedAt" IS
// NULL`), which Prisma cannot express. It lives as hand-written SQL in
// `migrations/20260910001000_automation_outbox`, alongside the composite index
// above: the composite is what Prisma keeps in step, the partial one is what
// stays small as the published rows accumulate.
