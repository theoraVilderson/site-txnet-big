// بخش یک: Schema `identity` — هویت، احراز هویت، دسترسی
// =============================================================================

enum UserStatus {
  active
  banned
  suspended

  @@schema("identity")
}

enum ThemePreference {
  light
  dark
  system

  @@schema("identity")
}

enum Language {
  fa
  en

  @@schema("identity")
}

enum SessionRevokedReason {
  user_logout
  password_change
  admin_ban
  expired
  impersonation_ended // پایان نشست ورود ادمین به‌جای کاربر بدون credential
  // F-0207: the outgoing session of an account switch. Revoked in the same
  // transaction that issues the incoming one (audit invariant #7), so one
  // browser still holds exactly one live session at every instant.
  account_switched
  // F-0208: the account was removed from a switch group. Only the sessions
  // minted in the *removing* scope are revoked (ADR-0015) — the same account
  // may still hold a group, and a live session, somewhere else entirely.
  account_unlinked

  @@schema("identity")
}

enum SocialPlatform {
  telegram
  bale

  @@schema("identity")
}

enum OtpPurpose {
  login
  register_phone_verify
  password_reset
  account_link // linking a Telegram/Bale account to a User (see LinkedBotAccount)
  account_switch_link // proving a second account before it joins an account-switch group (F-0205)

  @@schema("identity")
}

enum OtpChannel {
  sms
  bale     // از طریق ربات بله، نیازمند LinkedBotAccount از پیش تایید‌شده
  telegram // از طریق ربات تلگرام، نیازمند LinkedBotAccount از پیش تایید‌شده

  @@schema("identity")
}

/// 1.1 — هسته اصلی سیستم.
model User {
  id                     String     @id @default(uuid()) @db.Uuid
  tenantId               String     @db.Uuid // FK -> tenant.Tenant.id | کلید پارتیشن اصلی چندمستأجری؛ پیش‌فرض اپلیکیشنی = رکورد platform_owner
  fullName               String
  username               String?    @unique
  /// E.164, always — `+989123456789`. The canonical stored form for every
  /// phone column in this schema; see ADR-0018.
  phoneNumber            String?    @unique
  phoneVerifiedAt        DateTime? // تا زمانی که null است، حساب نیمه‌فعال محسوب می‌شود
  passwordHash           String // SENSITIVE — never default-select
  roleId                 String     @db.Uuid
  status                 UserStatus @default(active)
  theme                  ThemePreference @default(system)
  languagePreference     Language   @default(fa)
  twoFactorEnabled       Boolean    @default(false)
  twoFactorSecret        String? // SENSITIVE — never default-select
  // کانال پیش‌فرض دریافت OTP کاربر (قابل override به‌ازای هر درخواست).
  // null یعنی فالبک به sms در AuthService.resolveOtpChannel.
  // مقداردهی/تغییرش باید فقط از طریق endpoint تنظیمات پروفایل انجام شود،
  // و اگر bale/telegram انتخاب شود باید LinkedBotAccount متناظر از قبل موجود باشد
  // (این اعتبارسنجی در سطح سرویس انجام می‌شود، نه در schema).
  preferredOtpChannel    OtpChannel? 
  referredByUserId       String?    @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft Delete اجباری

  // ── Relations ──────────────────────────────────────────────────────────
  tenant       Tenant  @relation("TenantUsers", fields: [tenantId], references: [id])
  role         Role    @relation(fields: [roleId], references: [id])
  referredBy   User?   @relation("UserReferrals", fields: [referredByUserId], references: [id])
  referrals    User[]  @relation("UserReferrals")

  sessions             Session[]             @relation("SessionOwner")
  sessionsSwitchedFrom Session[]             @relation("SessionSwitchedFrom")
  linkedBotAccounts    LinkedBotAccount[]
  currencyPreference   UserCurrencyPreference?
  wallet               Wallet?
  deviceFingerprints   DeviceFingerprint[]
  otpCodes             OtpCode[]

  @@index([tenantId])
  @@map("user")
  @@schema("identity")
}

/// 1.2 — مدیریت نشست‌های فعال.
model Session {
  id                      String                @id @default(uuid()) @db.Uuid
  userId                  String                @db.Uuid
  refreshTokenHash        String                @unique // خود توکن هرگز ذخیره نمی‌شود، فقط هش

  /// What the platform actually observed about the device, or nothing.
  ///
  /// Nullable since F-048: a session minted from a bot webhook is created by
  /// `bot-service` on the account's behalf, and that request carries no user
  /// agent and no client IP at all — only a chat id. Writing the bot
  /// container's own address here made every chat on the platform look like
  /// the same location, which a session list and an audit trail both read as
  /// a fact. Null says the true thing: nothing was observed.
  ipAddress               String?
  userAgent               String?

  /// The surface a session was minted from when there is no device to name —
  /// `Telegram` / `Bale` for a messenger-originated session, null for a
  /// browser, which describes itself through `userAgent`. Carried forward by
  /// a refresh and by an account switch, for the same reason `scopeKey` is:
  /// the session continues on the surface it started on.
  deviceLabel             String?
  issuedAt                DateTime              @default(now())
  expiresAt               DateTime
  revokedAt               DateTime?
  revokedReason           SessionRevokedReason?
  isImpersonated          Boolean               @default(false)
  impersonationSessionId  String?               @db.Uuid
  switchedFromUserId      String?               @db.Uuid

  /// The surface instance this session was minted on — the same key shape as
  /// `audit.linked_account_member.scopeKey` (ADR-0015). It exists so removing
  /// an account from one group revokes that account's sessions *there* and
  /// nowhere else. Nullable: an impersonation session has no scope, and a
  /// session minted before this column existed has none either.
  ///
  /// A refresh rotates the row but must carry this forward — a re-mint that
  /// drops it silently detaches the session from its scope.
  scopeKey String?

  user                 User                  @relation("SessionOwner", fields: [userId], references: [id])
  switchedFromUser     User?                 @relation("SessionSwitchedFrom", fields: [switchedFromUserId], references: [id])
  impersonationSession ImpersonationSession? @relation(fields: [impersonationSessionId], references: [id])

  // منطق حیاتی: با تغییر رمز، همه‌ی Sessionهای این userId باید در همان
  // Transaction با revokedAt=now() به‌روزرسانی شوند (Force Logout همه دستگاه‌ها).
  @@index([userId])
  // F-0208 revokes by (user, scope); without this it is a scan of every
  // session the account has ever held.
  @@index([userId, scopeKey])
  @@map("session")
  @@schema("identity")
}

/// 1.3 — RBAC داینامیک.
model Role {
  id           String  @id @default(uuid()) @db.Uuid
  name         String  @unique
  isSystemRole Boolean @default(false) // نقش‌های پایه قابل حذف نیستند

  users           User[]
  rolePermissions RolePermission[]

  @@map("role")
  @@schema("identity")
}

model Permission {
  id   String @id @default(uuid()) @db.Uuid
  key  String @unique // مثل wallet.manual_adjust, gateway.toggle, user.impersonate

  rolePermissions RolePermission[]

  @@map("permission")
  @@schema("identity")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permission")
  @@schema("identity")
}

/// 1.3.5 — کدهای یک‌بارمصرف (OTP). این جدول فقط برای تاریخچه/حسابرسی و
/// fallback است؛ منبع حقیقت برای چک سریع/TTL و Rate Limit همیشه Redis است
/// (کلید atomic INCR جلوی race condition درخواست هم‌زمان چند OTP را می‌گیرد).
model OtpCode {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String?    @db.Uuid // در register_phone_verify ممکن است هنوز User نهایی نشده باشد
  /// E.164 (ADR-0018). Indexed below, so a second spelling of one number
  /// would read as a second number.
  phoneNumber String
  codeHash    String // خود کد هرگز plain ذخیره نمی‌شود، فقط هش (مثل رمز عبور)
  purpose     OtpPurpose
  channel     OtpChannel @default(sms)
  attemptCount Int       @default(0)
  maxAttempts  Int       @default(5)
  requestIp    String
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id])

  // برای پیدا کردن سریع "آخرین OTP فعال" یک شماره برای یک هدف خاص
  @@index([phoneNumber, purpose, consumedAt])
  @@map("otp_code")
  @@schema("identity")
}

/// 1.4 — اتصال حساب کاربری به تلگرام/بله (کانال ارتباطی کاربر با پلتفرم،
/// نه با یک Tenant — برای اتصال بات یک Tenant به tenant.TenantBotIntegration مراجعه کنید).
/// همین مدل منبع chatId برای ارسال OTP از طریق bale/telegram است
/// (به BaleOtpSender / TelegramOtpSender در auth-service مراجعه کنید).
model LinkedBotAccount {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @db.Uuid
  platform       SocialPlatform
  platformUserId String // Chat ID
  /// The phone number the messenger itself reported for this account, taken
  /// from a shared contact whose `contact.user_id` equalled the sender id.
  /// Normalized to E.164 (ADR-0018) — messengers report it in whatever shape
  /// the account was registered with, usually without the `+`. Null on a link
  /// made before contact verification existed.
  phoneNumber    String?
  /// Set only when that ownership proof succeeded. An account may only carry
  /// OTP once this is non-null — see identity/invariants.md #12.
  contactVerifiedAt DateTime?
  linkedAt       DateTime       @default(now())

  user User @relation(fields: [userId], references: [id])

  // برای جستجوی سریع «آیا این شماره به bale/telegram لینک شده؟» توسط OTP senders
  @@unique([userId, platform])
  // One messenger account belongs to at most one User: without this, a shared
  // chat id could deliver another account's OTP.
  @@unique([platform, platformUserId])
  @@map("linked_bot_account")
  @@schema("identity")
}

