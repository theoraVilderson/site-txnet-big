{
  "name": "auth-service",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "auth-service/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "webpack-cli build",
        "env": {
          "NODE_ENV": "production"
        },
        "cwd": "auth-service"
      },
      "configurations": {
        "development": {
          "env": {
            "NODE_ENV": "development"
          }
        }
      }
    },
    "build-watch": {
      "executor": "nx:run-commands",
      "continuous": true,
      "cache": false,
      "options": {
        "command": "webpack-cli build --watch",
        "env": {
          "NODE_ENV": "development"
        },
        "cwd": "auth-service",
        "readyWhen": "compiled"
      },
      "outputs": [
        "{workspaceRoot}/dist/auth-service"
      ]
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "auth-service:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "auth-service:build-watch"
        },
        "production": {
          "buildTarget": "auth-service:build:production"
        }
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true
      }
    }
  }
}
