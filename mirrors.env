# Where image builds, the cluster's pulls and host downloads fetch from (ADR-0170).
# Written by `python3 scripts/mirrors/mirrors.py <profile>` from scripts/mirrors/<profile>.env;
# switch with that command, never by hand. Read after .env, so it wins.
MIRRORS_PROFILE=local
DOCKER_REGISTRY=registry.mytxnet.ir
PKG_MIRROR=https://packages.mytxnet.ir/repository
APK_MIRROR=https://packages.mytxnet.ir/repository/alpine
