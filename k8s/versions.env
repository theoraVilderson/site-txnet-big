# Versions the cluster pins, each in one place (hosting K1).
# k3s on the node (K12, scripts/k8s-rehearse.sh up): the binary from its GitHub
# release, checked against the release's sha256sum-amd64.txt, and install.sh at
# the same tag, which writes the unit and k3s-uninstall.sh; fetched 2026-10-24.
K3S_VERSION=v1.34.1+k3s1
K3S_SHA256=ec8958fe1363a32d50e028b5e3411c04b0dbd0316fab33524e8094352b78f6a3
K3S_INSTALL_SHA256=48fe6ec10517263cc69e1c924cf6b283c59a2b942b9b46186fc7c8d29e6f243a
# Traefik's CRDs and RBAC, vendored under k8s/traefik/ by k8s/traefik/vendor.sh;
# the Traefik image itself is dev-docker/traefik/Dockerfile's base.
TRAEFIK_CRD_VERSION=v3.7.11
# The secrets tools (hosting K5, `scripts/prod.k8s.sh install-tools`), each
# checked against the sha256 of its release asset: sops's from its published
# checksums file, age's from the tarball fetched 2026-10-24 (age publishes a
# signature proof, not a checksum list).
SOPS_VERSION=v3.13.3
SOPS_SHA256=e5bec3346a873ae91d871550f3e698c1aad962aff462a080e40f25fde17fef6b
AGE_VERSION=v1.3.2
AGE_SHA256=cbe24006683f8eb669266162894b9a522a1af52f2665fbc63a4bb032ed26ac10
